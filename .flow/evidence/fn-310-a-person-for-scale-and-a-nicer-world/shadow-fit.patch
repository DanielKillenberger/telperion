+/// The person coarsens the sun's map by at most a tenth on every frame of
+/// the film (host ruling on fn-310 task 9), as `person_frame` holds it
+/// beside every shipped tree: each crown the frame shows, under the film's
+/// sun, with and without the person where the film stands it. Run by name
+/// (`--ignored`) once the bounds pass exists.
+#[test]
+#[ignore = "reads the film's bounds pass from raw/; run after `film --bounds`"]
+fn the_person_coarsens_the_films_sun_map_by_at_most_a_tenth() {
+    let (path, frames) = release();
+    let file = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join(
+        "../../.flow/evidence/fn-310-a-person-for-scale-and-a-nicer-world/raw/film-bounds.tsv",
+    );
+    let crowns = bounds::read(&file, &path, frames.len()).unwrap();
+    let shown = shown(&path, &crowns);
+    let standing = standing::stand(&shown, path.sun).unwrap();
+    let mut worst = (0.0, 0, 0.0, 0.0);
+    for (f, s) in shown.iter().enumerate() {
+        let person = common::box_of(&standing.placements[f].body());
+        let (earlier, later, share) = s.crowns;
+        for crown in if share > 0.0 {
+            vec![earlier, later]
+        } else {
+            vec![earlier]
+        } {
+            let (ratio, alone, with) = common::coarsened(path.sun, &[crown], person);
+            if ratio > worst.0 {
+                worst = (ratio, f, alone, with);
+            }
+        }
+    }
+    let (ratio, f, alone, with) = worst;
+    println!("coarsest: frame {f}, {ratio:.3} times, {alone:.4} m to {with:.4} m");
+    assert!(ratio <= 1.1, "frame {f}: {ratio} times coarser");
+}
