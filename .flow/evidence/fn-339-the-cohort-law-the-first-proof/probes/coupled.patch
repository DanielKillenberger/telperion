diff --git i/crates/telperion-space/src/grow/cohort.rs w/crates/telperion-space/src/grow/cohort.rs
new file mode 100644
index 000000000..f12bc97c7
--- /dev/null
+++ w/crates/telperion-space/src/grow/cohort.rs
@@ -0,0 +1,390 @@
+//! fn-339 R4's probe, the coupled cohorts. With a boundary set
+//! (`set_cohorts`, or `TELPERION_COHORTS` in metres), a lateral of an age
+//! whose subtree's expected reach is under it is not sprouted as an axis:
+//! it is counted on its bearer's growth unit and moved each year by the
+//! law (`cycle/replay/law.rs`, the species' shedding rule at the bearing
+//! unit's size). Its current-year leaf shades from the unit's place, its
+//! living apexes' light and its wood's upkeep enter its bearer's balance,
+//! its living keeps its bearer open and its subtree's living time enters
+//! the shed, and its root radius joins its bearer's girth. A measurement
+//! only: with no boundary set the grower is unchanged.
+use super::cycle::replay::law::{self, Law, Shed, LEAF_CUR, LEAF_DRAWN, LIVING, STANDING, V, WOOD};
+use super::cycle::replay::{cohorts as ages_under, reaches, GREW};
+use super::Grower;
+use crate::girth::Disused;
+use crate::shed::Living;
+use crate::species::Species;
+use crate::structure::Vec3;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Mutex;
+
+/// The boundary in metres: unset reads the environment; 0 is off.
+static BOUNDARY: AtomicU64 = AtomicU64::new(u64::MAX);
+
+/// Sets the boundary for every grower started after (none: off).
+pub fn set_cohorts(boundary: Option<f64>) {
+    BOUNDARY.store(boundary.map_or(0, f64::to_bits), Ordering::SeqCst);
+}
+
+fn boundary() -> Option<f64> {
+    match BOUNDARY.load(Ordering::SeqCst) {
+        u64::MAX => std::env::var("TELPERION_COHORTS").ok().and_then(|v| v.parse().ok()).filter(|&b: &f64| b > 0.0),
+        0 => None,
+        bits => Some(f64::from_bits(bits)),
+    }
+}
+
+/// The cohort ages of `species` at the boundary, none where it is off.
+pub(crate) fn ages(species: &Species) -> Option<Vec<bool>> {
+    let b = boundary()?;
+    let set = ages_under(species, &reaches(species), b);
+    let mut out = vec![false; species.states.len()];
+    for &j in &set {
+        out[j] = true;
+    }
+    // Marked choice: sleeping buds of a cohort age are not carried by this
+    // probe; none of the oak, spruce or beech holds one at 0.5 m.
+    for s in &species.states {
+        for z in &s.zones {
+            assert!(set.iter().all(|&j| z.dormant[j] == 0.0), "a sleeping bud of a cohort age");
+        }
+    }
+    Some(out)
+}
+
+/// A lateral bud of a cohort age made in a unit.
+#[derive(Debug, Clone, Copy)]
+pub(super) struct Born {
+    pub axis: usize,
+    pub pa: usize,
+    pub presence: f64,
+}
+
+/// One cohort: the laterals of one root age made in one growth unit.
+#[derive(Debug, Clone)]
+struct Class {
+    axis: usize,
+    cycle: u32,
+    pa: usize,
+    count: f64,
+    /// Where its unit was laid: its mean node, its middle node, its size
+    /// and presence (scale before size).
+    laid: bool,
+    place: Vec3,
+    node: usize,
+    size: f64,
+    scale: f64,
+    /// Its bearer's pipe exponent, which its root's radius joins by, and
+    /// its bearer's lineage and birth, which find it in the settled tree.
+    exponent: f64,
+    bearer: (u64, u32),
+    /// The light it grew in, from its birth's next cycle; dead once its
+    /// bearer's subtree is shed by the balance.
+    light: Vec<f64>,
+    dead: bool,
+    now: V,
+    stand: f64,
+    section: f64,
+    last_living: u32,
+}
+
+/// The tree's cohorts, and what the probe's read takes of them.
+#[derive(Clone)]
+pub(super) struct Cohorts<'a> {
+    pub set: Vec<bool>,
+    law: Law<'a>,
+    classes: Vec<Class>,
+    pub pending: Vec<Born>,
+    /// Class-years stepped, and the classes stepped each cycle.
+    steps: u64,
+    /// The leaf term's two sums over every phytomer the cohorts grew, at
+    /// the light each grew in, as the grown tree's are taken.
+    sums: [f64; 2],
+    per_cycle: Vec<u64>,
+}
+
+/// What the last settled grower's cohorts held at its age: the read's.
+#[derive(Debug, Clone, Default)]
+pub struct Held {
+    pub age: u32,
+    /// Units grown in the last cycle, living apexes, members standing,
+    /// current-year and standing leaf, wood: each by count and presence.
+    pub totals: [f64; 6],
+    /// Each standing cohort's bearer (lineage, birth), its node, and its
+    /// standing leaf.
+    pub places: Vec<(u64, u32, usize, f64)>,
+    pub classes: usize,
+    pub steps: u64,
+    pub per_cycle: Vec<u64>,
+}
+
+static HELD: Mutex<Option<Held>> = Mutex::new(None);
+
+/// What the last settled grower's cohorts held.
+pub fn held() -> Option<Held> {
+    HELD.lock().ok()?.clone()
+}
+
+impl<'a> Cohorts<'a> {
+    pub fn new(species: &'a Species, set: Vec<bool>, age: u32) -> Self {
+        let law = Law::new(species, age);
+        let ages: Vec<usize> = (0..set.len()).filter(|&j| set[j]).collect();
+        law.check(&ages);
+        Self {
+            set,
+            law,
+            classes: Vec::new(),
+            pending: Vec::new(),
+            steps: 0,
+            sums: [0.0; 2],
+            per_cycle: vec![0; age as usize + 1],
+        }
+    }
+}
+
+impl Grower<'_> {
+    /// The cycle's births gathered into their units' cohorts, then every
+    /// cohort moved to `cycle` by the law with the light it has had.
+    pub(super) fn cohort_step(&mut self, cycle: u32) {
+        let Some(c) = self.cohorts.as_deref_mut() else {
+            return;
+        };
+        let mut index: HashMap<(usize, usize), usize> = HashMap::new();
+        for b in std::mem::take(&mut c.pending) {
+            let k = *index.entry((b.axis, b.pa)).or_insert_with(|| {
+                c.classes.push(Class {
+                    axis: b.axis,
+                    cycle,
+                    pa: b.pa,
+                    count: 0.0,
+                    laid: false,
+                    place: Vec3::default(),
+                    node: 0,
+                    size: 1.0,
+                    scale: 1.0,
+                    exponent: 2.0,
+                    bearer: (0, 0),
+                    light: Vec::new(),
+                    dead: false,
+                    now: [0.0; law::Q],
+                    stand: 1.0,
+                    section: 0.0,
+                    last_living: cycle,
+                });
+                c.classes.len() - 1
+            });
+            c.classes[k].count += b.presence;
+        }
+        let law = &c.law;
+        let mut stepped = 0;
+        for class in &mut c.classes {
+            if class.cycle == cycle {
+                class.now[LIVING] = 1.0;
+                class.now[STANDING] = 1.0;
+                continue;
+            }
+            let mut path = vec![1.0; cycle as usize + 1];
+            for (k, &l) in class.light.iter().enumerate() {
+                let at = class.cycle as usize + 1 + k;
+                if at <= cycle as usize {
+                    path[at] = l;
+                }
+            }
+            if class.dead {
+                let from = class.cycle as usize + 1 + class.light.len();
+                path.iter_mut().skip(from).for_each(|l| *l = 0.0);
+            }
+            let mut unit = law::Unit::new(law, &path, Shed::Subtree);
+            let (v, stand, section, _) = unit.member(class.pa, class.cycle, true);
+            class.now = v[cycle as usize];
+            (class.stand, class.section) = (stand, section);
+            let s = &law.species().states[class.pa];
+            if s.leaf_area > 0.0 {
+                let nodes = class.now[LEAF_CUR] / s.leaf_area;
+                let pipe = nodes * class.count * s.form.pipe;
+                c.sums[0] += pipe;
+                c.sums[1] += pipe * path[cycle as usize].max(1e-6).powf(s.leaf_girth);
+            }
+            if class.now[LIVING] > 0.0 {
+                class.last_living = cycle;
+            }
+            stepped += 1;
+        }
+        c.classes.retain(|k| k.cycle == cycle || k.stand > 0.0);
+        c.steps += stepped;
+        c.per_cycle[cycle as usize] = stepped;
+    }
+
+    /// The cohorts' units laid this cycle placed, and every cohort's
+    /// current-year leaf added to the leaves the lattice takes.
+    pub(super) fn cohort_leaves(&mut self, cycle: u32) {
+        let Some(c) = self.cohorts.as_deref_mut() else {
+            return;
+        };
+        for class in c.classes.iter_mut().filter(|k| !k.laid) {
+            let axis = &self.axes[class.axis];
+            let unit: Vec<usize> = (0..axis.phytomers.len()).filter(|&j| axis.phytomers[j].cycle == class.cycle).collect();
+            if unit.is_empty() {
+                continue;
+            }
+            let k = unit.len() as f64;
+            let (mut at, mut size, mut scale) = (Vec3::default(), 0.0, 0.0);
+            for &j in &unit {
+                let p = &axis.phytomers[j];
+                at = Vec3::new(at.x + p.tip.x / k, at.y + p.tip.y / k, at.z + p.tip.z / k);
+                size += p.size / k;
+                scale += p.scale / k;
+            }
+            // Marked choice: the cohort joins its bearer at its unit's
+            // middle node.
+            (class.place, class.node, class.size, class.scale) = (at, unit[unit.len() / 2], size, scale);
+            class.exponent = self.species.states[axis.pa].form.exponent;
+            class.bearer = (axis.lineage, axis.birth);
+            class.laid = true;
+        }
+        let _ = cycle;
+        for class in c.classes.iter().filter(|k| k.laid) {
+            let area = class.now[LEAF_CUR] * class.count * class.scale * class.size;
+            if area > 0.0 {
+                self.leaves.push((class.place, area));
+            }
+        }
+    }
+
+    /// The places the cohorts read their light at, in their order.
+    pub(super) fn cohort_places(&self) -> Vec<Vec3> {
+        self.cohorts
+            .as_deref()
+            .map_or_else(Vec::new, |c| c.classes.iter().map(|k| k.place).collect())
+    }
+
+    /// Each cohort's light for the next cycle, read at its place.
+    pub(super) fn cohort_lit(&mut self, read: &[f64]) {
+        let Some(c) = self.cohorts.as_deref_mut() else {
+            return;
+        };
+        for (class, &l) in c.classes.iter_mut().zip(read) {
+            class.light.push(if class.dead { 0.0 } else { l });
+        }
+    }
+
+    /// What each axis's cohorts add to its balance: their living apexes'
+    /// light, their wood's upkeep, and whether any of them lives.
+    pub(super) fn cohort_balance(&self) -> HashMap<usize, (f32, f32, bool)> {
+        let mut out: HashMap<usize, (f32, f32, bool)> = HashMap::new();
+        let Some(c) = self.cohorts.as_deref() else {
+            return out;
+        };
+        for k in &c.classes {
+            let light = k.light.last().copied().unwrap_or(1.0);
+            let presence = k.count * k.scale;
+            let e = out.entry(k.axis).or_default();
+            e.0 += (k.now[LIVING] * presence * light) as f32;
+            e.1 += (self.species.states[k.pa].upkeep * k.now[WOOD] * presence * k.size) as f32;
+            e.2 |= k.now[LIVING] > 0.0;
+        }
+        out
+    }
+
+    /// The cohorts on an axis the balance shed die with it.
+    pub(super) fn cohort_shed(&mut self, shed: &dyn Fn(usize) -> bool) {
+        if let Some(c) = self.cohorts.as_deref_mut() {
+            for k in c.classes.iter_mut().filter(|k| shed(k.axis)) {
+                k.dead = true;
+            }
+        }
+    }
+
+    /// The axes a living cohort keeps open.
+    pub(super) fn cohort_open(&self) -> Vec<usize> {
+        self.cohorts.as_deref().map_or_else(Vec::new, |c| {
+            c.classes.iter().filter(|k| k.now[LIVING] > 0.0).map(|k| k.axis).collect()
+        })
+    }
+
+    /// The cohorts' axes renamed as the grower's are, those let go dropped.
+    pub(super) fn cohort_rename(&mut self, to: &dyn Fn(usize) -> Option<usize>) {
+        if let Some(c) = self.cohorts.as_deref_mut() {
+            c.classes.retain_mut(|k| to(k.axis).map(|a| k.axis = a).is_some());
+            c.pending.retain_mut(|b| to(b.axis).map(|a| b.axis = a).is_some());
+        }
+    }
+
+    /// The living each bearer's cohorts give its subtree at the shed: the
+    /// last cycle any of them lived, from the bearer's birth, and whether
+    /// one lives at the tree's age. Marked choice: whole cycles, and the
+    /// bearer's presence as the living apex's.
+    pub(super) fn cohort_living(&self, age: u32) -> HashMap<usize, Living> {
+        let mut out: HashMap<usize, Living> = HashMap::new();
+        let Some(c) = self.cohorts.as_deref() else {
+            return out;
+        };
+        for k in &c.classes {
+            let birth = self.axes[k.axis].birth;
+            let lived = k.last_living.saturating_sub(birth) as f32;
+            let alive = if k.now[LIVING] > 0.0 && k.last_living == age { k.scale.min(1.0) as f32 } else { 0.0 };
+            let e = out.entry(k.axis).or_default();
+            (e.lived, e.alive) = (e.lived.max(lived), e.alive.max(alive));
+        }
+        out
+    }
+
+}
+
+impl Cohorts<'_> {
+    /// The leaf term's mean with the cohorts' pipes in it: every phytomer
+    /// they grew, at the light it grew in. Marked choice: one pipe per
+    /// cohort, its root age's, and its bearer's presence left out as the
+    /// grown tree's sums take each phytomer's own.
+    pub(super) fn leaf_mean(&self, species: &Species, sums: Option<[f32; 2]>) -> Option<f64> {
+        let _ = species;
+        let [total, weighted] = sums?.map(f64::from);
+        let (total, weighted) = (total + self.sums[0], weighted + self.sums[1]);
+        (weighted > 0.0).then(|| total / weighted)
+    }
+
+    /// Each standing cohort's root radius as its bearer takes it, where the
+    /// shed kept its bearer (`index`), lit by the leaf term, and the read's
+    /// record of them.
+    pub(super) fn girth(&self, species: &Species, index: &[usize], age: u32, mean: Option<f64>) -> Vec<Disused> {
+        let mut out = Vec::new();
+        let c = self;
+        let mut held = Held {
+            age,
+            classes: c.classes.len(),
+            steps: c.steps,
+            per_cycle: c.per_cycle.clone(),
+            ..Held::default()
+        };
+        for k in c.classes.iter().filter(|k| k.stand > 0.0 && k.laid) {
+            let Some(&_kept) = index.get(k.axis).filter(|&&i| i != usize::MAX) else {
+                continue;
+            };
+            let e = k.exponent;
+            let whole = k.count.floor();
+            let moment = whole + (k.count - whole).powf(e);
+            let member = k.section / k.stand;
+            let light = k.light.last().copied().unwrap_or(1.0).max(1e-6);
+            let lit = mean.map_or(1.0, |m| light.powf(species.states[k.pa].leaf_girth) * m);
+            out.push(Disused {
+                axis: _kept,
+                node: Some(k.node),
+                radius: k.size * k.scale * member.sqrt() * lit,
+                share: moment * k.stand,
+            });
+            let presence = k.count * k.scale;
+            for (t, q) in [GREW, LIVING, STANDING].into_iter().enumerate() {
+                held.totals[t] += k.now[q] * presence;
+            }
+            held.totals[3] += k.now[LEAF_CUR] * presence * k.size;
+            held.totals[4] += k.now[LEAF_DRAWN] * presence * k.size;
+            held.totals[5] += k.now[WOOD] * presence * k.size;
+            held.places.push((k.bearer.0, k.bearer.1, k.node, k.now[LEAF_DRAWN] * presence * k.size));
+        }
+        if let Ok(mut h) = HELD.lock() {
+            *h = Some(held);
+        }
+        out
+    }
+}
