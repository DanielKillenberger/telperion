index 000000000..02cd7ad58
--- /dev/null
+++ w/crates/telperion-core/src/pipeline/coupled_tests.rs
@@ -0,0 +1,177 @@
+//! fn-339 R4: the coupled cohort probe (`telperion_space::set_cohorts`)
+//! beside the full cycle on the same seeds. A measurement, ignored: it
+//! prints lines for `probes/r4.py` to read.
+use super::{executor, measures, skeleton, GrowInput};
+use crate::presets::by_identity;
+use crate::tree::Tree;
+use std::collections::{HashMap, HashSet};
+use telperion_space::{grow_census, held, set_cohorts};
+
+/// The boundary the probe reads its cohorts at (PROTOCOL.md).
+const BOUNDARY: f64 = 0.5;
+
+/// Height, spread and trunk diameter at breast height (fn-326's read).
+fn shape(tree: &Tree) -> Option<[f64; 3]> {
+    let base = tree.nodes.first()?.position;
+    let (mut top, mut lo, mut hi) = (f64::MIN, [f64::MAX; 2], [f64::MIN; 2]);
+    let mut breast = 0f64;
+    for n in &tree.nodes {
+        let p = n.position;
+        top = top.max(p.y - base.y);
+        lo = [lo[0].min(p.x), lo[1].min(p.z)];
+        hi = [hi[0].max(p.x), hi[1].max(p.z)];
+        if (1.0..=1.6).contains(&(p.y - base.y)) {
+            breast = breast.max(n.radius);
+        }
+    }
+    (breast > 0.0).then_some([top, ((hi[0] - lo[0]) + (hi[1] - lo[1])) / 2.0, 2.0 * breast])
+}
+
+fn list<T: std::str::FromStr>(name: &str) -> Vec<T> {
+    let v = std::env::var(name).unwrap_or_else(|_| panic!("{name}"));
+    v.split(',').map(|x| x.parse().ok().expect("a value")).collect()
+}
+
+fn median(mut v: Vec<f64>) -> f64 {
+    v.sort_by(f64::total_cmp);
+    (v[(v.len() - 1) / 2] + v[v.len() / 2]) / 2.0
+}
+
+/// One grow's seconds: once, and over a grow of at most 0.5 s, five
+/// repeats less the first (fn-327's habit).
+fn seconds(species: &telperion_space::Species, request: telperion_space::Request) -> f64 {
+    let first = grow_census(species, request).expect("a tree").seconds;
+    if first > 0.5 {
+        return first;
+    }
+    let times: Vec<f64> = (0..5)
+        .map(|_| grow_census(species, request).expect("a tree").seconds)
+        .skip(1)
+        .collect();
+    median(times)
+}
+
+/// `COUPLED_PRESET` on each of `COUPLED_SEEDS` at `COUPLED_AGE` (0: the
+/// preset's), the cycle (`base`) and the probe (`probe`):
+/// `READ mode seed height spread trunk limbs leaf_cur leaf_standing
+/// columns lai shoots structure_units cohort_units classes steps
+/// grown_phytomers`. With `COUPLED_BATCHES`, that many alternating timing
+/// batches per seed, `TIME seed batch base probe` in seconds; with
+/// `COUPLED_MODE` only that mode is read (for one process's peak memory).
+#[test]
+#[ignore = "a measurement: fn-339 R4"]
+fn cohort_coupled() {
+    let id = std::env::var("COUPLED_PRESET").expect("a preset");
+    let seeds: Vec<u32> = list("COUPLED_SEEDS");
+    let age: f64 = std::env::var("COUPLED_AGE").ok().and_then(|a| a.parse().ok()).unwrap_or(0.0);
+    let batches: usize = std::env::var("COUPLED_BATCHES").ok().and_then(|b| b.parse().ok()).unwrap_or(0);
+    let only = std::env::var("COUPLED_MODE").ok();
+    for seed in seeds {
+        let mut f = by_identity(&id).expect("a preset");
+        f.fidelity = 0.0;
+        f.skeleton.seed = seed;
+        if age > 0.0 {
+            f.age = age;
+        }
+        for (mode, boundary) in [("base", None), ("probe", Some(BOUNDARY))] {
+            if only.as_deref().is_some_and(|m| m != mode) {
+                continue;
+            }
+            set_cohorts(boundary);
+            read(&f, mode, seed);
+        }
+        if batches > 0 {
+            let g = executor::growth(&f).expect("its growth");
+            for b in 0..batches {
+                let mut t = [0.0; 2];
+                // Alternate which goes first.
+                let order = if b % 2 == 0 { [0, 1] } else { [1, 0] };
+                for k in order {
+                    set_cohorts([None, Some(BOUNDARY)][k]);
+                    t[k] = seconds(&g.species, g.request);
+                }
+                println!("TIME {seed} {b} {:.6} {:.6}", t[0], t[1]);
+            }
+        }
+    }
+    set_cohorts(None);
+}
+
+fn read(f: &crate::presets::Family, mode: &str, seed: u32) {
+    let g = executor::growth(f).expect("its growth");
+    let age = g.request.age;
+    let cycled = grow_census(&g.species, g.request).expect("a tree");
+    let cohorts = held().filter(|_| mode == "probe");
+    let census = cycled.census.as_ref().expect("a census");
+    let units = census.cycles.last().map_or(0, |c| c.active) as f64;
+    // Where the seconds went, by the stage that ended them: the cohorts'
+    // step falls in `Grown` (`Grower::year`).
+    if std::env::var("COUPLED_PHASES").is_ok() {
+        let parts: Vec<String> = census.phases.iter().map(|(k, v)| format!("{k}={v:.4}")).collect();
+        println!("PHASES {mode} {seed} {:.4} {}", cycled.seconds, parts.join(" "));
+    }
+    let species = &g.species;
+    // The structure's leaf and its ground columns, on the settled tree.
+    let (mut cur, mut standing, mut weighted) = (0.0, 0.0, 0.0);
+    let mut columns: HashSet<[i64; 2]> = HashSet::new();
+    let mut at: HashMap<(u64, u32), usize> = HashMap::new();
+    let column = |x: f64, y: f64| [(x / 0.5).floor() as i64, (y / 0.5).floor() as i64];
+    for (i, a) in cycled.structure.axes.iter().enumerate() {
+        at.insert((a.lineage, a.birth), i);
+        let s = &species.states[a.pa];
+        let grew = a.phytomers.last().is_some_and(|p| p.cycle == age);
+        // A unit grown in the last cycle, counted by its presence (the
+        // settled scale over the size), as R3 counts it.
+        let last: Vec<f64> = (a.phytomers.iter().filter(|p| p.cycle == age))
+            .map(|p| if p.size > 0.0 { p.scale / p.size } else { 0.0 })
+            .collect();
+        if !last.is_empty() {
+            weighted += last.iter().sum::<f64>() / last.len() as f64;
+        }
+        let mut bears = false;
+        for p in &a.phytomers {
+            if p.cycle == age {
+                cur += s.leaf_area * p.scale;
+            }
+            if s.cluster_leaves == 0.0 && f64::from(age - p.cycle) < s.leaf_years && s.leaf_area > 0.0 {
+                standing += s.leaf_area * p.scale;
+                columns.insert(column(p.tip.x, p.tip.y));
+                bears = true;
+            }
+        }
+        if s.cluster_leaves > 0.0 && grew {
+            let scale = a.phytomers.last().map_or(0.0, |p| p.scale);
+            standing += s.cluster_leaves * s.leaf_area * scale;
+            if let Some(p) = a.phytomers.last() {
+                columns.insert(column(p.tip.x, p.tip.y));
+            }
+        }
+        let _ = bears;
+    }
+    let (mut c_units, mut classes, mut steps) = (0.0, 0, 0);
+    if let Some(h) = &cohorts {
+        cur += h.totals[3];
+        standing += h.totals[4];
+        c_units = h.totals[0];
+        weighted += h.totals[0];
+        (classes, steps) = (h.classes, h.steps);
+        for &(lineage, birth, node, leaf) in &h.places {
+            if leaf <= 0.0 {
+                continue;
+            }
+            if let Some(p) = at.get(&(lineage, birth)).and_then(|&i| cycled.structure.axes[i].phytomers.get(node)) {
+                columns.insert(column(p.tip.x, p.tip.y));
+            }
+        }
+    }
+    let tree = skeleton(GrowInput::of(f)).expect("a tree").tree;
+    let limbs = measures::limb_count(&tree, f.canopy.clump_system_order).expect("limbs") as f64;
+    let [height, spread, trunk] = shape(&tree).unwrap_or([f64::NAN; 3]);
+    let lai = standing / (columns.len().max(1) as f64 * 0.25);
+    println!(
+        "READ {mode} {seed} {age} {height:.4} {spread:.4} {trunk:.5} {limbs} {cur:.4} {standing:.4} {} {lai:.4} {:.1} {units} {c_units:.1} {classes} {steps} {} {weighted:.1}",
+        columns.len(),
+        units + c_units,
+        cycled.grown
+    );
+}
diff --git i/crates/telperion-core/src/pipeline/lateral_tests.rs w/crates/telperion-core/src/pipeline/lateral_tests.rs
