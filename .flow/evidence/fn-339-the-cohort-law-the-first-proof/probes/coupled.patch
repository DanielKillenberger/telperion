diff --git i/crates/telperion-space/src/grow/cycle/laterals.rs w/crates/telperion-space/src/grow/cycle/laterals.rs
new file mode 100644
index 000000000..8a72b186f
--- /dev/null
+++ w/crates/telperion-space/src/grow/cycle/laterals.rs
@@ -0,0 +1,281 @@
+//! fn-335: what every lateral a full cycle grew really carried. The grower
+//! runs as the reference runs it (every axis open, none retired), its
+//! presences are assigned as the settle assigns them, and each lateral's
+//! subtree is read there, before shedding drops anything; the shed is then
+//! taken as the settle takes it, to name the laterals it drops. A
+//! measurement only: it reads the grower and changes nothing it grows.
+use super::super::sketch::Sketch;
+use super::super::{start, Options, Request};
+use super::Working;
+use crate::error::Result;
+use crate::presence::assign;
+use crate::species::Species;
+use crate::structure::{Axis, Origin};
+
+/// One lateral of the grown tree, the shed ones included.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Lateral {
+    pub lineage: u64,
+    /// Its age on the reference axis, and the cycle its bud was made.
+    pub pa: usize,
+    pub birth: u32,
+    /// Whether its bud slept before it grew.
+    pub woken: bool,
+    /// Its bearer's age, the node it stands at, and the laterals between it
+    /// and the seed, itself included.
+    pub bearer_pa: usize,
+    pub node: usize,
+    pub order: u32,
+    /// The light its first growth unit grew in (none where it grew no
+    /// phytomer), and the light of the bearer's growth unit that made it.
+    pub light: Option<f64>,
+    pub bearer_light: f64,
+    /// The cycle its own apex stopped, none where it lives at the age.
+    pub apex_end: Option<u32>,
+    /// The last cycle anything in its subtree grew; none where nothing did.
+    pub last: Option<u32>,
+    /// Whether the settle sheds it.
+    pub shed: bool,
+    /// Its whole subtree's phytomers by age as grown, before the shed,
+    /// counted; and those grown in the tree's last cycle.
+    pub count: Vec<f64>,
+    pub count_last: Vec<f64>,
+    /// What its subtree holds at the tree's age, by age: the phytomers the
+    /// settle keeps, summed by their settled scale; and those of the last
+    /// cycle.
+    pub standing: Vec<f64>,
+    pub standing_last: Vec<f64>,
+}
+
+/// Every lateral of `species` grown to `request`'s age through the full
+/// cycle, in the grower's order.
+pub fn grow_laterals(species: &Species, request: Request) -> Result<Vec<Lateral>> {
+    let (mut g, _) = start(species, request, Options::default())?;
+    (g.one, g.rules.one) = (true, true);
+    g.working = Some(Box::new(Working::reference()));
+    g.sketch.get_or_insert_with(|| Sketch::new(request.light));
+    g.rules.lasting = vec![None; species.states.len()].into();
+    let mut advanced = Vec::new();
+    for c in 1..=request.age {
+        g.year(c, c < request.age, &mut advanced, &mut |_| {})?;
+    }
+    g.mark();
+    assign(&mut g.axes, &g.draws, species, g.threads);
+    let pas = species.states.len();
+    let mut out = read(&g.axes, pas, request.age);
+    let parents: Vec<Option<usize>> = g.axes.iter().map(|a| a.origin.parent()).collect();
+    let (shed, mut tree) = settled(g, species, request)?;
+    let n = parents.len();
+    let mut standing = vec![0.0; n * pas];
+    let mut standing_last = vec![0.0; n * pas];
+    for (i, &k) in shed.iter().enumerate() {
+        let Some(axis) = (k != usize::MAX).then(|| &tree.axes[k]) else {
+            continue;
+        };
+        for p in &axis.phytomers {
+            standing[i * pas + axis.pa] += p.scale;
+            if p.cycle == request.age {
+                standing_last[i * pas + axis.pa] += p.scale;
+            }
+        }
+    }
+    sum_up(&parents, pas, &mut [&mut standing, &mut standing_last]);
+    tree.axes.clear();
+    for (lateral, i) in out.iter_mut() {
+        lateral.shed = shed[*i] == usize::MAX;
+        lateral.standing = standing[*i * pas..(*i + 1) * pas].to_vec();
+        lateral.standing_last = standing_last[*i * pas..(*i + 1) * pas].to_vec();
+    }
+    Ok(out.into_iter().map(|(l, _)| l).collect())
+}
+
+/// The settle's shed and scale, as `settle_shed` and `settle_lay` take
+/// them, of the grower already marked and assigned: each grown axis's
+/// index in the settled tree (none where shed), and that tree scaled.
+fn settled(
+    g: super::super::Grower<'_>,
+    species: &Species,
+    request: Request,
+) -> Result<(Vec<usize>, crate::structure::Structure)> {
+    let threads = g.threads;
+    let w = g.working.as_ref().expect("a working set");
+    let r = w.retirement();
+    let (given, gone) = (|i| r.root(i), |i| r.inside(i));
+    let shed = crate::shed::shed_past(g.axes, species, request.age, (&given, &gone), None).0;
+    let mut tree = crate::structure::Structure {
+        age: request.age,
+        pas: species.states.len(),
+        axes: shed.axes,
+    };
+    crate::geometry::scale(&mut tree, species, threads);
+    Ok((shed.index, tree))
+}
+
+/// Each axis's per-age sums in `cols` gathered into its parent's, from
+/// the tips down (a parent precedes its children).
+fn sum_up(parents: &[Option<usize>], pas: usize, cols: &mut [&mut Vec<f64>]) {
+    for i in (1..parents.len()).rev() {
+        let Some(p) = parents[i] else {
+            continue;
+        };
+        for col in cols.iter_mut() {
+            for k in 0..pas {
+                col[p * pas + k] += col[i * pas + k];
+            }
+        }
+    }
+}
+
+/// Each lateral's record and its index, every subtree summed from the
+/// tips down (a parent precedes its children).
+fn read(axes: &[Axis], pas: usize, age: u32) -> Vec<(Lateral, usize)> {
+    let n = axes.len();
+    let (mut count, mut count_last) = (vec![0.0; n * pas], vec![0.0; n * pas]);
+    let mut last: Vec<Option<u32>> = vec![None; n];
+    for (i, a) in axes.iter().enumerate() {
+        for p in &a.phytomers {
+            count[i * pas + a.pa] += 1.0;
+            if p.cycle == age {
+                count_last[i * pas + a.pa] += 1.0;
+            }
+        }
+        last[i] = a.phytomers.iter().map(|p| p.cycle).max();
+    }
+    let parents: Vec<Option<usize>> = axes.iter().map(|a| a.origin.parent()).collect();
+    sum_up(&parents, pas, &mut [&mut count, &mut count_last]);
+    for i in (1..n).rev() {
+        if let Some(p) = parents[i] {
+            last[p] = last[p].max(last[i]);
+        }
+    }
+    let mut order = vec![0u32; n];
+    let mut out = Vec::new();
+    for (i, a) in axes.iter().enumerate() {
+        let Origin::Lateral {
+            parent,
+            node,
+            woken,
+            ..
+        } = a.origin
+        else {
+            order[i] = a.origin.parent().map_or(0, |p| order[p]);
+            continue;
+        };
+        order[i] = order[parent] + 1;
+        let bearer = &axes[parent];
+        let lateral = Lateral {
+            lineage: a.lineage,
+            pa: a.pa,
+            birth: a.birth,
+            woken,
+            bearer_pa: bearer.pa,
+            node,
+            order: order[i],
+            light: a.phytomers.first().map(|p| p.light),
+            bearer_light: bearer.phytomers[node].light,
+            apex_end: a.apex_end,
+            last: last[i],
+            shed: false,
+            count: count[i * pas..(i + 1) * pas].to_vec(),
+            count_last: count_last[i * pas..(i + 1) * pas].to_vec(),
+            standing: Vec::new(),
+            standing_last: Vec::new(),
+        };
+        out.push((lateral, i));
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::light::Light;
+
+    /// The laterals the recorder keeps are the laterals the full cycle's
+    /// tree holds, by lineage, and a lateral has a first light exactly
+    /// where it grew a phytomer of its own age: the recorder reads the
+    /// tree the cycle grows.
+    #[test]
+    fn the_kept_laterals_are_the_full_cycles() {
+        let light = Light {
+            extinction: 0.5,
+            sky: 0.5,
+        };
+        let request = Request {
+            age: 12,
+            seed: 1001,
+            light,
+        };
+        let oak = crate::oak();
+        let records = grow_laterals(&oak, request).expect("records");
+        let tree = super::super::grow_cycle(&oak, request).expect("a tree");
+        let mut kept: Vec<u64> = (records.iter().filter(|l| !l.shed))
+            .map(|l| l.lineage)
+            .collect();
+        let mut held: Vec<u64> = (tree.structure.axes.iter())
+            .filter(|a| matches!(a.origin, Origin::Lateral { .. }))
+            .map(|a| a.lineage)
+            .collect();
+        kept.sort_unstable();
+        held.sort_unstable();
+        assert!(records.iter().any(|l| l.shed), "nothing shed at 12");
+        assert_eq!(kept, held);
+        let grown = |l: &Lateral| l.light.is_some() == (l.count[l.pa] > 0.0);
+        assert!(records.iter().all(grown));
+        let gone = |l: &&Lateral| l.shed && l.standing.iter().any(|&s| s != 0.0);
+        assert_eq!(records.iter().filter(gone).count(), 0);
+        let held = held_by_lineage(&tree.structure, oak.states.len());
+        for l in records.iter().filter(|l| !l.shed) {
+            let (all, last) = &held[&l.lineage];
+            for (ours, theirs) in [(&l.standing, all), (&l.standing_last, last)] {
+                let near = |(a, b): (&f64, &f64)| (a - b).abs() <= 1e-9 * b.abs().max(1.0);
+                assert!(ours.iter().zip(theirs).all(near), "{ours:?} vs {theirs:?}");
+            }
+        }
+    }
+
+    /// Each lateral of a settled tree's subtree, by age, summed by scale,
+    /// and those of the last cycle, by lineage.
+    fn held_by_lineage(
+        tree: &crate::structure::Structure,
+        pas: usize,
+    ) -> std::collections::HashMap<u64, (Vec<f64>, Vec<f64>)> {
+        let n = tree.axes.len();
+        let (mut all, mut last) = (vec![0.0; n * pas], vec![0.0; n * pas]);
+        for (i, a) in tree.axes.iter().enumerate() {
+            for p in &a.phytomers {
+                all[i * pas + a.pa] += p.scale;
+                if p.cycle == tree.age {
+                    last[i * pas + a.pa] += p.scale;
+                }
+            }
+        }
+        // The settled tree is in lineage order, a child possibly before its
+        // parent: gathered deepest first.
+        let parents: Vec<Option<usize>> = tree.axes.iter().map(|a| a.origin.parent()).collect();
+        let depth = |mut i: usize| {
+            let mut d = 0;
+            while let Some(p) = parents[i] {
+                (i, d) = (p, d + 1);
+            }
+            d
+        };
+        let mut deepest: Vec<usize> = (0..n).collect();
+        deepest.sort_by_key(|&i| std::cmp::Reverse(depth(i)));
+        for i in deepest {
+            let Some(p) = parents[i] else {
+                continue;
+            };
+            for k in 0..pas {
+                all[p * pas + k] += all[i * pas + k];
+                last[p * pas + k] += last[i * pas + k];
+            }
+        }
+        let span = |v: &[f64], i: usize| v[i * pas..(i + 1) * pas].to_vec();
+        // A relay carries its parent's lineage: only laterals are keyed.
+        (tree.axes.iter().enumerate())
+            .filter(|(_, a)| matches!(a.origin, Origin::Lateral { .. }))
+            .map(|(i, a)| (a.lineage, (span(&all, i), span(&last, i))))
+            .collect()
+    }
+}
