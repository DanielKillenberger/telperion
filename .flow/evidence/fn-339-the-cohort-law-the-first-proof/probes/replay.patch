diff --git i/crates/telperion-space/src/grow/cycle/laterals.rs w/crates/telperion-space/src/grow/cycle/laterals.rs
new file mode 100644
index 000000000..8a72b186f
--- /dev/null
+++ w/crates/telperion-space/src/grow/cycle/laterals.rs
@@ -0,0 +1,281 @@
+//! fn-335: what every lateral a full cycle grew really carried. The grower
+//! runs as the reference runs it (every axis open, none retired), its
+//! presences are assigned as the settle assigns them, and each lateral's
+//! subtree is read there, before shedding drops anything; the shed is then
+//! taken as the settle takes it, to name the laterals it drops. A
+//! measurement only: it reads the grower and changes nothing it grows.
+use super::super::sketch::Sketch;
+use super::super::{start, Options, Request};
+use super::Working;
+use crate::error::Result;
+use crate::presence::assign;
+use crate::species::Species;
+use crate::structure::{Axis, Origin};
+
+/// One lateral of the grown tree, the shed ones included.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Lateral {
+    pub lineage: u64,
+    /// Its age on the reference axis, and the cycle its bud was made.
+    pub pa: usize,
+    pub birth: u32,
+    /// Whether its bud slept before it grew.
+    pub woken: bool,
+    /// Its bearer's age, the node it stands at, and the laterals between it
+    /// and the seed, itself included.
+    pub bearer_pa: usize,
+    pub node: usize,
+    pub order: u32,
+    /// The light its first growth unit grew in (none where it grew no
+    /// phytomer), and the light of the bearer's growth unit that made it.
+    pub light: Option<f64>,
+    pub bearer_light: f64,
+    /// The cycle its own apex stopped, none where it lives at the age.
+    pub apex_end: Option<u32>,
+    /// The last cycle anything in its subtree grew; none where nothing did.
+    pub last: Option<u32>,
+    /// Whether the settle sheds it.
+    pub shed: bool,
+    /// Its whole subtree's phytomers by age as grown, before the shed,
+    /// counted; and those grown in the tree's last cycle.
+    pub count: Vec<f64>,
+    pub count_last: Vec<f64>,
+    /// What its subtree holds at the tree's age, by age: the phytomers the
+    /// settle keeps, summed by their settled scale; and those of the last
+    /// cycle.
+    pub standing: Vec<f64>,
+    pub standing_last: Vec<f64>,
+}
+
+/// Every lateral of `species` grown to `request`'s age through the full
+/// cycle, in the grower's order.
+pub fn grow_laterals(species: &Species, request: Request) -> Result<Vec<Lateral>> {
+    let (mut g, _) = start(species, request, Options::default())?;
+    (g.one, g.rules.one) = (true, true);
+    g.working = Some(Box::new(Working::reference()));
+    g.sketch.get_or_insert_with(|| Sketch::new(request.light));
+    g.rules.lasting = vec![None; species.states.len()].into();
+    let mut advanced = Vec::new();
+    for c in 1..=request.age {
+        g.year(c, c < request.age, &mut advanced, &mut |_| {})?;
+    }
+    g.mark();
+    assign(&mut g.axes, &g.draws, species, g.threads);
+    let pas = species.states.len();
+    let mut out = read(&g.axes, pas, request.age);
+    let parents: Vec<Option<usize>> = g.axes.iter().map(|a| a.origin.parent()).collect();
+    let (shed, mut tree) = settled(g, species, request)?;
+    let n = parents.len();
+    let mut standing = vec![0.0; n * pas];
+    let mut standing_last = vec![0.0; n * pas];
+    for (i, &k) in shed.iter().enumerate() {
+        let Some(axis) = (k != usize::MAX).then(|| &tree.axes[k]) else {
+            continue;
+        };
+        for p in &axis.phytomers {
+            standing[i * pas + axis.pa] += p.scale;
+            if p.cycle == request.age {
+                standing_last[i * pas + axis.pa] += p.scale;
+            }
+        }
+    }
+    sum_up(&parents, pas, &mut [&mut standing, &mut standing_last]);
+    tree.axes.clear();
+    for (lateral, i) in out.iter_mut() {
+        lateral.shed = shed[*i] == usize::MAX;
+        lateral.standing = standing[*i * pas..(*i + 1) * pas].to_vec();
+        lateral.standing_last = standing_last[*i * pas..(*i + 1) * pas].to_vec();
+    }
+    Ok(out.into_iter().map(|(l, _)| l).collect())
+}
+
+/// The settle's shed and scale, as `settle_shed` and `settle_lay` take
+/// them, of the grower already marked and assigned: each grown axis's
+/// index in the settled tree (none where shed), and that tree scaled.
+fn settled(
+    g: super::super::Grower<'_>,
+    species: &Species,
+    request: Request,
+) -> Result<(Vec<usize>, crate::structure::Structure)> {
+    let threads = g.threads;
+    let w = g.working.as_ref().expect("a working set");
+    let r = w.retirement();
+    let (given, gone) = (|i| r.root(i), |i| r.inside(i));
+    let shed = crate::shed::shed_past(g.axes, species, request.age, (&given, &gone), None).0;
+    let mut tree = crate::structure::Structure {
+        age: request.age,
+        pas: species.states.len(),
+        axes: shed.axes,
+    };
+    crate::geometry::scale(&mut tree, species, threads);
+    Ok((shed.index, tree))
+}
+
+/// Each axis's per-age sums in `cols` gathered into its parent's, from
+/// the tips down (a parent precedes its children).
+fn sum_up(parents: &[Option<usize>], pas: usize, cols: &mut [&mut Vec<f64>]) {
+    for i in (1..parents.len()).rev() {
+        let Some(p) = parents[i] else {
+            continue;
+        };
+        for col in cols.iter_mut() {
+            for k in 0..pas {
+                col[p * pas + k] += col[i * pas + k];
+            }
+        }
+    }
+}
+
+/// Each lateral's record and its index, every subtree summed from the
+/// tips down (a parent precedes its children).
+fn read(axes: &[Axis], pas: usize, age: u32) -> Vec<(Lateral, usize)> {
+    let n = axes.len();
+    let (mut count, mut count_last) = (vec![0.0; n * pas], vec![0.0; n * pas]);
+    let mut last: Vec<Option<u32>> = vec![None; n];
+    for (i, a) in axes.iter().enumerate() {
+        for p in &a.phytomers {
+            count[i * pas + a.pa] += 1.0;
+            if p.cycle == age {
+                count_last[i * pas + a.pa] += 1.0;
+            }
+        }
+        last[i] = a.phytomers.iter().map(|p| p.cycle).max();
+    }
+    let parents: Vec<Option<usize>> = axes.iter().map(|a| a.origin.parent()).collect();
+    sum_up(&parents, pas, &mut [&mut count, &mut count_last]);
+    for i in (1..n).rev() {
+        if let Some(p) = parents[i] {
+            last[p] = last[p].max(last[i]);
+        }
+    }
+    let mut order = vec![0u32; n];
+    let mut out = Vec::new();
+    for (i, a) in axes.iter().enumerate() {
+        let Origin::Lateral {
+            parent,
+            node,
+            woken,
+            ..
+        } = a.origin
+        else {
+            order[i] = a.origin.parent().map_or(0, |p| order[p]);
+            continue;
+        };
+        order[i] = order[parent] + 1;
+        let bearer = &axes[parent];
+        let lateral = Lateral {
+            lineage: a.lineage,
+            pa: a.pa,
+            birth: a.birth,
+            woken,
+            bearer_pa: bearer.pa,
+            node,
+            order: order[i],
+            light: a.phytomers.first().map(|p| p.light),
+            bearer_light: bearer.phytomers[node].light,
+            apex_end: a.apex_end,
+            last: last[i],
+            shed: false,
+            count: count[i * pas..(i + 1) * pas].to_vec(),
+            count_last: count_last[i * pas..(i + 1) * pas].to_vec(),
+            standing: Vec::new(),
+            standing_last: Vec::new(),
+        };
+        out.push((lateral, i));
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::light::Light;
+
+    /// The laterals the recorder keeps are the laterals the full cycle's
+    /// tree holds, by lineage, and a lateral has a first light exactly
+    /// where it grew a phytomer of its own age: the recorder reads the
+    /// tree the cycle grows.
+    #[test]
+    fn the_kept_laterals_are_the_full_cycles() {
+        let light = Light {
+            extinction: 0.5,
+            sky: 0.5,
+        };
+        let request = Request {
+            age: 12,
+            seed: 1001,
+            light,
+        };
+        let oak = crate::oak();
+        let records = grow_laterals(&oak, request).expect("records");
+        let tree = super::super::grow_cycle(&oak, request).expect("a tree");
+        let mut kept: Vec<u64> = (records.iter().filter(|l| !l.shed))
+            .map(|l| l.lineage)
+            .collect();
+        let mut held: Vec<u64> = (tree.structure.axes.iter())
+            .filter(|a| matches!(a.origin, Origin::Lateral { .. }))
+            .map(|a| a.lineage)
+            .collect();
+        kept.sort_unstable();
+        held.sort_unstable();
+        assert!(records.iter().any(|l| l.shed), "nothing shed at 12");
+        assert_eq!(kept, held);
+        let grown = |l: &Lateral| l.light.is_some() == (l.count[l.pa] > 0.0);
+        assert!(records.iter().all(grown));
+        let gone = |l: &&Lateral| l.shed && l.standing.iter().any(|&s| s != 0.0);
+        assert_eq!(records.iter().filter(gone).count(), 0);
+        let held = held_by_lineage(&tree.structure, oak.states.len());
+        for l in records.iter().filter(|l| !l.shed) {
+            let (all, last) = &held[&l.lineage];
+            for (ours, theirs) in [(&l.standing, all), (&l.standing_last, last)] {
+                let near = |(a, b): (&f64, &f64)| (a - b).abs() <= 1e-9 * b.abs().max(1.0);
+                assert!(ours.iter().zip(theirs).all(near), "{ours:?} vs {theirs:?}");
+            }
+        }
+    }
+
+    /// Each lateral of a settled tree's subtree, by age, summed by scale,
+    /// and those of the last cycle, by lineage.
+    fn held_by_lineage(
+        tree: &crate::structure::Structure,
+        pas: usize,
+    ) -> std::collections::HashMap<u64, (Vec<f64>, Vec<f64>)> {
+        let n = tree.axes.len();
+        let (mut all, mut last) = (vec![0.0; n * pas], vec![0.0; n * pas]);
+        for (i, a) in tree.axes.iter().enumerate() {
+            for p in &a.phytomers {
+                all[i * pas + a.pa] += p.scale;
+                if p.cycle == tree.age {
+                    last[i * pas + a.pa] += p.scale;
+                }
+            }
+        }
+        // The settled tree is in lineage order, a child possibly before its
+        // parent: gathered deepest first.
+        let parents: Vec<Option<usize>> = tree.axes.iter().map(|a| a.origin.parent()).collect();
+        let depth = |mut i: usize| {
+            let mut d = 0;
+            while let Some(p) = parents[i] {
+                (i, d) = (p, d + 1);
+            }
+            d
+        };
+        let mut deepest: Vec<usize> = (0..n).collect();
+        deepest.sort_by_key(|&i| std::cmp::Reverse(depth(i)));
+        for i in deepest {
+            let Some(p) = parents[i] else {
+                continue;
+            };
+            for k in 0..pas {
+                all[p * pas + k] += all[i * pas + k];
+                last[p * pas + k] += last[i * pas + k];
+            }
+        }
+        let span = |v: &[f64], i: usize| v[i * pas..(i + 1) * pas].to_vec();
+        // A relay carries its parent's lineage: only laterals are keyed.
+        (tree.axes.iter().enumerate())
+            .filter(|(_, a)| matches!(a.origin, Origin::Lateral { .. }))
+            .map(|(i, a)| (a.lineage, (span(&all, i), span(&last, i))))
+            .collect()
+    }
+}
diff --git i/crates/telperion-space/src/grow/cycle/replay.rs w/crates/telperion-space/src/grow/cycle/replay.rs
new file mode 100644
index 000000000..f74b69320
--- /dev/null
+++ w/crates/telperion-space/src/grow/cycle/replay.rs
@@ -0,0 +1,473 @@
+//! fn-339 R3's dry run: the cohort law replayed on a full cycle's tree. The
+//! grower runs as fn-335's recorder runs it (every axis open, none retired),
+//! keeping each year's lattice. On every growth unit of the wood that stays
+//! structural at the boundary, the law's cohorts (`law.rs`), births in
+//! expectation and as the cycle drew them, are set beside what the cycle's
+//! own laterals of the cohort ages hold at the tree's age. A measurement
+//! only: it reads the grower and changes nothing it grows.
+mod law;
+
+use super::super::sketch::Sketch;
+use super::super::{start, Options, Request};
+use super::Working;
+use crate::error::Result;
+use crate::light::Field;
+use crate::presence::assign;
+use crate::species::Species;
+use crate::structure::{Origin, Vec3};
+use law::{Law, Q, V};
+use std::collections::{BTreeMap, HashSet};
+
+pub use law::{GREW, LEAF_CUR, LEAF_DRAWN, LIVING, PHYTO, SECTION, STANDING, WOOD};
+
+/// What one side holds over a set of bearing units: the law's quantities,
+/// the sections joined to the bearer by its exponent, and the roots.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct Side {
+    pub v: V,
+    pub join: f64,
+    pub roots: f64,
+    /// Roots the balance hazard alone sheds before the tree's age.
+    pub balance: f64,
+}
+
+/// One cell's bearing units: the cycle, the law with births in expectation,
+/// the law with the cycle's own births; the cycle's leaf and wood at size 1.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct Cell {
+    pub units: u64,
+    pub cycle: Side,
+    /// The law, births expected: shed by the root at size 1, by the
+    /// species' rule at size 1, by the species' rule at the bearing unit's
+    /// size, by the root at the bearing unit's size; then the species' rule
+    /// at size 1 with the cycle's own births (`LAWS`).
+    pub law: [Side; 5],
+    pub at_one: [f64; 2],
+    pub light: f64,
+}
+
+/// The law's five readings, in `Cell::law`'s order.
+pub const LAWS: [&str; 5] = ["root-1", "subtree-1", "subtree-size", "root-size", "subtree-1-drawn"];
+
+/// The replay of one tree.
+pub struct Replay {
+    /// Each lateral age's expected subtree reach (`R1-LAW.md`), infinite
+    /// where it bears its own age.
+    pub reach: Vec<f64>,
+    /// Per cycle: units grown, and those inside the cohorts at each
+    /// threshold.
+    pub apex: Vec<[u64; 4]>,
+    /// The bearing units' cells, by lattice node.
+    pub cells: BTreeMap<[i32; 3], Cell>,
+    /// The structure's own share of the tree at its age: units grown,
+    /// current-year leaf, standing leaf; the cycle's whole tree beside it.
+    pub structure: [f64; 3],
+    pub whole: [f64; 3],
+    /// Leaf-bearing ground columns of 0.5 m: the cycle's, and the law's.
+    pub columns: [usize; 2],
+    /// The lattice kept against the cycle's own reads: apexes compared and
+    /// the largest difference.
+    pub light_check: (u64, f64),
+    /// The size trace's sums per cohort age.
+    pub trace: BTreeMap<usize, [f64; 9]>,
+}
+
+/// Each lateral age's expected subtree reach: its axis's expected path,
+/// relays carrying it on, plus the farthest of what it bears.
+pub fn reaches(species: &Species) -> Vec<f64> {
+    let n = species.states.len();
+    let mut r = vec![0.0; n + 1];
+    for j in (0..n).rev() {
+        let s = &species.states[j];
+        let unit: f64 = s.zones.iter().map(|z| z.nodes.mean()).sum::<f64>() * s.internode;
+        let (mut own, mut alive, mut t) = (0.0, 1.0, 0.0);
+        while t < s.lifespan {
+            let share = (s.lifespan - t).min(1.0);
+            alive *= 1.0 - (1.0 - s.viability) * (1.0 - s.relay_failed);
+            own += share * alive * unit;
+            alive *= 1.0 - s.viability * s.abortion * (1.0 - s.relay);
+            t += 1.0;
+        }
+        r[j] = own + s.continuation * r[j + 1];
+    }
+    let borne = |j: usize| {
+        let mut out = HashSet::new();
+        let mut k = Some(j);
+        while let Some(pa) = k {
+            for z in &species.states[pa].zones {
+                for i in 0..n {
+                    if z.lateral[i] > 0.0 || z.dormant[i] > 0.0 {
+                        if let Some((li, _)) = species.lived(i) {
+                            out.insert(li);
+                        }
+                    }
+                }
+            }
+            k = (species.states[pa].continuation > 0.0 && pa + 1 < n)
+                .then(|| species.lived(pa + 1).map(|l| l.0))
+                .flatten();
+        }
+        out
+    };
+    fn extent(j: usize, r: &[f64], borne: &dyn Fn(usize) -> HashSet<usize>, seen: &mut Vec<usize>) -> f64 {
+        if seen.contains(&j) {
+            return f64::INFINITY;
+        }
+        seen.push(j);
+        let far = borne(j).into_iter().map(|i| extent(i, r, borne, seen)).fold(0.0, f64::max);
+        seen.pop();
+        r[j] + far
+    }
+    (0..n).map(|j| extent(j, &r, &borne, &mut Vec::new())).collect()
+}
+
+/// The ages that arise as laterals, and those of them whose subtree's
+/// reach is under `threshold`.
+pub fn cohorts(species: &Species, reach: &[f64], threshold: f64) -> Vec<usize> {
+    let mut out = HashSet::new();
+    for s in species.states.iter().filter(|s| s.lifespan > 0.0) {
+        for z in &s.zones {
+            for (i, (&p, &d)) in z.lateral.iter().zip(&z.dormant).enumerate() {
+                if p > 0.0 || d > 0.0 {
+                    if let Some((li, _)) = species.lived(i) {
+                        out.insert(li);
+                    }
+                }
+            }
+        }
+    }
+    let mut out: Vec<usize> = out.into_iter().filter(|&j| reach[j] < threshold).collect();
+    out.sort_unstable();
+    out
+}
+
+/// `species` grown to `request` by the full cycle and replayed with the
+/// cohorts of `thresholds` (the second the boundary read; all three for
+/// the share of units).
+pub fn grow_replay(species: &Species, request: Request, thresholds: [f64; 3]) -> Result<Replay> {
+    let reach = reaches(species);
+    let sets: Vec<Vec<usize>> = thresholds.iter().map(|&t| cohorts(species, &reach, t)).collect();
+    let (mut g, _) = start(species, request, Options::default())?;
+    (g.one, g.rules.one) = (true, true);
+    g.working = Some(Box::new(Working::reference()));
+    g.sketch.get_or_insert_with(|| Sketch::new(request.light));
+    g.rules.lasting = vec![None; species.states.len()].into();
+    let age = request.age;
+    let mut fields: Vec<Option<Field>> = vec![None];
+    let mut check = (0u64, 0.0f64);
+    let mut advanced = Vec::new();
+    for c in 1..=age {
+        g.year(c, c < age, &mut advanced, &mut |_| {})?;
+        let lit = field(&g, request)?;
+        if c < age {
+            check_light(&g, &lit, &mut check);
+        }
+        fields.push(Some(lit));
+    }
+    g.mark();
+    assign(&mut g.axes, &g.draws, species, g.threads);
+    let apex = shares(&g.axes, &sets, age);
+    let n = g.axes.len();
+    let inside = within(&g.axes, &sets[1]);
+    let made: Vec<f64> = g.draws.iter().map(|d| d.birth[0] * d.birth[1]).collect();
+    // The size trace (PROTOCOL.md): for each axis of a cohort age that
+    // grew in the last cycle, its last unit's size, its survival's
+    // presence, and its pencil's presence (base scale, running, kept).
+    let pencils = g.sketch.as_ref().map(|s| &s.pencils);
+    let traced: Vec<Option<[f64; 3]>> = (0..g.axes.len())
+        .map(|i| {
+            let a = &g.axes[i];
+            let d = &g.draws[i];
+            let grew = a.phytomers.last().is_some_and(|p| p.cycle == age);
+            if !grew || !sets[1].contains(&a.pa) {
+                return None;
+            }
+            let unit = d.units.last()?;
+            let size = d.shade.last().map_or(1.0, |s| s[0]);
+            let pencil = pencils.and_then(|p| p.get(i)).map_or(0.0, |p| p.base_scale * p.running * p.kept);
+            Some([size, unit.survive, pencil])
+        })
+        .collect();
+    let grown = std::mem::take(&mut g.axes);
+    let (index, tree) = settled(g, grown.clone(), species, request)?;
+    // Each axis's own standing quantities at the tree's age, summed up.
+    let mut own = vec![[0.0; Q]; n];
+    let mut at_one = vec![[0.0; 2]; n];
+    for (i, a) in grown.iter().enumerate() {
+        let s = &species.states[a.pa];
+        let Some(kept) = (index[i] != usize::MAX).then(|| &tree.axes[index[i]]) else {
+            continue;
+        };
+        // Counts by presence, as the law's are: a member's settled scale.
+        let mean = |ps: &mut dyn Iterator<Item = f64>| {
+            let (sum, k) = ps.fold((0.0, 0.0), |(s, k), x| (s + x, k + 1.0));
+            (k > 0.0).then(|| sum / k)
+        };
+        // The settled scale holds the unit's size (`geometry::scale`): a
+        // phytomer's presence is its scale over its size.
+        let presence = |p: &crate::structure::Phytomer| if p.size > 0.0 { p.scale / p.size } else { 0.0 };
+        let whole = mean(&mut kept.phytomers.iter().map(presence)).unwrap_or(made[i]);
+        let last = mean(&mut kept.phytomers.iter().filter(|p| p.cycle == age).map(presence));
+        own[i][GREW] = last.unwrap_or(0.0);
+        own[i][LIVING] = if a.apex_end.is_none() { kept.phytomers.last().map_or(made[i], presence) } else { 0.0 };
+        own[i][STANDING] = whole;
+        for p in &kept.phytomers {
+            let (scale, bare) = (p.scale, presence(p));
+            own[i][PHYTO] += bare;
+            own[i][WOOD] += s.internode * scale;
+            at_one[i][1] += s.internode * bare;
+            own[i][SECTION] += (s.form.pipe * scale).powi(2);
+            if p.cycle == age {
+                own[i][LEAF_CUR] += s.leaf_area * scale;
+                at_one[i][0] += s.leaf_area * bare;
+            }
+            if s.cluster_leaves == 0.0 && f64::from(age - p.cycle) < s.leaf_years {
+                own[i][LEAF_DRAWN] += s.leaf_area * scale;
+            }
+        }
+        if s.cluster_leaves > 0.0 && own[i][GREW] > 0.0 {
+            let scale = kept.phytomers.last().map_or(0.0, |p| p.scale);
+            own[i][LEAF_DRAWN] += s.cluster_leaves * s.leaf_area * scale;
+        }
+    }
+    // The trace's sums per cohort age: units, then size weighted by one,
+    // by survival's presence, by the pencil's presence, by the settled
+    // scale of the unit's phytomers, each with its weight's own sum.
+    let mut trace: BTreeMap<usize, [f64; 9]> = BTreeMap::new();
+    for (i, t) in traced.iter().enumerate() {
+        let (Some([size, survive, pencil]), true) = (t, index[i] != usize::MAX) else {
+            continue;
+        };
+        let kept = &tree.axes[index[i]].phytomers;
+        let last: Vec<f64> = kept.iter().filter(|p| p.cycle == age).map(|p| p.scale).collect();
+        let settled = last.iter().sum::<f64>() / last.len().max(1) as f64;
+        let row = trace.entry(grown[i].pa).or_default();
+        for (k, x) in [1.0, *size, *survive, survive * size, *pencil, pencil * size, settled, settled * size, 0.0].into_iter().enumerate() {
+            row[k] += x;
+        }
+    }
+    let (mut sub, mut sub_unsized) = (own.clone(), at_one.clone());
+    for i in (1..n).rev() {
+        if let Some(p) = grown[i].origin.parent() {
+            for q in 0..Q {
+                sub[p][q] += sub[i][q];
+            }
+            for q in 0..2 {
+                sub_unsized[p][q] += sub_unsized[i][q];
+            }
+        }
+    }
+    // The structure: kept axes outside every cohort at the boundary.
+    let law = Law::new(species, age);
+    law.check(&sets[1]);
+    let mut cells: BTreeMap<[i32; 3], Cell> = BTreeMap::new();
+    let mut structure = [0.0; 3];
+    let mut whole = [0.0; 3];
+    let mut cols: [HashSet<[i32; 2]>; 2] = [HashSet::new(), HashSet::new()];
+    let column = |p: Vec3| [(p.x / 0.5).floor() as i32, (p.y / 0.5).floor() as i32];
+    for (i, a) in grown.iter().enumerate() {
+        whole[0] += own[i][GREW];
+        whole[1] += own[i][LEAF_CUR];
+        whole[2] += own[i][LEAF_DRAWN];
+        if index[i] != usize::MAX && own[i][LEAF_DRAWN] > 0.0 {
+            for p in &a.phytomers {
+                cols[0].insert(column(p.tip));
+                if !inside[i] {
+                    cols[1].insert(column(p.tip));
+                }
+            }
+        }
+        if inside[i] {
+            continue;
+        }
+        structure[0] += own[i][GREW];
+        structure[1] += own[i][LEAF_CUR];
+        structure[2] += own[i][LEAF_DRAWN];
+    }
+    // The cycle's roots by their bearer's unit.
+    let mut roots: BTreeMap<(usize, u32), Vec<usize>> = BTreeMap::new();
+    for (i, a) in grown.iter().enumerate() {
+        if let Origin::Lateral { parent, node, .. } = a.origin {
+            if sets[1].contains(&a.pa) && !inside[parent] {
+                roots.entry((parent, grown[parent].phytomers[node].cycle)).or_default().push(i);
+            }
+        }
+    }
+    for (i, a) in grown.iter().enumerate() {
+        if inside[i] || index[i] == usize::MAX || a.phytomers.is_empty() {
+            continue;
+        }
+        let e = species.states[a.pa].form.exponent;
+        let mut start = 0;
+        while start < a.phytomers.len() {
+            let b = a.phytomers[start].cycle;
+            let end = start + a.phytomers[start..].iter().take_while(|p| p.cycle == b).count();
+            let unit = &a.phytomers[start..end];
+            start = end;
+            let k = unit.len() as f64;
+            let at = unit.iter().fold(Vec3::default(), |s, p| Vec3::new(s.x + p.tip.x / k, s.y + p.tip.y / k, s.z + p.tip.z / k));
+            // The bearer's presence as the settle scales it.
+            let kept = &tree.axes[index[i]].phytomers;
+            let presence = match kept.len() == a.phytomers.len() {
+                true => kept[start - unit.len()..start].iter().map(|p| if p.size > 0.0 { p.scale / p.size } else { 0.0 }).sum::<f64>() / k,
+                false => 1.0,
+            };
+            let light: Vec<f64> = (0..=age as usize)
+                .map(|c| if c < 2 { 1.0 } else { fields[c - 1].as_ref().map_or(1.0, |f| f.at(at)) })
+                .collect();
+            let cell = cells.entry([0, 1, 2].map(|d| ([at.x, at.y, at.z][d] / 0.5).floor() as i32)).or_default();
+            cell.units += 1;
+            cell.light += light[age as usize];
+            let size = match kept.len() == a.phytomers.len() {
+                true => kept[start - unit.len()..start].iter().map(|p| p.size).sum::<f64>() / k,
+                false => 1.0,
+            };
+            let mut by_root = law::Unit::new(&law, &light, law::Shed::Root);
+            let mut by_subtree = law::Unit::new(&law, &light, law::Shed::Subtree);
+            for &j in &sets[1] {
+                let q = law.lat[a.pa][j];
+                if q > 0.0 {
+                    let [r1, s1, ss, rs, _] = &mut cell.law;
+                    add(r1, &mut by_root, (j, b), (q, presence, 1.0), e);
+                    add(s1, &mut by_subtree, (j, b), (q, presence, 1.0), e);
+                    add(ss, &mut by_subtree, (j, b), (q, presence, size), e);
+                    add(rs, &mut by_root, (j, b), (q, presence, size), e);
+                }
+            }
+            for &r in roots.get(&(i, b)).map_or(&[][..], |v| &v[..]) {
+                add(&mut cell.law[4], &mut by_subtree, (grown[r].pa, b), (1.0, made[r] * presence, 1.0), e);
+                for q in 0..Q {
+                    cell.cycle.v[q] += sub[r][q];
+                }
+                for q in 0..2 {
+                    cell.at_one[q] += sub_unsized[r][q];
+                }
+                if sub[r][STANDING] > 0.0 && own[r][STANDING] > 0.0 {
+                    cell.cycle.join += sub[r][SECTION].powf(e / 2.0);
+                }
+                cell.cycle.roots += 1.0;
+            }
+            if cell.law[1].v[LEAF_DRAWN] > 0.0 {
+                cols[1].insert(column(at));
+            }
+        }
+    }
+    Ok(Replay {
+        reach,
+        apex,
+        cells,
+        structure,
+        whole,
+        columns: [cols[0].len(), cols[1].len()],
+        light_check: check,
+        trace,
+    })
+}
+
+/// `count` roots of age `j` born at `b` on a unit, the law's, into `side`.
+/// `count` roots of age `j` born at `b` on a unit at presence `presence`,
+/// the law's, into `side`, their leaf and wood at `size`. A count is its
+/// whole part and one member at its fraction (R1-ANSWERS.md, answer 8),
+/// and a member at presence p holds a section as p squared and joins its
+/// bearer as p to the bearer's exponent (PROTOCOL.md): so section and join
+/// take the count's second (and e-th) moment, everything else its mean.
+/// A size scales a phytomer as its presence does (`geometry::scale`).
+fn add(side: &mut Side, eval: &mut law::Unit, (j, b): (usize, u32), (count, presence, size): (f64, f64, f64), e: f64) {
+    let (v, stand, section, lost) = eval.member(j, b, true);
+    let whole = count.floor();
+    let moment = |power: f64| (whole + (count - whole).powf(power)) * presence.powf(power);
+    side.balance += count * presence * lost;
+    let at = v.last().copied().unwrap_or([0.0; Q]);
+    for q in 0..Q {
+        let scale = match q {
+            SECTION => moment(2.0) * size * size,
+            LEAF_CUR | LEAF_DRAWN | WOOD => count * presence * size,
+            _ => count * presence,
+        };
+        side.v[q] += scale * at[q];
+    }
+    if stand > 0.0 {
+        side.join += moment(e) * size.powf(e) * stand * (section / stand).powf(e / 2.0);
+    }
+    side.roots += count * presence;
+}
+
+/// The lattice the cycle's leaves of this year cast, over every tip laid
+/// so far and the base, so any later read of a unit laid by now is inside.
+fn field(g: &super::super::Grower<'_>, request: Request) -> Result<Field> {
+    let (mut lo, mut hi) = (Vec3::default(), Vec3::default());
+    for p in g.axes.iter().flat_map(|a| a.phytomers.iter()) {
+        lo = Vec3::new(lo.x.min(p.tip.x), lo.y.min(p.tip.y), lo.z.min(p.tip.z));
+        hi = Vec3::new(hi.x.max(p.tip.x), hi.y.max(p.tip.y), hi.z.max(p.tip.z));
+    }
+    Field::quantised(&request.light, &g.leaves, &[lo, hi], g.threads)
+}
+
+/// The kept lattice read where the cycle read it at the cycle's end
+/// (`Grower::shade`): every living apex's tip, against its pencil's light.
+fn check_light(g: &super::super::Grower<'_>, field: &Field, check: &mut (u64, f64)) {
+    let Some(sketch) = g.sketch.as_ref() else {
+        return;
+    };
+    for a in g.live.iter().filter(|a| a.axis < sketch.pencils.len()) {
+        let axis = &g.axes[a.axis];
+        let tip = axis.phytomers.last().map_or(axis.base, |p| p.tip);
+        let d = (field.at(tip) - sketch.pencils[a.axis].light).abs();
+        check.0 += 1;
+        check.1 = check.1.max(d);
+    }
+}
+
+/// Whether each axis lies inside a cohort of `set`: a lateral of its ages,
+/// or anything it bears or carries on.
+fn within(axes: &[crate::structure::Axis], set: &[usize]) -> Vec<bool> {
+    let mut inside = vec![false; axes.len()];
+    for (i, a) in axes.iter().enumerate() {
+        let parent = a.origin.parent().map_or(false, |p| inside[p]);
+        let root = matches!(a.origin, Origin::Lateral { .. }) && set.contains(&a.pa);
+        inside[i] = parent || root;
+    }
+    inside
+}
+
+/// Per cycle, the units grown, and those inside each set's cohorts.
+fn shares(axes: &[crate::structure::Axis], sets: &[Vec<usize>], age: u32) -> Vec<[u64; 4]> {
+    let inside: Vec<Vec<bool>> = sets.iter().map(|s| within(axes, s)).collect();
+    let mut out = vec![[0u64; 4]; age as usize + 1];
+    for (i, a) in axes.iter().enumerate() {
+        let mut last = None;
+        for p in &a.phytomers {
+            if last == Some(p.cycle) {
+                continue;
+            }
+            last = Some(p.cycle);
+            let row = &mut out[p.cycle as usize];
+            row[0] += 1;
+            for (k, ins) in inside.iter().enumerate() {
+                row[k + 1] += u64::from(ins[i]);
+            }
+        }
+    }
+    out
+}
+
+/// The settle's shed and scale, as fn-335's recorder takes them.
+fn settled(
+    g: super::super::Grower<'_>,
+    axes: Vec<crate::structure::Axis>,
+    species: &Species,
+    request: Request,
+) -> Result<(Vec<usize>, crate::structure::Structure)> {
+    let threads = g.threads;
+    let w = g.working.as_ref().expect("a working set");
+    let r = w.retirement();
+    let (given, gone) = (|i| r.root(i), |i| r.inside(i));
+    let shed = crate::shed::shed_past(axes, species, request.age, (&given, &gone), None).0;
+    let mut tree = crate::structure::Structure {
+        age: request.age,
+        pas: species.states.len(),
+        axes: shed.axes,
+    };
+    crate::geometry::scale(&mut tree, species, threads);
+    Ok((shed.index, tree))
+}
diff --git i/crates/telperion-space/src/grow/cycle/replay/law.rs w/crates/telperion-space/src/grow/cycle/replay/law.rs
new file mode 100644
index 000000000..eef9e8adf
--- /dev/null
+++ w/crates/telperion-space/src/grow/cycle/replay/law.rs
@@ -0,0 +1,343 @@
+//! fn-339 R3: the cohort law as the host answered it (R1-ANSWERS.md), on
+//! one bearing growth unit and the light the cycle gave its cell each year.
+//! A cohort is the subtrees of one root age born in one cycle on the unit;
+//! what it holds is the expectation over its own years from the tables,
+//! survival shaded by the cell's light, the root's own balance hazard on
+//! top, and the root's death sheds all of it after the root's shedding.
+//! Inner members are counted flat: each stands while it lives and for its
+//! own shedding after, and what it bore stands while the root does.
+use crate::species::Species;
+use std::collections::HashMap;
+
+/// What a cohort holds at a cycle: units grown that cycle, apexes living at
+/// its end, members standing, the current year's leaf (what the lattice
+/// takes), the standing leaf the expansion draws, wood metres, section
+/// (sum of pipe squared, every cohort age's exponent being 2), phytomers.
+pub const Q: usize = 8;
+pub const GREW: usize = 0;
+pub const LIVING: usize = 1;
+pub const STANDING: usize = 2;
+pub const LEAF_CUR: usize = 3;
+pub const LEAF_DRAWN: usize = 4;
+pub const WOOD: usize = 5;
+pub const SECTION: usize = 6;
+pub const PHYTO: usize = 7;
+
+pub type V = [f64; Q];
+
+/// The species read once for the law.
+pub struct Law<'s> {
+    species: &'s Species,
+    /// Each age's expected laterals of each age a unit bears.
+    pub lat: Vec<Vec<f64>>,
+    /// Each age's units, by the age each is grown in, for a member of it.
+    chain: Vec<Vec<usize>>,
+    nodes: Vec<f64>,
+    pub age: u32,
+}
+
+impl<'s> Law<'s> {
+    pub fn new(species: &'s Species, age: u32) -> Self {
+        let n = species.states.len();
+        let mut lat = vec![vec![0.0; n]; n];
+        for (k, state) in species.states.iter().enumerate() {
+            for (z, probs) in state.laterals().iter().enumerate() {
+                let zone = &state.zones[z];
+                let each = zone.nodes.mean() * zone.buds;
+                for (i, &p) in probs.iter().enumerate() {
+                    if let Some((li, reach)) = species.lived(i) {
+                        lat[k][li] += each * p * reach;
+                    }
+                }
+            }
+        }
+        let nodes = (species.states.iter())
+            .map(|s| s.zones.iter().map(|z| z.nodes.mean()).sum())
+            .collect();
+        let chain = (0..n).map(|j| chain_of(species, j, age)).collect();
+        Self {
+            species,
+            lat,
+            chain,
+            nodes,
+            age,
+        }
+    }
+
+    /// The ages a cohort of `ages` can hold, refused where the law as
+    /// written does not carry what their tables set.
+    pub fn check(&self, ages: &[usize]) {
+        for &j in ages {
+            for &pa in &self.chain[j] {
+                let s = &self.species.states[pa];
+                assert!(s.abortion == 0.0 && s.relay == 0.0, "no abortion or relay on cohort age {pa}");
+                assert!(s.relay_ended == 0.0 && s.relay_failed == 0.0, "no relay on cohort age {pa}");
+                assert!(s.form.exponent == 2.0, "cohort age {pa} sums sections at 2");
+                assert!(s.zones.iter().all(|z| z.dormant.iter().all(|&d| d == 0.0)), "no sleeping buds on {pa}");
+            }
+        }
+    }
+}
+
+/// The ages a member of age `j` grows its units in: each age's whole
+/// lifespan, then on by its continuation where that is 1.
+fn chain_of(species: &Species, j: usize, age: u32) -> Vec<usize> {
+    let mut out = Vec::new();
+    let Some((mut pa, _)) = species.lived(j) else {
+        return out;
+    };
+    loop {
+        let s = &species.states[pa];
+        for _ in 0..(s.lifespan.ceil() as usize) {
+            out.push(pa);
+        }
+        if out.len() > age as usize || s.continuation < 1.0 || pa + 1 >= species.states.len() {
+            break;
+        }
+        match species.lived(pa + 1) {
+            Some((next, reach)) if reach >= 1.0 => pa = next,
+            _ => break,
+        }
+    }
+    out.truncate(age as usize + 1);
+    out
+}
+
+/// The law on one unit: its cell's light each cycle (`light[c]`, 1 at 0),
+/// and the members already worked out, by age and birth.
+pub struct Unit<'l, 's> {
+    law: &'l Law<'s>,
+    light: &'l [f64],
+    memo: HashMap<(usize, u32), Vec<V>>,
+    shed: Shed,
+}
+
+impl<'l, 's> Unit<'l, 's> {
+    pub fn new(law: &'l Law<'s>, light: &'l [f64], shed: Shed) -> Self {
+        Self {
+            law,
+            light,
+            memo: HashMap::new(),
+            shed,
+        }
+    }
+
+    fn sigma(&self, pa: usize, c: u32) -> f64 {
+        let s = &self.law.species.states[pa];
+        let l = self.light[(c as usize).min(self.light.len() - 1)];
+        if s.shade_hazard > 0.0 && l < 1.0 {
+            s.viability.powf(l.powf(-s.shade_hazard))
+        } else {
+            s.viability
+        }
+    }
+
+    /// The member's own contribution at `c` if it grew exactly `k` units
+    /// from birth `t`, before its standing is gated.
+    fn own(&self, ch: &[usize], t: u32, k: usize, c: u32) -> V {
+        let sp = &self.law.species.states;
+        let mut v = [0.0; Q];
+        let since = (c - t) as usize;
+        let g = k.min(since);
+        v[STANDING] = 1.0;
+        if k >= since && since >= 1 {
+            let pa = ch[since - 1];
+            v[GREW] = 1.0;
+            v[LEAF_CUR] = self.law.nodes[pa] * sp[pa].leaf_area;
+            if sp[pa].cluster_leaves > 0.0 {
+                v[LEAF_DRAWN] += sp[pa].cluster_leaves * sp[pa].leaf_area;
+            }
+        }
+        if k > since {
+            v[LIVING] = 1.0;
+        }
+        for n in 1..=g {
+            let s = &sp[ch[n - 1]];
+            let nodes = self.law.nodes[ch[n - 1]];
+            v[PHYTO] += nodes;
+            v[WOOD] += nodes * s.internode;
+            v[SECTION] += nodes * s.form.pipe * s.form.pipe;
+            let wood_age = f64::from(c - (t + n as u32));
+            if s.cluster_leaves == 0.0 && wood_age < s.leaf_years {
+                v[LEAF_DRAWN] += nodes * s.leaf_area;
+            }
+        }
+        v
+    }
+
+    /// The tree's present cycle: the last one whose light is known.
+    fn now(&self) -> u32 {
+        (self.light.len() - 1) as u32
+    }
+
+    /// An inner member of age `j` born at `t`: its expected contents at
+    /// every cycle to the present.
+    pub fn inner(&mut self, j: usize, t: u32) -> Vec<V> {
+        if let Some(v) = self.memo.get(&(j, t)) {
+            return v.clone();
+        }
+        let out = self.member(j, t, false).0;
+        self.memo.insert((j, t), out.clone());
+        out
+    }
+
+    /// A member of age `j` born at `t`, as a root (its balance hazard on)
+    /// or inner; and for a root, the chance it stands at the present with
+    /// the section it then holds on average, and the share of it the
+    /// balance alone takes. How what it bore stands follows `self.shed`.
+    pub fn member(&mut self, j: usize, t: u32, root: bool) -> (Vec<V>, f64, f64, f64) {
+        let now = self.now();
+        let ch = self.law.chain[j].clone();
+        let mut out = vec![[0.0; Q]; now as usize + 1];
+        if ch.is_empty() || t > now {
+            return (out, 0.0, 0.0, 0.0);
+        }
+        // A bud made in the present cycle: its apex waits to grow.
+        if t == now {
+            out[now as usize][LIVING] = 1.0;
+            out[now as usize][STANDING] = 1.0;
+            return (out, 1.0, 0.0, 0.0);
+        }
+        // How many units can matter before the present: the rest lumped.
+        let cap = ch.len().min((now - t) as usize + 1);
+        // What its units bear, worked out first: a root's balance reads it.
+        let mut kids: Vec<Vec<V>> = Vec::with_capacity(cap);
+        for n in 1..=cap {
+            let mut sum = vec![[0.0; Q]; now as usize + 1];
+            let born = t + n as u32;
+            if born <= now {
+                for i in 0..self.law.lat.len() {
+                    let q = self.law.lat[ch[n - 1]][i];
+                    if q > 0.0 {
+                        let d = self.inner(i, born);
+                        for (s, x) in sum.iter_mut().zip(&d) {
+                            for k in 0..Q {
+                                s[k] += q * x[k];
+                            }
+                        }
+                    }
+                }
+            }
+            kids.push(sum);
+        }
+        // Survival to grow unit n, shade and (for a root) balance.
+        let sp = &self.law.species.states;
+        let mut alive = vec![1.0; cap + 1];
+        let mut memory = 1.0;
+        let mut kept = 1.0;
+        for n in 1..=cap {
+            let c = t + n as u32;
+            let pa = ch[n - 1];
+            let mut s = self.sigma(pa, c);
+            if root && sp[pa].balance_hazard > 0.0 {
+                let before = c - 1;
+                let mut living = 1.0;
+                let mut wood: f64 = (1..n).map(|m| self.law.nodes[ch[m - 1]] * sp[ch[m - 1]].internode).sum();
+                for kid in kids.iter().take(n - 1) {
+                    living += kid[before as usize][LIVING];
+                    wood += kid[before as usize][WOOD];
+                }
+                let q = living * self.light[(c as usize).min(self.light.len() - 1)];
+                let cost = sp[pa].upkeep * wood;
+                let balance = if q + cost > 0.0 { (q - cost) / (q + cost) } else { 1.0 };
+                memory = (memory + balance) / 2.0;
+                let hazard = sp[pa].balance_hazard * (sp[pa].tolerance - memory).max(0.0);
+                s *= (-hazard).exp();
+                kept *= (-hazard).exp();
+            }
+            alive[n] = alive[n - 1] * s;
+        }
+        // P(T = k): exactly k units grown; the last of `cap` lumps the rest.
+        let p: Vec<f64> = (0..=cap)
+            .map(|k| if k < cap { alive[k] - alive[k + 1] } else { alive[cap] })
+            .collect();
+        // Whether what it bore stands only while it does.
+        let gated = root || self.shed == Shed::Subtree;
+        let (mut stand_now, mut section_now) = (0.0, 0.0);
+        for c in t + 1..=now {
+            let mut v = [0.0; Q];
+            for (k, &pk) in p.iter().enumerate() {
+                if pk <= 0.0 {
+                    continue;
+                }
+                let mut desc = [0.0; Q];
+                for kid in kids.iter().take(k) {
+                    for q in 0..Q {
+                        desc[q] += kid[c as usize][q];
+                    }
+                }
+                let w = self.stands(&ch, (t, k, c), &kids);
+                let own = self.own(&ch, t, k, c);
+                for q in 0..Q {
+                    v[q] += pk * w * own[q];
+                    v[q] += pk * if gated { w } else { 1.0 } * desc[q];
+                }
+                if c == now {
+                    stand_now += pk * w;
+                    section_now += pk * w * (own[SECTION] + desc[SECTION]);
+                }
+            }
+            out[c as usize] = v;
+        }
+        (out, stand_now, section_now, 1.0 - kept)
+    }
+
+    /// How far a member that grew `k` units from `t` still stands at `c`.
+    /// By its root's death (`Shed::Root`), whole while its own apex lived
+    /// within its shedding. By the species' rule (`Shed::Subtree`), also
+    /// while what it bore lived within that time: the chance any of it
+    /// did, from the expected living, as a Poisson count's (fn-339 R3).
+    fn stands(&self, ch: &[usize], (t, k, c): (u32, usize, u32), kids: &[Vec<V>]) -> f64 {
+        let last = ch[k.max(1) - 1];
+        let shed = self.law.species.states[last].shedding;
+        if f64::from(c) <= f64::from(t) + k as f64 + shed {
+            return 1.0;
+        }
+        if self.shed == Shed::Root {
+            return 0.0;
+        }
+        let from = (f64::from(c) - shed).ceil().max(f64::from(t + 1)) as u32;
+        let mut most: f64 = 0.0;
+        for d in from..=c {
+            let living: f64 = kids.iter().take(k).map(|kid| kid[d as usize][LIVING]).sum();
+            most = most.max(living);
+        }
+        1.0 - (-most).exp()
+    }
+}
+
+/// How a cohort's members stand once their apex has stopped.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Shed {
+    /// R1-ANSWERS.md answer 2: a root's death sheds all it bore after its
+    /// shedding; inner members stand flat.
+    Root,
+    /// The species' rule (PROTOCOL.md): each member stands while anything
+    /// it bore lived within its shedding.
+    Subtree,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The paper's case, worked in law.py: an oak branch's medial node at a
+    /// cell light of 0.26 held all ten years, its twig and short laterals
+    /// grown flat; units grown in each year match the linear recursion.
+    #[test]
+    fn the_flat_law_grows_the_papers_units() {
+        let oak = crate::oak();
+        let law = Law::new(&oak, 11);
+        let light = vec![0.26; 12];
+        let mut unit = Unit::new(&law, &light, Shed::Root);
+        let (short, twig) = (crate::chain::SHORT, crate::chain::TWIG);
+        let s = unit.inner(short, 0);
+        let w = unit.inner(twig, 0);
+        // law.py's closed form, oak branch medial node at 0.26.
+        let want = [0.724, 1.139, 1.366, 1.354, 1.253, 0.939, 0.481, 0.186, 0.0, 0.0];
+        for (y, &u) in want.iter().enumerate() {
+            let got = 0.6 * s[y + 1][GREW] + 0.35 * w[y + 1][GREW];
+            assert!((got - u).abs() < 2e-3, "year {}: {got} vs {u}", y + 1);
+        }
+    }
+}
