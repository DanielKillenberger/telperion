+//! fn-339 R3's dry run: the cohort law replayed on a preset's full cycle
+//! (`grow_replay`). A measurement, ignored: it prints lines for
+//! `probes/replay.py` to read.
+use super::executor;
+use crate::presets::by_identity;
+use telperion_space::grow_replay;
+
+fn line(v: &[f64]) -> String {
+    let parts: Vec<String> = v.iter().map(|x| format!("{x:.6e}")).collect();
+    parts.join(" ")
+}
+
+/// `REPLAY_PRESET` at its own age, the full cycle, on each of `REPLAY_SEEDS`:
+/// `REACH` each age's expected subtree reach; `APEX` per cycle the units
+/// grown and those in the cohorts at 0.25, 0.5 and 1.0 m; `CELL` per
+/// lattice node of the bearing units at 0.5 m the units, their mean light
+/// at the tree's age, then for the cycle, the law with births expected and
+/// the law with the cycle's births: the eight quantities, the joined
+/// section and the roots; then the cycle's leaf and wood at size 1;
+/// `TREE` the structure's and the whole cycle's units, leaf and standing
+/// leaf, the leaf columns and the light check.
+#[test]
+#[ignore = "a measurement: fn-339 R3"]
+fn cohort_replay() {
+    let id = std::env::var("REPLAY_PRESET").expect("a preset");
+    let seeds = std::env::var("REPLAY_SEEDS").expect("seeds");
+    for seed in seeds.split(',').map(|s| s.parse::<u32>().expect("a seed")) {
+        one(&id, seed);
+    }
+}
+
+fn one(id: &str, seed: u32) {
+    let mut f = by_identity(id).expect("a preset");
+    f.fidelity = 0.0;
+    f.skeleton.seed = seed;
+    let g = executor::growth(&f).expect("its growth");
+    let started = std::time::Instant::now();
+    let r = grow_replay(&g.species, g.request, [0.25, 0.5, 1.0]).expect("a replay");
+    let seconds = started.elapsed().as_secs_f64();
+    println!("HEAD {id} {seed} age {} seconds {seconds:.2}", g.request.age);
+    for (j, e) in r.reach.iter().enumerate() {
+        println!("REACH {j} {e:.6e}");
+    }
+    for t in [0.25, 0.5, 1.0] {
+        let set = telperion_space::cohorts(&g.species, &r.reach, t);
+        println!("COHORT {t} {set:?}");
+    }
+    for (c, a) in r.apex.iter().enumerate().skip(1) {
+        println!("APEX {c} {} {} {} {}", a[0], a[1], a[2], a[3]);
+    }
+    for (k, c) in &r.cells {
+        let side = |s: &telperion_space::Side| {
+            let mut v = s.v.to_vec();
+            v.extend([s.join, s.roots, s.balance]);
+            line(&v)
+        };
+        println!(
+            "CELL {} {} {} {} {} {} {} {}",
+            k[0],
+            k[1],
+            k[2],
+            c.units,
+            c.light / c.units as f64,
+            side(&c.cycle),
+            c.law.iter().map(side).collect::<Vec<_>>().join(" "),
+            line(&c.at_one)
+        );
+    }
+    for (pa, row) in &r.trace {
+        println!("TRACE {pa} {}", line(row));
+    }
+    let t = [r.structure.to_vec(), r.whole.to_vec()].concat();
+    println!(
+        "TREE {} {} {} {} {:.3e}",
+        line(&t),
+        r.columns[0],
+        r.columns[1],
+        r.light_check.0,
+        r.light_check.1
+    );
+}
