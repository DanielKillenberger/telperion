+//! fn-335: every lateral a preset's full cycle grows, its light at birth,
+//! what its subtree grew and what it still holds at the tree's age, beside
+//! the tables' potential for a bud of its age over the same span
+//! (`PROTOCOL.md` in the spec's evidence). A measurement, ignored: it
+//! prints lines for `probes/read.py` to reduce.
+use super::executor;
+use crate::presets::by_identity;
+use std::collections::HashMap;
+use telperion_space::{expected_bud_counts, grow_laterals, PaState, Species};
+
+/// The resolution fn-334's reach rule is read at for the fine ages.
+const FIDELITY: f64 = 1.0;
+
+/// A unit's mean nodes over its zones.
+fn unit_nodes(state: &PaState) -> f64 {
+    state.zones.iter().map(|z| z.nodes.mean()).sum()
+}
+
+/// fn-334's reach(j): the expected metres of axis a bud of age j grows.
+fn reaches(species: &Species) -> Vec<f64> {
+    let n = species.states.len();
+    let mut reach = vec![0.0; n + 1];
+    for j in (0..n).rev() {
+        let state = &species.states[j];
+        let unit = unit_nodes(state) * state.internode;
+        let (mut own, mut t) = (0.0, 0.0);
+        while t < state.lifespan {
+            let share = (state.lifespan - t).min(1.0);
+            own += share * state.viability.powf(t + 1.0) * unit;
+            t += 1.0;
+        }
+        reach[j] = own + state.continuation * reach[j + 1];
+    }
+    reach.truncate(n);
+    reach
+}
+
+/// fn-334's step 1 at `FIDELITY`: each age's borne(k) and s_k.
+fn factors(species: &Species) -> Vec<(f64, f64)> {
+    let (n, reach) = (species.states.len(), reaches(species));
+    let at = |state: &PaState| {
+        let mut lat = vec![0.0; n];
+        for z in &state.zones {
+            let per_node = z.nodes.mean() * z.buds * state.readiness;
+            for (o, p) in lat.iter_mut().zip(&z.lateral) {
+                *o += per_node * p;
+            }
+        }
+        let total: f64 = lat.iter().sum();
+        let weighted: f64 = lat.iter().zip(&reach).map(|(l, r)| l * r).sum();
+        let borne = if total > 0.0 { weighted / total } else { 0.0 };
+        let cap = (FIDELITY / state.internode).min(unit_nodes(state)).max(1.0);
+        let s = if borne > 0.0 {
+            (FIDELITY / borne).clamp(1.0, cap)
+        } else {
+            cap
+        };
+        (borne, s)
+    };
+    species.states.iter().map(at).collect()
+}
+
+/// Each age's weight per phytomer for the four quantities: phytomers,
+/// leaf area, section and wood length (fn-334's).
+fn weights(species: &Species) -> Vec<[f64; 4]> {
+    let w = |s: &PaState| [1.0, s.leaf_area, s.form.pipe.powf(s.form.exponent), s.internode];
+    species.states.iter().map(w).collect()
+}
+
+/// The four quantities of `by_age`, each age weighted.
+fn weighed(by_age: &[f64], w: &[[f64; 4]]) -> [f64; 4] {
+    std::array::from_fn(|q| by_age.iter().zip(w).map(|(n, w)| n * w[q]).sum())
+}
+
+fn line(v: &[f64]) -> String {
+    let parts: Vec<String> = v.iter().map(|x| format!("{x:.6e}")).collect();
+    parts.join(" ")
+}
+
+/// `LATERAL_PRESET` at its own age, the full cycle, on each of
+/// `LATERAL_SEEDS`: the fine ages (`FINE`), and per lateral its record
+/// (`REC`): age, span, first light (-1 where it grew no unit), bearer's
+/// light, order, bearer's age, shed, apex lived; then grown phytomers,
+/// leaf, section, wood and last-cycle phytomers; standing phytomers,
+/// last-cycle leaf, section, wood and last-cycle phytomers; the
+/// potential's phytomers, leaf, section and wood (-1 where refused).
+#[test]
+#[ignore = "a measurement: fn-335 R2, R3"]
+fn lateral_records() {
+    let id = std::env::var("LATERAL_PRESET").expect("a preset");
+    let seeds = std::env::var("LATERAL_SEEDS").expect("seeds");
+    let mut f = by_identity(&id).expect("a preset");
+    f.fidelity = 0.0;
+    for seed in seeds.split(',').map(|s| s.parse::<u32>().expect("a seed")) {
+        f.skeleton.seed = seed;
+        let g = executor::growth(&f).expect("its growth");
+        let (species, request) = (&g.species, g.request);
+        let fine: Vec<String> = (factors(species).iter().enumerate())
+            .map(|(k, (borne, s))| format!("{k}:{borne:.4}:{s:.4}"))
+            .collect();
+        println!("FINE {id} {seed} age {} {}", request.age, fine.join(" "));
+        let w = weights(species);
+        let mut potential: HashMap<(usize, u32), [f64; 4]> = HashMap::new();
+        for l in grow_laterals(species, request).expect("records") {
+            let span = request.age - l.birth;
+            let pot = *potential.entry((l.pa, span)).or_insert_with(|| {
+                match expected_bud_counts(species, l.pa, span) {
+                    Ok(t) => weighed(&(0..t.pas).map(|pa| t.total(pa)).collect::<Vec<_>>(), &w),
+                    Err(_) => [-1.0; 4],
+                }
+            });
+            let grown = weighed(&l.count, &w);
+            let standing = weighed(&l.standing, &w);
+            let lived = l.apex_end.map_or(span, |e| e - l.birth);
+            let head = [
+                l.pa as f64,
+                f64::from(span),
+                l.light.unwrap_or(-1.0),
+                l.bearer_light,
+                f64::from(l.order),
+                l.bearer_pa as f64,
+                f64::from(u8::from(l.shed)),
+                f64::from(lived),
+            ];
+            let values = [
+                grown[0],
+                grown[1],
+                grown[2],
+                grown[3],
+                l.count_last.iter().sum(),
+                standing[0],
+                weighed(&l.standing_last, &w)[1],
+                standing[2],
+                standing[3],
+                l.standing_last.iter().sum(),
+            ];
+            println!("REC {} {} {}", line(&head), line(&values), line(&pot));
+        }
+    }
+}
