diff --git i/crates/telperion-core/src/probe_marks.rs w/crates/telperion-core/src/probe_marks.rs
new file mode 100644
index 00000000..5641f375
--- /dev/null
+++ w/crates/telperion-core/src/probe_marks.rs
@@ -0,0 +1,26 @@
+//! fn-212 task 1 scratch probe, never committed: wall-clock marks between
+//! the preparation's stages, each with the process's peak resident memory.
+use std::sync::Mutex;
+use std::time::Instant;
+static LAST: Mutex<Option<Instant>> = Mutex::new(None);
+pub static MARKS: Mutex<Vec<(&'static str, f64, u64)>> = Mutex::new(Vec::new());
+fn hwm() -> u64 {
+    std::fs::read_to_string("/proc/self/status").ok().and_then(|s| {
+        let l = s.lines().find(|l| l.starts_with("VmHWM:"))?.to_owned();
+        l.split_whitespace().nth(1)?.parse::<u64>().ok()
+    }).map_or(0, |kb| kb / 1024)
+}
+/// Starts the clock at settled geometry and resets the peak resident memory.
+pub fn start() {
+    let _ = std::fs::write("/proc/self/clear_refs", "5");
+    MARKS.lock().unwrap().clear();
+    *LAST.lock().unwrap() = Some(Instant::now());
+}
+pub fn mark(name: &'static str) {
+    let now = Instant::now();
+    let mut last = LAST.lock().unwrap();
+    if let Some(t) = *last {
+        MARKS.lock().unwrap().push((name, (now - t).as_secs_f64() * 1e3, hwm()));
+        *last = Some(now);
+    }
+}
