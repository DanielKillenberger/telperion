+//! fn-212 task 1 scratch probe, never committed: the share of a tree's
+//! kept phytomers in each place of the realized executor's final routing.
+use super::request;
+use crate::closed_form::predictor::Predictor;
+use crate::fine::expansion::settle_with;
+use crate::fine::realized::Cpu;
+use crate::fine::Plan;
+use crate::grow::alone::rules;
+use crate::{beech, spruce};
+
+#[test]
+#[ignore]
+fn share() {
+    for (name, species) in [("beech", beech()), ("spruce", spruce())] {
+        for age in [40, 80] {
+            for seed in [1, 7] {
+                let request = request(age, seed);
+                let rules = rules(&species, age, request.budget).expect("rules");
+                let predictor = Predictor::new(&species, &rules.windows, age);
+                let plan = Plan::default();
+                let mut cpu = Cpu {
+                    species: &species,
+                    rules: &rules,
+                    plan,
+                    threads: crate::cores::available(),
+                    roots: Vec::new(),
+                };
+                let (settled, seeds) = settle_with(
+                    &species,
+                    (request, &predictor, &rules),
+                    plan,
+                    &mut cpu,
+                    true,
+                )
+                .expect("settles");
+                let stand: std::collections::HashSet<usize> =
+                    settled.at.iter().flatten().copied().collect();
+                let above: usize = settled
+                    .structure
+                    .axes
+                    .iter()
+                    .enumerate()
+                    .filter(|(i, _)| !stand.contains(i))
+                    .map(|(_, a)| a.phytomers.len())
+                    .sum();
+                let stand_ph: usize = stand
+                    .iter()
+                    .map(|&i| settled.structure.axes[i].phytomers.len())
+                    .sum();
+                let fine: usize = settled.live.iter().map(|&k| cpu.roots[k].phytomers()).sum();
+                let landed: usize = settled.landed.iter().map(|(_, r)| r.phytomers()).sum();
+                let total = above + fine;
+                println!(
+                    "SHARE {name} {age} {seed}: seeds {} live {} grounded {} | kept {total} above {above} ({:.2}%) stand-in phytomers {stand_ph} | fine {fine} ({:.2}%) of it landed on the CPU {landed} ({:.2}%) | device {} ({:.2}%)",
+                    seeds.len(),
+                    settled.live.len(),
+                    settled.grounded.len(),
+                    100.0 * above as f64 / total as f64,
+                    100.0 * fine as f64 / total as f64,
+                    100.0 * landed as f64 / total as f64,
+                    fine - landed,
+                    100.0 * (fine - landed) as f64 / total as f64,
+                );
+            }
+        }
+    }
+}
