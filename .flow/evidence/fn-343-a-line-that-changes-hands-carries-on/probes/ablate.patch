+/// fn-343 probe: the trunk's diameter in cm at 1.3 m, along the thickest
+/// wood from the root.
+fn trunk_cm(tree: &telperion_core::tree::Tree) -> f64 {
+    let n = tree.nodes.len();
+    let mut kids = vec![Vec::new(); n];
+    for (i, node) in tree.nodes.iter().enumerate().skip(1) {
+        kids[node.parent.unwrap() as usize].push(i);
+    }
+    let y0 = tree.nodes[0].position.y;
+    let mut at = 0;
+    while tree.nodes[at].position.y - y0 < 1.3 {
+        let Some(&next) = kids[at].iter().max_by(|&&a, &&b| tree.nodes[a].radius.total_cmp(&tree.nodes[b].radius)) else {
+            break;
+        };
+        at = next;
+    }
+    200.0 * tree.nodes[at].radius
+}
