+
+/// fn-343 probe (evidence only, never merged): one cause switched off by
+/// `ABLATE`, a set of letters: B no apex abortion on limb (6) and bough
+/// (7); C no wander; D no sag; E branch (9) and twig (13) insertion
+/// halved; F the branch's life past the run, so it never moves on.
+fn ablate(species: &mut Species) {
+    let set = std::env::var("ABLATE").unwrap_or_default();
+    let s = &mut species.states;
+    for c in set.chars() {
+        match c {
+            'B' => (s[6].abortion, s[7].abortion) = (0.0, 0.0),
+            'C' => s.iter_mut().for_each(|p| p.form.wander = 0.0),
+            'D' => s.iter_mut().for_each(|p| p.form.sag = 0.0),
+            'E' => (s[9].insertion, s[13].insertion) = (0.5 * s[9].insertion, 0.5 * s[13].insertion),
+            'F' => s[9].lifespan = 1000.0,
+            _ => panic!("ABLATE: no variant {c}"),
+        }
+    }
+    if !set.is_empty() {
+        eprintln!(
+            "ABLATE {set}: abortion {} {} wander9 {} sag6 {} insertion {} {} life9 {}",
+            s[6].abortion, s[7].abortion, s[9].form.wander, s[6].form.sag, s[9].insertion, s[13].insertion, s[9].lifespan
+        );
+    }
+}
