+/// fn-324's probe: the leaf area standing at `year`, by each age's own leaf years.
+pub fn bearing_area(species: &Species, axes: &[Axis], year: u32) -> f64 {
+    let mut sum = 0.0;
+    for a in axes {
+        let s = &species.states[a.pa];
+        for p in a.phytomers.iter().filter(|p| f64::from(p.cycle) + s.leaf_years > f64::from(year)) {
+            sum += leaf_area(p.scale, p.size, s.leaf_area);
+        }
+    }
+    sum
+}
