@@ -107,5 +107,35 @@ fn fragment(in: Varying, @builtin(front_facing) front: bool) -> @location(0) vec
         let half_way = normalize(normalize(u.eye.xyz - in.world) + u.sun_direction.xyz);
         cuticle = gloss * pow(max(dot(n, half_way), 0.0), exp2(3.0 + 5.0 * gloss));
     }
+    let mode = i32(u.leaf_colour_detail.w + 0.5);
+    if (mode > 0) {
+        let to_eye = normalize(u.eye.xyz - in.world);
+        let geometric = normalize(cross(dpdx(in.world), dpdy(in.world)));
+        let facing = select(-geometric, geometric, dot(geometric, to_eye) > 0.0);
+        let l = u.sun_direction.xyz;
+        var v = vec3<f32>(0.0);
+        switch mode {
+            case 1: { v = vec3<f32>(1.0, 0.0, 1.0); }
+            case 2: { v = colour; }
+            case 3: { v = colour * u.sun.rgb * max(dot(n, l), 0.0) / 4.0; }
+            case 4: { v = colour * direct / 4.0; }
+            case 5: { v = colour * ambient(n) / 4.0; }
+            case 6: { v = colour * shaded / 4.0; }
+            case 7: { v = through / 4.0; }
+            case 8: { v = direct * cuticle / 4.0; }
+            case 9: { v = vec3<f32>(visibility); }
+            case 10: { v = vec3<f32>(max(dot(n, l), 0.0)); }
+            case 11: { v = vec3<f32>(select(0.0, 1.0, front)); }
+            case 12: { v = vec3<f32>(in.leaf.z); }
+            case 13: { v = vec3<f32>(0.5 + 0.5 * dot(n, to_eye)); }
+            case 14: { v = (colour * (shaded + direct) + through + direct * cuticle) / 4.0; }
+            case 15: { v = vec3<f32>(0.5 + 0.5 * dot(n, facing)); }
+            case 16: { v = vec3<f32>(0.5 + 0.5 * dot(facing, l)); }
+            case 17: { v = u.sun.rgb * u.transmission.rgb * visibility * max(dot(-n, l), 0.0) / 4.0; }
+            case 18: { v = vec3<f32>(sunlight(in.world, select(-facing, facing, dot(facing, l) > 0.0))); }
+            default: { v = tone(colour * (shaded + direct) + through + direct * cuticle); }
+        }
+        return vec4<f32>(v, 1.0);
+    }
     return vec4<f32>(tone(colour * (shaded + direct) + through + direct * cuticle), 1.0);
 }
