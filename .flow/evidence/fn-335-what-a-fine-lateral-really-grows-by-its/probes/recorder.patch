+//! fn-335: every lateral a preset's full cycle grows, its light at birth
+//! and what its subtree really grew, beside the tables' potential for a
+//! bud of its age over the same span. A measurement, ignored: it prints
+//! lines for `probes/` in the spec's evidence to read.
+use super::executor;
+use crate::presets::by_identity;
+use std::collections::BTreeMap;
+use telperion_space::{expected_bud_counts, grow_laterals};
+
+fn csv(v: &[f64]) -> String {
+    let parts: Vec<String> = v.iter().map(|x| format!("{x}")).collect();
+    parts.join(",")
+}
+
+fn or_none<T: std::fmt::Display>(v: Option<T>) -> String {
+    v.map_or("none".into(), |x| x.to_string())
+}
+
+/// `LATERAL_PRESET` at its own age, the full cycle, on each of
+/// `LATERAL_SEEDS`: per age its weights (`WEIGHTS`), per age and span the
+/// potential (`POT`), and per lateral its record (`REC`); a span the
+/// tables refuse is printed as `NOPOT`.
+#[test]
+#[ignore = "a measurement: fn-335 R2"]
+fn lateral_records() {
+    let id = std::env::var("LATERAL_PRESET").expect("a preset");
+    let seeds = std::env::var("LATERAL_SEEDS").expect("seeds");
+    let mut f = by_identity(&id).expect("a preset");
+    f.fidelity = 0.0;
+    for seed in seeds.split(',').map(|s| s.parse::<u32>().expect("a seed")) {
+        f.skeleton.seed = seed;
+        let g = executor::growth(&f).expect("its growth");
+        let (species, request) = (&g.species, g.request);
+        println!("TREE {id} seed {seed} age {} pas {}", request.age, species.states.len());
+        for (pa, s) in species.states.iter().enumerate() {
+            let (pipe, exponent) = (s.form.pipe, s.form.exponent);
+            let (leaf, internode) = (s.leaf_area, s.internode);
+            println!("WEIGHTS {id} {pa} leaf {leaf} internode {internode} pipe {pipe} exponent {exponent}");
+        }
+        let records = grow_laterals(species, request).expect("records");
+        let mut potential = BTreeMap::new();
+        for l in &records {
+            let span = request.age - l.birth;
+            if potential.contains_key(&(l.pa, span)) {
+                continue;
+            }
+            let line = match expected_bud_counts(species, l.pa, span) {
+                Ok(t) => {
+                    let totals: Vec<f64> = (0..t.pas).map(|pa| t.total(pa)).collect();
+                    format!("POT {id} {seed} {} {span} {}", l.pa, csv(&totals))
+                }
+                Err(e) => format!("NOPOT {id} {seed} {} {span} {e}", l.pa),
+            };
+            println!("{line}");
+            potential.insert((l.pa, span), ());
+        }
+        for l in &records {
+            println!(
+                "REC {id} {seed} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {}",
+                l.lineage,
+                l.pa,
+                l.birth,
+                u8::from(l.woken),
+                l.bearer_pa,
+                l.node,
+                l.order,
+                or_none(l.light),
+                l.bearer_light,
+                or_none(l.apex_end),
+                or_none(l.last),
+                u8::from(l.shed),
+                request.age - l.birth,
+                csv(&l.count),
+                csv(&l.scale),
+            );
+        }
+    }
+}
