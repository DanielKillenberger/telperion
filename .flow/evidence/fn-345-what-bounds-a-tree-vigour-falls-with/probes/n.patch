diff --git i/crates/telperion-space/src/grow/cycle/probe.rs w/crates/telperion-space/src/grow/cycle/probe.rs
new file mode 100644
index 000000000..4b6e5f9d5
--- /dev/null
+++ w/crates/telperion-space/src/grow/cycle/probe.rs
@@ -0,0 +1,80 @@
+//! fn-344 probe (evidence only, never merged): the year's census of the
+//! held phytomers (`probe_ablate::census`), and with `PROBE_YEAR` the
+//! stem line's height and its living limbs, as fn-342's record had them.
+use super::working::Working;
+use crate::grow::Grower;
+use crate::structure::Origin;
+
+pub(super) fn year(g: &Grower, w: &Working, cycle: u32, tips: &[(f32, f32)]) {
+    let held: u64 = g.axes.iter().map(|a| a.phytomers.len() as u64).sum();
+    crate::probe_ablate::census(cycle - 1, held);
+    let deaths = crate::probe_ablate::take();
+    if (cycle - 1) % 10 == 9 && std::env::var_os("PROBE_BALANCE").is_some() {
+        balance(g, w, cycle - 1, tips, deaths);
+    }
+    if std::env::var_os("PROBE_YEAR").is_none() {
+        return;
+    }
+    let n = w.open.len().min(g.axes.len());
+    let z0 = g.axes[0].base.z;
+    let mut main = vec![false; n];
+    let (mut top, mut main_top) = (f64::MIN, f64::MIN);
+    for i in 0..n {
+        let a = &g.axes[i];
+        main[i] = match a.origin {
+            Origin::Seed => true,
+            Origin::Continuation { parent } | Origin::Relay { parent, .. } => main[parent],
+            Origin::Lateral { .. } => false,
+        };
+        for p in &a.phytomers {
+            top = top.max(p.tip.z - z0);
+            if main[i] {
+                main_top = main_top.max(p.tip.z - z0);
+            }
+        }
+    }
+    let (mut living, mut lowest) = (0usize, f64::NAN);
+    for i in 0..n {
+        let a = &g.axes[i];
+        let Origin::Lateral { parent, .. } = a.origin else { continue };
+        if !main[parent] || a.pa != 6 || !(w.open[i] && w.living[i]) {
+            continue;
+        }
+        living += 1;
+        let base = a.base.z - z0;
+        lowest = if lowest.is_nan() { base } else { lowest.min(base) };
+    }
+    println!(
+        "YEAR {} held={held} height={top:.3} stem_top={main_top:.3} apexes={} limbs_live={living} lowest_limb={lowest:.3}",
+        cycle - 1,
+        g.live.len()
+    );
+}
+
+/// fn-344 probe: the year's balance over the whole tree, from the
+/// balance pass's own numbers (`balance_one`, `Working::totals`).
+fn balance(g: &Grower, w: &Working, year: u32, tips: &[(f32, f32)], deaths: [u64; 4]) {
+    let income = w.light[0];
+    let charged = w.cost[0];
+    let (live, dead) = crate::probe_ablate::upkept();
+    let mut q: Vec<f32> = tips.iter().map(|t| t.0).collect();
+    q.sort_by(f32::total_cmp);
+    let mean = q.iter().map(|&v| f64::from(v)).sum::<f64>() / q.len().max(1) as f64;
+    let median = q.get(q.len() / 2).copied().unwrap_or(f32::NAN);
+    let negative = tips.iter().filter(|t| t.1 < 0.0).count() as f64 / tips.len().max(1) as f64;
+    let (mut lo, mut hi) = ([f64::MAX; 2], [f64::MIN; 2]);
+    let mut cells = std::collections::HashSet::new();
+    for p in g.axes.iter().flat_map(|a| &a.phytomers) {
+        let (x, y) = (p.tip.x, p.tip.y);
+        lo = [lo[0].min(x), lo[1].min(y)];
+        hi = [hi[0].max(x), hi[1].max(y)];
+        cells.insert((x.floor() as i64, y.floor() as i64));
+    }
+    println!(
+        "BAL {year} income={income:.1} charged={charged:.1} upkeep_live={live:.1} upkeep_dead={dead:.1} \
+         tips={} q_mean={mean:.4} q_median={median:.4} negative={negative:.4} leaves={} \
+         spread_x={:.2} spread_y={:.2} cells_m2={} died_balance={} died_survival={} died_life={} aborted={}",
+        tips.len(), g.leaves.len(), hi[0] - lo[0], hi[1] - lo[1], cells.len(),
+        deaths[0], deaths[1], deaths[2], deaths[3]
+    );
+}
