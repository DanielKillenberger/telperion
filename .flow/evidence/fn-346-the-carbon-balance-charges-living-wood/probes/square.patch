+/// fn-346 old-tree probe, each cycle: every limb (PA 6) and bough (PA 7)
+/// line, headed by its lateral and carried on by its relays and
+/// continuations of the same row; the year's record of each living line,
+/// and each line that ended: shed by its own balance, shed with its
+/// bearer, or died out (its last apex's cause). Every 20 years the tree's
+/// reach and its living tips by height band.
+fn oldtree(g: &Grower, w: &Working, cycle: u32) {
+    use std::collections::{HashMap, HashSet};
+    use std::sync::Mutex;
+    static LAST: Mutex<Option<(HashMap<u64, String>, HashMap<u64, u64>)>> = Mutex::new(None);
+    let year = cycle - 1;
+    let shed = crate::probe_ablate::walked();
+    let sketch = g.sketch.as_ref().expect("sketching");
+    let n = w.open.len().min(g.axes.len()).min(sketch.pencils.len());
+    let m = w.list.len();
+    let z0 = g.axes[0].base.z;
+    // Each open axis's line head (index), and the stem line.
+    let mut head = vec![usize::MAX; n];
+    let mut main = vec![false; n];
+    for i in 0..n {
+        let a = &g.axes[i];
+        main[i] = match a.origin {
+            Origin::Seed => true,
+            Origin::Continuation { parent } | Origin::Relay { parent, .. } => parent < n && main[parent],
+            Origin::Lateral { .. } => false,
+        };
+        if !(a.pa == 6 || a.pa == 7) {
+            continue;
+        }
+        head[i] = match a.origin {
+            Origin::Continuation { parent } | Origin::Relay { parent, .. }
+                if parent < n && g.axes[parent].pa == a.pa && head[parent] != usize::MAX && !main[i] =>
+            {
+                head[parent]
+            }
+            Origin::Lateral { .. } => i,
+            _ => usize::MAX,
+        };
+    }
+    // Subtree living tips and longest tip path, over the open list.
+    let mut lit: HashSet<usize> = g.live.iter().map(|a| a.axis).filter(|&i| i < n).collect();
+    lit.extend(crate::probe_ablate::take_shed_axes().into_iter().filter(|&i| i < n));
+    let mut tips = vec![0u32; m];
+    let mut far = vec![0.0f32; m];
+    for k in (0..m).rev() {
+        let i = w.list[k];
+        if lit.contains(&i) {
+            tips[k] += 1;
+            far[k] = far[k].max(sketch.pencils[i].layer.path_end());
+        }
+        if let Some(p) = w.links[i].parent {
+            if w.open[p] {
+                let kp = w.at[p] as usize;
+                tips[kp] += tips[k];
+                far[kp] = far[kp].max(far[k]);
+            }
+        }
+    }
+    // Each head's own boughs (limb) or branches (bough) above zero.
+    let mut kids: HashMap<usize, (u32, u32)> = HashMap::new();
+    let mut tip_axis: HashMap<usize, usize> = HashMap::new();
+    for k in 0..m {
+        let i = w.list[k];
+        if i >= n || !w.living[i] {
+            continue;
+        }
+        let a = &g.axes[i];
+        if head[i] != usize::MAX && (lit.contains(&i) || !tip_axis.contains_key(&head[i])) {
+            tip_axis.insert(head[i], i);
+        }
+        let Origin::Lateral { parent, .. } = a.origin else { continue };
+        if parent >= n || head[parent] == usize::MAX {
+            continue;
+        }
+        let h = head[parent];
+        let want = if g.axes[h].pa == 6 { 7 } else { 9 };
+        if a.pa != want {
+            continue;
+        }
+        let (q, c) = (w.light[i], w.cost[i]);
+        let e = kids.entry(h).or_default();
+        e.0 += 1;
+        e.1 += u32::from(q - c > 0.0);
+    }
+    let line_of = |i: usize| -> Option<u64> {
+        if main[i] {
+            Some(0)
+        } else if head[i] != usize::MAX {
+            Some(g.axes[head[i]].lineage)
+        } else {
+            None
+        }
+    };
+    *crate::probe_ablate::LINE_OF.lock().unwrap() = (0..n).map(|i| line_of(i).unwrap_or(u64::MAX)).collect();
+    let mut bearer_line: HashMap<u64, u64> = HashMap::new();
+    for i in 0..n {
+        if head[i] == i {
+            if let Origin::Lateral { parent, .. } = g.axes[i].origin {
+                if let Some(l) = line_of(parent) {
+                    bearer_line.insert(g.axes[i].lineage, l);
+                }
+            }
+        }
+    }
+    static BEARERS: Mutex<Option<HashMap<u64, u64>>> = Mutex::new(None);
+    let mut bearers = BEARERS.lock().unwrap();
+    let known = bearers.get_or_insert_with(HashMap::new);
+    known.extend(bearer_line);
+    let mut now: HashMap<u64, String> = HashMap::new();
+    let mut tipl: HashMap<u64, u64> = HashMap::new();
+    let mut ended = Vec::new();
+    for k in 0..m {
+        let i = w.list[k];
+        if i >= n || head[i] != i || !w.living[i] {
+            continue;
+        }
+        let a = &g.axes[i];
+        let p = &sketch.pencils[i];
+        let base = p.layer.base_path();
+        let (q, c) = (w.light[i], w.cost[i]);
+        let (nk, pos) = kids.get(&i).copied().unwrap_or((0, 0));
+        let rec = format!(
+            "pa={} birth={} main_bearer={} base_path={base:.2} base_z={:.2} memory={:.4} light={q:.2} charge={c:.2} \
+             length={:.2} tip_path={:.2} tips={} kids={nk} kids_paying={pos}",
+            a.pa,
+            a.birth,
+            match a.origin { Origin::Lateral { parent, .. } => u8::from(parent < n && main[parent]), _ => 0 },
+            a.base.z - z0,
+            p.memory,
+            far[k] - base,
+            far[k],
+            tips[k]
+        );
+        let own = shed.get(k).copied().unwrap_or(false);
+        if own {
+            let parent_shed = w.links[i].parent.is_some_and(|pp| w.open[pp] && shed.get(w.at[pp] as usize).copied().unwrap_or(false));
+            ended.push((a.lineage, if parent_shed { "with_bearer" } else { "balance" }.to_string(), rec.clone(), base, a.pa));
+        } else {
+            now.insert(a.lineage, rec);
+            if let Some(&t) = tip_axis.get(&i) {
+                tipl.insert(a.lineage, g.axes[t].lineage);
+            }
+        }
+    }
+    let mut last = LAST.lock().unwrap();
+    let (prev, prev_tip) = last.take().unwrap_or_default();
+    let shed_now: HashSet<u64> = ended.iter().map(|e| e.0).collect();
+    for (lineage, rec) in &prev {
+        if !now.contains_key(lineage) && !shed_now.contains(lineage) {
+            let cause = prev_tip.get(lineage).and_then(|&t| crate::probe_ablate::cause_of(t));
+            let why = match cause {
+                Some(1) => "died_survival",
+                Some(2) => "died_end_of_row",
+                Some(3) => "died_abortion",
+                _ => "died_out",
+            };
+            let base: f32 = rec.split("base_path=").nth(1).and_then(|s| s.split(' ').next()).and_then(|s| s.parse().ok()).unwrap_or(f32::NAN);
+            let pa: usize = if rec.starts_with("pa=6") { 6 } else { 7 };
+            ended.push((*lineage, why.to_string(), rec.clone(), base, pa));
+        }
+    }
+    let sleepers_on_stem: usize = (g.asleep.iter().skip(cycle as usize))
+        .flat_map(|v| v.iter())
+        .filter(|s| s.parent < n && main[s.parent])
+        .count();
+    for (lineage, why, rec, base, pa) in ended {
+        println!("LINEEND {year} lineage={lineage} cause={why} {rec} stem_sleepers={sleepers_on_stem}");
+        if pa == 6 {
+            crate::probe_ablate::LOSSES.lock().unwrap().push(crate::probe_ablate::Loss {
+                year,
+                lineage,
+                base,
+                bearer: known.get(&lineage).copied().unwrap_or(u64::MAX),
+                births: [0; 3],
+            });
+        }
+    }
+    *last = Some((now, tipl));
+    if year % 10 == 9 || year + 1 == g.rules.age {
+        let mut bands = std::collections::BTreeMap::<i32, u32>::new();
+        let mut longest = 0.0f32;
+        for apex in g.live.iter().filter(|a| a.axis < n) {
+            let a = &g.axes[apex.axis];
+            let z = a.phytomers.last().map_or(a.base.z, |p| p.tip.z) - z0;
+            *bands.entry((z / 5.0).floor() as i32).or_default() += 1;
+            longest = longest.max(sketch.pencils[apex.axis].layer.path_end());
+        }
+        let total: u32 = bands.values().sum();
+        let s: Vec<String> = bands.iter().map(|(b, c)| format!("{}:{:.3}", b * 5, *c as f64 / total.max(1) as f64)).collect();
+        println!("REACH {year} longest_path={longest:.2} tips={total} bands={}", s.join(","));
+        let fin = year + 1 == g.rules.age;
+        for l in crate::probe_ablate::LOSSES.lock().unwrap().iter().filter(|_| fin) {
+            println!("LOSS lost={} lineage={} base_path={:.2} bearer_stem={} births20_limb={} bough={} branch={}", l.year, l.lineage, l.base, u8::from(l.bearer == 0), l.births[0], l.births[1], l.births[2]);
+        }
+    }
+}
