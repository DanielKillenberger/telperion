+/// fn-344 probe H: an axis's path from the root collar at its base, from
+/// its bearer's walk (`of`): at the node a lateral or relay stands on, or
+/// the bearer's end for a continuation.
+pub(crate) fn base_path<'a>(axis: &Axis, of: &dyn Fn(usize) -> &'a Layer) -> f32 {
+    if !(crate::probe_ablate::on('H') || crate::probe_ablate::on('P') || crate::probe_ablate::on('L')) {
+        return 0.0;
+    }
+    match axis.origin {
+        crate::structure::Origin::Seed => 0.0,
+        crate::structure::Origin::Lateral { parent, node, .. } => of(parent).path_at(node),
+        crate::structure::Origin::Relay { parent, node, .. } => of(parent).path_at(node),
+        crate::structure::Origin::Continuation { parent } => of(parent).path_end(),
+    }
+}
