+
+/// fn-344 probe (evidence only, never merged): the old oak's causes
+/// switched off by `ABLATE`, a set of letters. The preset values set
+/// here: D the leader's (PA 4) life past the run, so the trunk stays a
+/// leader; E sleeping buds on the trunk (2), fork (3) and leader (4) rows,
+/// as the limb row's (p 0.1, delay 6, rate 0.04) but waking as limbs (6).
+/// B, C and E's stem-line limbs are switched in the grower
+/// (`telperion-space` `probe_ablate`); F is B, C and E.
+fn ablate(species: &mut Species) {
+    let set = std::env::var("ABLATE").unwrap_or_default();
+    let s = &mut species.states;
+    // The rows' lifespans as the preset states them, before any letter.
+    let life: Vec<f64> = s.iter().map(|r| r.lifespan).collect();
+    for c in set.chars() {
+        match c {
+            'B' | 'C' | 'H' | 'L' | 'M' | 'P' | 'R' | 'U' => {}
+            // fn-346 rule B's preset part: sleeping buds on the limb (6),
+            // bough (7) and branch (9) rows, at the oak limb row's values
+            // (0.1 a place, delay 6, rate 0.04), each holding the row its
+            // medial zone's longest-lived lateral is (the oak limb's own
+            // sleeping bud, a branch, is that row); a zone that already
+            // holds sleeping buds keeps them. The waking is the grower's.
+            'S' => {
+                for pa in [6, 7, 9] {
+                    if s[pa].lifespan <= 0.0 {
+                        continue;
+                    }
+                    let medial = &s[pa].zones[s[pa].zones.len().min(2) - 1].lateral;
+                    let row = (0..medial.len())
+                        .filter(|&r| medial[r] > 0.0)
+                        .max_by(|&a, &b| life[a].total_cmp(&life[b]));
+                    let Some(row) = row else { continue };
+                    for zone in &mut s[pa].zones {
+                        if zone.dormant.iter().all(|&d| d == 0.0) {
+                            zone.dormant[row] = 0.1;
+                            (zone.delay, zone.rate) = (6.0, 0.04);
+                        }
+                    }
+                    eprintln!("RENEW S: row {pa} sleeping {:?}", s[pa].zones.iter().map(|z| (z.dormant.iter().position(|&d| d > 0.0), z.rate)).collect::<Vec<_>>());
+                }
+            }
+            'D' => s[4].lifespan = 1000.0,
+            'E' => {
+                for pa in [2, 3, 4] {
+                    for zone in &mut s[pa].zones {
+                        zone.dormant[6] = 0.1;
+                        (zone.delay, zone.rate) = (6.0, 0.04);
+                    }
+                }
+            }
+            _ => panic!("ABLATE: no variant {c}"),
+        }
+    }
+    if !set.is_empty() {
+        eprintln!(
+            "ABLATE {set}: leader life {} trunk/fork/leader sleeping limbs {:?}",
+            s[4].lifespan,
+            [2, 3, 4].map(|pa| s[pa].zones.iter().map(|z| z.dormant[6]).fold(0.0, f64::max))
+        );
+    }
+}
