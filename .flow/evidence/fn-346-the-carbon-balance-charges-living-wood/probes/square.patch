+/// fn-344 probe: the year's balance over the whole tree, from the
+/// balance pass's own numbers (`balance_one`, `Working::totals`).
+fn balance(g: &Grower, w: &Working, year: u32, tips: &[(f32, f32)], deaths: [u64; 4]) {
+    let income = w.light[0];
+    let charged = w.cost[0];
+    let (live, dead) = crate::probe_ablate::upkept();
+    let mut q: Vec<f32> = tips.iter().map(|t| t.0).collect();
+    q.sort_by(f32::total_cmp);
+    let mean = q.iter().map(|&v| f64::from(v)).sum::<f64>() / q.len().max(1) as f64;
+    let median = q.get(q.len() / 2).copied().unwrap_or(f32::NAN);
+    let negative = tips.iter().filter(|t| t.1 < 0.0).count() as f64 / tips.len().max(1) as f64;
+    let (mut lo, mut hi) = ([f64::MAX; 2], [f64::MIN; 2]);
+    let mut cells = std::collections::HashSet::new();
+    for p in g.axes.iter().flat_map(|a| &a.phytomers) {
+        let (x, y) = (p.tip.x, p.tip.y);
+        lo = [lo[0].min(x), lo[1].min(y)];
+        hi = [hi[0].max(x), hi[1].max(y)];
+        cells.insert((x.floor() as i64, y.floor() as i64));
+    }
+    println!(
+        "BAL {year} income={income:.1} charged={charged:.1} upkeep_live={live:.1} upkeep_dead={dead:.1} \
+         tips={} q_mean={mean:.4} q_median={median:.4} negative={negative:.4} leaves={} \
+         spread_x={:.2} spread_y={:.2} cells_m2={} died_balance={} died_survival={} died_life={} aborted={}",
+        tips.len(), g.leaves.len(), hi[0] - lo[0], hi[1] - lo[1], cells.len(),
+        deaths[0], deaths[1], deaths[2], deaths[3]
+    );
+}
+
+/// fn-346 probe (evidence only, never merged): every living tip's path
+/// from the root collar along the rough layout's wood, its height, its own
+/// light (as `balance_one` reads it), its presence and its axis's PA; and
+/// every living lateral standing on the main line with its base path,
+/// subtree light, today's cost and remembered balance. Written to
+/// `<dir>/tips-<year>.tsv` and `<dir>/limbs-<year>.tsv`.
+fn paths(g: &Grower, w: &Working, year: u32, dir: &std::path::Path) {
+    use std::io::Write;
+    let sketch = g.sketch.as_ref().expect("sketching");
+    let n = w.open.len().min(g.axes.len()).min(sketch.pencils.len());
+    let z0 = g.axes[0].base.z;
+    let dist = |a: crate::structure::Vec3, b: crate::structure::Vec3| {
+        ((a.x - b.x).powi(2) + (a.y - b.y).powi(2) + (a.z - b.z).powi(2)).sqrt()
+    };
+    // Cumulative path to the end of each phytomer of every open axis,
+    // parents first; its base path; main-line flag; limb it stands under.
+    let mut cum: Vec<Vec<f64>> = vec![Vec::new(); n];
+    let mut base = vec![f64::NAN; n];
+    let mut main = vec![false; n];
+    let mut limb = vec![-1i64; n];
+    for i in 0..n {
+        let a = &g.axes[i];
+        main[i] = match a.origin {
+            Origin::Seed => true,
+            Origin::Continuation { parent } | Origin::Relay { parent, .. } => parent < n && main[parent],
+            Origin::Lateral { .. } => false,
+        };
+        if !w.open[i] {
+            continue;
+        }
+        let at = |p: usize, node: Option<usize>| -> f64 {
+            let c = &cum[p];
+            match node {
+                Some(k) => c.get(k).or(c.last()).copied().unwrap_or(base[p]),
+                None => c.last().copied().unwrap_or(base[p]),
+            }
+        };
+        base[i] = match a.origin {
+            Origin::Seed => 0.0,
+            Origin::Lateral { parent, node, .. } => at(parent, Some(node)),
+            Origin::Relay { parent, node, .. } => at(parent, Some(node)),
+            Origin::Continuation { parent } => at(parent, None),
+        };
+        limb[i] = match a.origin {
+            Origin::Seed => -1,
+            Origin::Lateral { parent, .. } if main[parent] => i as i64,
+            Origin::Lateral { parent, .. }
+            | Origin::Continuation { parent }
+            | Origin::Relay { parent, .. } => limb[parent],
+        };
+        let mut l = base[i];
+        let mut prev = a.base;
+        let mut c = Vec::with_capacity(a.phytomers.len());
+        for p in &a.phytomers {
+            l += dist(p.tip, prev);
+            prev = p.tip;
+            c.push(l);
+        }
+        cum[i] = c;
+    }
+    let _ = std::fs::create_dir_all(dir);
+    let file = |name: String| {
+        std::io::BufWriter::new(std::fs::File::create(dir.join(name)).expect("probe file"))
+    };
+    let mut t = file(format!("tips-{year}.tsv"));
+    writeln!(t, "axis\tpa\tpath\theight\town\tpresence\tlight\tlimb\tmain").unwrap();
+    for apex in g.live.iter().filter(|a| a.axis < n) {
+        let i = apex.axis;
+        let p = &sketch.pencils[i];
+        let presence = p.base_scale * p.running;
+        let own = (p.base_scale as f32 * p.running as f32 * p.light as f32) as f64;
+        let a = &g.axes[i];
+        let (path, height) = match a.phytomers.last() {
+            Some(last) => (cum[i].last().copied().unwrap_or(base[i]), last.tip.z - z0),
+            None => (base[i], a.base.z - z0),
+        };
+        writeln!(
+            t,
+            "{i}\t{}\t{path:.4}\t{height:.4}\t{own:.6}\t{presence:.6}\t{:.6}\t{}\t{}",
+            a.pa, p.light, limb[i], main[i] as u8
+        )
+        .unwrap();
+    }
+    let mut m = file(format!("limbs-{year}.tsv"));
+    writeln!(m, "axis\tpa\tbirth\tbase_path\tbase_height\tlight\tcost\tmemory\twood").unwrap();
+    for i in 0..n {
+        let a = &g.axes[i];
+        let Origin::Lateral { parent, .. } = a.origin else { continue };
+        if !(main[parent] && w.open[i] && w.living[i]) {
+            continue;
+        }
+        let p = &sketch.pencils[i];
+        writeln!(
+            m,
+            "{i}\t{}\t{}\t{:.4}\t{:.4}\t{:.4}\t{:.4}\t{:.6}\t{:.4}",
+            a.pa, a.birth, base[i], a.base.z - z0, w.light[i], w.cost[i], p.memory, p.wood
+        )
+        .unwrap();
+    }
+    println!("PATHS {year} tips={} written", g.live.len());
+}
