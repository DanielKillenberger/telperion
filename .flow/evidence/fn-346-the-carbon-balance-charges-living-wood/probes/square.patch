+//! fn-344 probe (evidence only, never merged): the year's census of the
+//! held phytomers (`probe_ablate::census`), and with `PROBE_YEAR` the
+//! stem line's height and its living limbs, as fn-342's record had them.
+use super::working::Working;
+use crate::grow::Grower;
+use crate::structure::Origin;
+
+pub(super) fn year(g: &Grower, w: &Working, cycle: u32, tips: &[(f32, f32)]) {
+    let held: u64 = g.axes.iter().map(|a| a.phytomers.len() as u64).sum();
+    crate::probe_ablate::census(cycle - 1, held);
+    let deaths = crate::probe_ablate::take();
+    if (cycle - 1) % 10 == 9 && std::env::var_os("PROBE_BALANCE").is_some() {
+        balance(g, w, cycle - 1, tips, deaths);
+    }
+    if let Some(l) = crate::probe_ablate::take_shed_light() {
+        println!(
+            "SHEDLIGHT {} shed={} shed_mean={:.4} shed_median={:.4} living_mean={:.4} living_median={:.4}",
+            cycle - 2, l.0, l.1, l.2, l.3, l.4
+        );
+    }
+    if std::env::var_os("PROBE_OLDTREE").is_some() {
+        oldtree(g, w, cycle);
+    }
+    if (cycle - 1) % 10 == 9 && std::env::var_os("PROBE_RENEWAL").is_some() {
+        renewal(g, cycle);
+    }
+    if (cycle - 1) % 10 == 9 {
+        if let Some(dir) = std::env::var_os("PROBE_PATHS") {
+            paths(g, w, cycle - 1, std::path::Path::new(&dir));
+        }
+    }
+    if std::env::var_os("PROBE_YEAR").is_none() {
+        return;
+    }
+    let n = w.open.len().min(g.axes.len());
+    let z0 = g.axes[0].base.z;
+    let mut main = vec![false; n];
+    let (mut top, mut main_top) = (f64::MIN, f64::MIN);
+    for i in 0..n {
+        let a = &g.axes[i];
+        main[i] = match a.origin {
+            Origin::Seed => true,
+            Origin::Continuation { parent } | Origin::Relay { parent, .. } => main[parent],
+            Origin::Lateral { .. } => false,
+        };
+        for p in &a.phytomers {
+            top = top.max(p.tip.z - z0);
+            if main[i] {
+                main_top = main_top.max(p.tip.z - z0);
+            }
+        }
+    }
+    let (mut living, mut lowest) = (0usize, f64::NAN);
+    for i in 0..n {
+        let a = &g.axes[i];
+        let Origin::Lateral { parent, .. } = a.origin else { continue };
+        if !main[parent] || a.pa != 6 || !(w.open[i] && w.living[i]) {
+            continue;
+        }
+        living += 1;
+        let base = a.base.z - z0;
+        lowest = if lowest.is_nan() { base } else { lowest.min(base) };
+    }
+    println!(
+        "YEAR {} held={held} height={top:.3} stem_top={main_top:.3} apexes={} limbs_live={living} lowest_limb={lowest:.3}",
+        cycle - 1,
+        g.live.len()
+    );
+}
