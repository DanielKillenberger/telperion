+/// fn-346 renewal probe: the decade's births by source and deaths by cause,
+/// by row, path band and inside the crown; the living tips by row with the
+/// length and nodes their axis laid last cycle; the sleeping buds held.
+fn renewal(g: &Grower, cycle: u32) {
+    let year = cycle - 1;
+    let (births, deaths) = crate::probe_ablate::take_renewal();
+    for (name, map) in [("BIRTH", births), ("DEATH", deaths)] {
+        let mut rows: Vec<_> = map.into_iter().collect();
+        rows.sort();
+        for ((code, pa, band, inside), n) in rows {
+            println!("{name} {year} code={code} pa={pa} band={band} inside={} n={n}", inside as u8);
+        }
+    }
+    let dist = |a: crate::structure::Vec3, b: crate::structure::Vec3| {
+        ((a.x - b.x).powi(2) + (a.y - b.y).powi(2) + (a.z - b.z).powi(2)).sqrt()
+    };
+    let mut by: std::collections::BTreeMap<usize, (u64, f64, u64, u64, f64, u64)> = Default::default();
+    for apex in &g.live {
+        let a = &g.axes[apex.axis];
+        let e = by.entry(a.pa).or_default();
+        e.0 += 1;
+        for (at, (len, nodes)) in [(cycle - 1, (&mut e.1, &mut e.2)), (cycle, (&mut e.4, &mut e.5))] {
+            let mut prev = a.base;
+            for p in &a.phytomers {
+                if p.cycle == at {
+                    *len += dist(p.tip, prev);
+                    *nodes += 1;
+                }
+                prev = p.tip;
+            }
+        }
+        if a.phytomers.is_empty() {
+            e.3 += 1;
+        }
+    }
+    for (pa, (n, len1, nodes1, bare, len0, nodes0)) in by {
+        println!(
+            "LIVING {year} pa={pa} tips={n} ext_prev={:.4} nodes_prev={:.3} ext_now={:.4} nodes_now={:.3} no_phytomer={bare}",
+            len1 / n as f64, nodes1 as f64 / n as f64, len0 / n as f64, nodes0 as f64 / n as f64
+        );
+    }
+    let held: usize = g.asleep.iter().skip(cycle as usize).map(|v| v.len()).sum();
+    let [unlit, woke, gone] = crate::probe_ablate::take_sleepers();
+    println!("ASLEEP {year} held={held} woke_by_light={woke} let_go={gone} no_light_read={unlit}");
+}
