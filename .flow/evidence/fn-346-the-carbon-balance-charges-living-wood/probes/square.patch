+/// fn-343 probe: the trunk's diameter in cm at 1.3 m, along the thickest
+/// wood from the root.
+fn trunk_cm(tree: &telperion_core::tree::Tree) -> f64 {
+    let n = tree.nodes.len();
+    let mut kids = vec![Vec::new(); n];
+    for (i, node) in tree.nodes.iter().enumerate().skip(1) {
+        kids[node.parent.unwrap() as usize].push(i);
+    }
+    let y0 = tree.nodes[0].position.y;
+    let mut at = 0;
+    while tree.nodes[at].position.y - y0 < 1.3 {
+        let Some(&next) = kids[at].iter().max_by(|&&a, &&b| tree.nodes[a].radius.total_cmp(&tree.nodes[b].radius)) else {
+            break;
+        };
+        at = next;
+    }
+    200.0 * tree.nodes[at].radius
+}
+
+/// fn-344 probe: the lower trunk's mid view, aimed at a quarter of the
+/// height from 0.9 of the height away on the hero's side.
+fn bole(bounds: &Bounds, hero: &Camera) -> Camera {
+    let toward = Vec3::new(hero.position.x, 0.0, hero.position.z);
+    let toward = toward * (1.0 / toward.length().max(1e-9));
+    let height = bounds.max.y - bounds.min.y;
+    let target = Vec3::new(0.0, 0.25 * height, 0.0);
+    Camera {
+        position: target + toward * (0.9 * height) + Vec3::new(0.0, 0.5, 0.0),
+        target,
+        field_of_view: 38.0,
+        near: 0.05,
+        far: 500.0,
+    }
+}
