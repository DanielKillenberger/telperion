@@ -0,0 +1,433 @@
+//! fn-344 probe (evidence only, never merged): the old oak's causes
+//! switched off one at a time by the letters in `ABLATE`, and a yearly
+//! census of the held phytomers that stops a grow passing four times
+//! today's count (`ABLATE_CURVE`, lines `year held`) or 8 GiB resident.
+//! Dormant unless the variables are set.
+use std::collections::{HashMap, HashSet};
+use std::sync::{Mutex, OnceLock};
+
+fn letters() -> &'static str {
+    static SET: OnceLock<String> = OnceLock::new();
+    SET.get_or_init(|| std::env::var("ABLATE").unwrap_or_default())
+}
+
+/// Whether variant letter `c` is on.
+pub(crate) fn on(c: char) -> bool {
+    letters().contains(c)
+}
+
+static STEM: Mutex<Option<HashSet<u64>>> = Mutex::new(None);
+
+/// Marks `child` as on the stem line when its bearer is.
+pub(crate) fn carry(bearer_seed: bool, bearer: u64, child: u64) {
+    let mut g = STEM.lock().unwrap();
+    let set = g.get_or_insert_with(HashSet::new);
+    if bearer_seed || set.contains(&bearer) {
+        set.insert(child);
+    }
+}
+
+/// Whether the axis of lineage `key` is on the stem line above the seed.
+pub(crate) fn stem(key: u64) -> bool {
+    STEM.lock().unwrap().as_ref().is_some_and(|s| s.contains(&key))
+}
+
+fn curve() -> &'static HashMap<u32, u64> {
+    static CURVE: OnceLock<HashMap<u32, u64>> = OnceLock::new();
+    CURVE.get_or_init(|| {
+        let path = std::env::var("ABLATE_CURVE").unwrap_or_default();
+        if path.is_empty() {
+            return HashMap::new();
+        }
+        let text = std::fs::read_to_string(&path).expect("ABLATE_CURVE readable");
+        text.lines()
+            .filter_map(|l| {
+                let mut w = l.split_whitespace();
+                Some((w.next()?.parse().ok()?, w.next()?.parse().ok()?))
+            })
+            .collect()
+    })
+}
+
+fn resident_gib() -> f64 {
+    let s = std::fs::read_to_string("/proc/self/statm").unwrap_or_default();
+    let pages: f64 = s.split_whitespace().nth(1).and_then(|p| p.parse().ok()).unwrap_or(0.0);
+    pages * 4096.0 / f64::from(1u32 << 30)
+}
+
+/// The year's census: printed when `ABLATE_CENSUS` is set; the process
+/// stops when `held` passes `ABLATE_FACTOR` (4 unset) times the curve's
+/// count at `year`, or the process holds `ABLATE_RSS_GIB` (8 unset).
+pub(crate) fn census(year: u32, held: u64) {
+    if std::env::var_os("ABLATE_CENSUS").is_none() {
+        return;
+    }
+    let num = |k: &str, d: f64| std::env::var(k).ok().and_then(|v| v.parse().ok()).unwrap_or(d);
+    let (factor, limit) = (num("ABLATE_FACTOR", 4.0), num("ABLATE_RSS_GIB", 8.0));
+    let rss = resident_gib();
+    println!("CENSUS {year} {held} rss_gib={rss:.2}");
+    let over = curve().get(&year).is_some_and(|&a| held as f64 > factor * a as f64);
+    // 8 GiB unset: dressing and drawing took the 120-year E from 6.6 to
+    // 9.1 GiB, so a grow ending past 8 would meet the 12 GB cap while drawn.
+    if over || rss > limit {
+        let a = curve().get(&year).copied().unwrap_or(0);
+        println!("STOP year={year} held={held} today={a} rss_gib={rss:.2}");
+        std::process::exit(42);
+    }
+}
+
+/// The settled tree's stem line: its living limbs (PA 6 laterals of the
+/// seed's line with a living apex in their subtree) and the lowest one's
+/// base, engine metres above the root.
+pub(crate) fn settled(s: &crate::structure::Structure) {
+    use crate::structure::Origin;
+    if std::env::var_os("ABLATE_CENSUS").is_none() {
+        return;
+    }
+    let n = s.axes.len();
+    let mut main = vec![false; n];
+    for i in 0..n {
+        main[i] = match s.axes[i].origin {
+            Origin::Seed => true,
+            Origin::Continuation { parent } | Origin::Relay { parent, .. } => main[parent],
+            Origin::Lateral { .. } => false,
+        };
+    }
+    let mut alive: Vec<bool> = s.axes.iter().map(|a| a.apex_end.is_none() && !a.phytomers.is_empty()).collect();
+    for i in (0..n).rev() {
+        if let Some(p) = s.axes[i].origin.parent() {
+            assert!(p < i, "parents come first");
+            if alive[i] {
+                alive[p] = true;
+            }
+        }
+    }
+    let z0 = s.axes[0].base.z;
+    let top = s.axes.iter().flat_map(|a| &a.phytomers).map(|p| p.tip.z - z0).fold(f64::MIN, f64::max);
+    let (mut living, mut lowest) = (0usize, f64::NAN);
+    for (i, a) in s.axes.iter().enumerate() {
+        let Origin::Lateral { parent, .. } = a.origin else { continue };
+        if main[parent] && a.pa == 6 && alive[i] {
+            living += 1;
+            let base = a.base.z - z0;
+            lowest = if lowest.is_nan() { base } else { lowest.min(base) };
+        }
+    }
+    println!("SETTLED top={top:.3} limbs_live={living} lowest_limb={lowest:.3} phytomers={}", s.phytomer_count());
+    if std::env::var_os("PROBE_SHAPE").is_some() {
+        shape(s, &main, &alive);
+    }
+    // A census run that is not drawn: done once the tree is settled, so a
+    // tree too big to dress is never dressed.
+    if std::env::var("ABLATE_GROW_ONLY").is_ok_and(|v| !v.is_empty()) {
+        println!("GROWN rss_gib={:.2}", resident_gib());
+        std::process::exit(0);
+    }
+}
+
+/// fn-344: tip deaths by cause since the last `take` (0 balance, 1
+/// survival draw, 2 life ended, 3 abortion), and the year's upkeep of the
+/// open wood and of the closed (dead) wood.
+static DEATHS: [std::sync::atomic::AtomicU64; 4] = [const { std::sync::atomic::AtomicU64::new(0) }; 4];
+static UPKEEP: Mutex<(f64, f64)> = Mutex::new((0.0, 0.0));
+
+pub(crate) fn tick(k: usize) {
+    DEATHS[k].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+}
+
+pub(crate) fn take() -> [u64; 4] {
+    std::array::from_fn(|k| DEATHS[k].swap(0, std::sync::atomic::Ordering::Relaxed))
+}
+
+pub(crate) fn upkeep(live: f64, dead: f64) {
+    *UPKEEP.lock().unwrap() = (live, dead);
+}
+
+pub(crate) fn upkept() -> (f64, f64) {
+    *UPKEEP.lock().unwrap()
+}
+
+/// fn-346 probe P: the species' path limit in metres (`PIPES_LMAX`, times
+/// `PIPES_LMAX_FACTOR`), where P is on and it is set; none leaves the
+/// rule dormant (today's charge, dead wood not charged).
+pub(crate) fn lmax() -> Option<f32> {
+    static L: OnceLock<Option<f32>> = OnceLock::new();
+    *L.get_or_init(|| {
+        if !on('P') {
+            return None;
+        }
+        let num = |k: &str| std::env::var(k).ok().and_then(|v| v.parse::<f32>().ok());
+        let m = num("PIPES_LMAX")?;
+        let m = m * num("PIPES_LMAX_FACTOR").unwrap_or(1.0);
+        eprintln!("PIPES lmax={m}");
+        Some(m)
+    })
+}
+
+/// fn-346 renewal probe: births by (source, row, band, inside) and deaths
+/// by (cause, row, band, inside), summed over a decade; the longest living
+/// path this cycle; shed places and the light read at them after.
+type Key4 = (u8, u8, i32, bool);
+static BIRTHS: Mutex<Option<HashMap<Key4, u64>>> = Mutex::new(None);
+static DEATHS_AT: Mutex<Option<HashMap<Key4, u64>>> = Mutex::new(None);
+static LONGEST: Mutex<f32> = Mutex::new(f32::INFINITY);
+static SHED: Mutex<Vec<crate::structure::Vec3>> = Mutex::new(Vec::new());
+static SHED_LIGHT: Mutex<Option<(usize, f64, f64, f64, f64)>> = Mutex::new(None);
+
+fn renewal() -> bool {
+    std::env::var_os("PROBE_RENEWAL").is_some()
+}
+
+fn key(code: u8, pa: usize, path: f32) -> Key4 {
+    let band = if path.is_finite() { (path / 5.0).floor() as i32 } else { -1 };
+    let inside = path.is_finite() && path < *LONGEST.lock().unwrap() - 3.0;
+    (code, pa as u8, band, inside)
+}
+
+pub(crate) fn birth((source, path): (u8, f32), pa: usize) {
+    if !renewal() {
+        return;
+    }
+    let k = key(source, pa, path);
+    *BIRTHS.lock().unwrap().get_or_insert_with(HashMap::new).entry(k).or_default() += 1;
+}
+
+pub(crate) fn death(cause: u8, pa: usize, path: f32) {
+    if !renewal() {
+        return;
+    }
+    let k = key(cause, pa, path);
+    *DEATHS_AT.lock().unwrap().get_or_insert_with(HashMap::new).entry(k).or_default() += 1;
+}
+
+pub(crate) fn longest(path: f32) {
+    *LONGEST.lock().unwrap() = path;
+}
+
+/// The decade's births and deaths, taken.
+pub(crate) fn take_renewal() -> (HashMap<Key4, u64>, HashMap<Key4, u64>) {
+    (
+        BIRTHS.lock().unwrap().take().unwrap_or_default(),
+        DEATHS_AT.lock().unwrap().take().unwrap_or_default(),
+    )
+}
+
+/// Records shed places only in a census year (`shed_year`).
+static SHED_ON: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub(crate) fn shed_year(on: bool) {
+    SHED_ON.store(on && renewal(), std::sync::atomic::Ordering::Relaxed);
+}
+
+pub(crate) fn shed_at(at: crate::structure::Vec3) {
+    if SHED_ON.load(std::sync::atomic::Ordering::Relaxed) {
+        SHED.lock().unwrap().push(at);
+    }
+}
+
+/// The light at the shed places, read with the next field, beside the
+/// living tips' light in it: (count, shed mean, shed median, living mean,
+/// living median).
+pub(crate) fn shed_light(at: &dyn Fn(crate::structure::Vec3) -> f64, living: &[f64]) {
+    let places = std::mem::take(&mut *SHED.lock().unwrap());
+    if !SHED_ON.swap(false, std::sync::atomic::Ordering::Relaxed) {
+        return;
+    }
+    let stats = |mut v: Vec<f64>| {
+        v.sort_by(f64::total_cmp);
+        let mean = v.iter().sum::<f64>() / v.len().max(1) as f64;
+        (mean, v.get(v.len() / 2).copied().unwrap_or(f64::NAN))
+    };
+    let (sm, sd) = stats(places.iter().map(|&p| at(p)).collect());
+    let (lm, ld) = stats(living.to_vec());
+    *SHED_LIGHT.lock().unwrap() = Some((places.len(), sm, sd, lm, ld));
+}
+
+pub(crate) fn take_shed_light() -> Option<(usize, f64, f64, f64, f64)> {
+    SHED_LIGHT.lock().unwrap().take()
+}
+
+/// fn-346 old-tree probe: the walk's shed flags by place in the open list,
+/// the cycle, the cause each apex ended by (by its axis's lineage), and
+/// the limbs lost, with the framework births near their base after.
+static WALKED: Mutex<Vec<bool>> = Mutex::new(Vec::new());
+static CYCLE: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+static CAUSE: Mutex<Option<HashMap<u64, u8>>> = Mutex::new(None);
+pub(crate) struct Loss {
+    pub year: u32,
+    pub lineage: u64,
+    pub base: f32,
+    /// The bearer's line: the stem (0) or a limb or bough line's head.
+    pub bearer: u64,
+    pub births: [u32; 3],
+}
+static SHED_AXES: Mutex<Vec<usize>> = Mutex::new(Vec::new());
+/// Each axis's line, by its index this cycle: 0 for the stem line, its
+/// limb or bough line head's lineage, or u64::MAX; refreshed every cycle.
+pub(crate) static LINE_OF: Mutex<Vec<u64>> = Mutex::new(Vec::new());
+
+pub(crate) fn shed_axis(i: usize) {
+    if std::env::var_os("PROBE_OLDTREE").is_some() {
+        SHED_AXES.lock().unwrap().push(i);
+    }
+}
+
+pub(crate) fn take_shed_axes() -> Vec<usize> {
+    std::mem::take(&mut *SHED_AXES.lock().unwrap())
+}
+
+/// A framework birth on the bearer of index `bearer` this cycle.
+pub(crate) fn framework_birth(pa: usize, path: f32, bearer: usize) {
+    if std::env::var_os("PROBE_OLDTREE").is_none() {
+        return;
+    }
+    let line = LINE_OF.lock().unwrap().get(bearer).copied().unwrap_or(u64::MAX);
+    if line != u64::MAX {
+        near_loss(pa, path, line);
+    }
+}
+pub(crate) static LOSSES: Mutex<Vec<Loss>> = Mutex::new(Vec::new());
+
+pub(crate) fn set_walked(v: Vec<bool>) {
+    *WALKED.lock().unwrap() = v;
+}
+
+pub(crate) fn walked() -> Vec<bool> {
+    std::mem::take(&mut *WALKED.lock().unwrap())
+}
+
+pub(crate) fn set_cycle(c: u32) {
+    CYCLE.store(c, std::sync::atomic::Ordering::Relaxed);
+}
+
+pub(crate) fn apex_end_cause(lineage: u64, cause: u8) {
+    if std::env::var_os("PROBE_OLDTREE").is_none() {
+        return;
+    }
+    CAUSE.lock().unwrap().get_or_insert_with(HashMap::new).insert(lineage, cause);
+}
+
+pub(crate) fn cause_of(lineage: u64) -> Option<u8> {
+    CAUSE.lock().unwrap().as_ref().and_then(|m| m.get(&lineage).copied())
+}
+
+/// A framework birth (limb 6, bough 7, branch 9) at `path`: counted for
+/// every limb lost in the 20 years before whose base path lies within 3 m.
+fn near_loss(pa: usize, path: f32, line: u64) {
+    let k = match pa {
+        6 => 0,
+        7 => 1,
+        9 => 2,
+        _ => return,
+    };
+    let year = CYCLE.load(std::sync::atomic::Ordering::Relaxed).saturating_sub(1);
+    for l in LOSSES.lock().unwrap().iter_mut() {
+        if year >= l.year && year < l.year + 20 && l.bearer == line && (path - l.base).abs() <= 3.0 {
+            l.births[k] += 1;
+        }
+    }
+}
+
+/// fn-346 old-tree probe: each living limb on the stem line in the settled
+/// tree (a PA 6 lateral of the stem line and the relays and continuations
+/// of its row that carry it on): its length along the line, its base
+/// radius, its horizontal reach from its base, its tip's height against
+/// its base, the lowest point of the line and of its whole subtree, and
+/// the length its line laid in the last ten cycles.
+fn shape(s: &crate::structure::Structure, main: &[bool], alive: &[bool]) {
+    use crate::structure::Origin;
+    let n = s.axes.len();
+    let z0 = s.axes[0].base.z;
+    let mut kids = vec![Vec::new(); n];
+    for (i, a) in s.axes.iter().enumerate() {
+        if let Some(p) = a.origin.parent() {
+            kids[p].push(i);
+        }
+    }
+    let age = s.axes.iter().flat_map(|a| a.phytomers.last()).map(|p| p.cycle).max().unwrap_or(0);
+    for (h, a) in s.axes.iter().enumerate() {
+        let Origin::Lateral { parent, .. } = a.origin else { continue };
+        if !(main[parent] && a.pa == 6 && alive[h]) {
+            continue;
+        }
+        // The line: the head and every relay or continuation of its row.
+        let mut line = vec![h];
+        let mut k = 0;
+        while k < line.len() {
+            for &c in &kids[line[k]] {
+                let ca = &s.axes[c];
+                if ca.pa == 6 && matches!(ca.origin, Origin::Relay { .. } | Origin::Continuation { .. }) {
+                    line.push(c);
+                }
+            }
+            k += 1;
+        }
+        let mut sub = vec![h];
+        let mut k = 0;
+        while k < sub.len() {
+            sub.extend(kids[sub[k]].iter().copied());
+            k += 1;
+        }
+        let base = a.base;
+        let (mut length, mut reach, mut low, mut recent) = (0.0f64, 0.0f64, f64::MAX, 0.0f64);
+        let mut tip = (0u32, base);
+        for &i in &line {
+            let ax = &s.axes[i];
+            let mut prev = ax.base;
+            for p in &ax.phytomers {
+                let d = ((p.tip.x - prev.x).powi(2) + (p.tip.y - prev.y).powi(2) + (p.tip.z - prev.z).powi(2)).sqrt();
+                length += d;
+                if p.cycle + 10 > age {
+                    recent += d;
+                }
+                reach = reach.max(((p.tip.x - base.x).powi(2) + (p.tip.y - base.y).powi(2)).sqrt());
+                low = low.min(p.tip.z);
+                if p.cycle >= tip.0 {
+                    tip = (p.cycle, p.tip);
+                }
+                prev = p.tip;
+            }
+        }
+        let sub_low = sub.iter().flat_map(|&i| &s.axes[i].phytomers).map(|p| p.tip.z).fold(f64::MAX, f64::min);
+        let below = sub.iter().flat_map(|&i| &s.axes[i].phytomers).filter(|p| p.tip.z < z0).count();
+        let radius = a.phytomers.first().map_or(0.0, |p| p.radius);
+        println!(
+            "SHAPE lineage={} birth={} base_z={:.2} length={length:.2} base_radius_cm={:.1} reach={reach:.2} tip_dz={:.2} \
+             line_low={:.2} sub_low={:.2} below_ground_phytomers={below} ext_per_year={:.3} line_axes={}",
+            a.lineage, a.birth, base.z - z0, radius * 100.0, tip.1.z - base.z, low - z0, sub_low - z0, recent / 10.0, line.len()
+        );
+    }
+}
+
+/// fn-346 probe rule B: the light at each held sleeping bud's place by its
+/// key, from the last field; and the buds woken (1) and let go with a dead
+/// bearer (2) since the census.
+static BUD_LIGHT: Mutex<Option<HashMap<u64, f64>>> = Mutex::new(None);
+static SLEEPERS: [std::sync::atomic::AtomicU64; 3] = [const { std::sync::atomic::AtomicU64::new(0) }; 3];
+
+pub(crate) fn cycle_now() -> u32 {
+    CYCLE.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+pub(crate) fn set_bud_light(at: Vec<(u64, f64)>) {
+    *BUD_LIGHT.lock().unwrap() = Some(at.into_iter().collect());
+}
+
+/// The light at the bud's place; none read, the open sky's 1, counted.
+pub(crate) fn bud_light(key: u64) -> f64 {
+    match BUD_LIGHT.lock().unwrap().as_ref().and_then(|m| m.get(&key).copied()) {
+        Some(l) => l,
+        None => {
+            sleeper(0);
+            1.0
+        }
+    }
+}
+
+pub(crate) fn sleeper(k: usize) {
+    SLEEPERS[k].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+}
+
+pub(crate) fn take_sleepers() -> [u64; 3] {
+    std::array::from_fn(|k| SLEEPERS[k].swap(0, std::sync::atomic::Ordering::Relaxed))
+}
