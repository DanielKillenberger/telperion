+//! fn-342 probe (evidence only, never merged): every limb's and bough's
+//! thickest-wood path on the settled engine tree, each joint's turn and the
+//! grower event that made it, and the trunk path at any age. Engine
+//! coordinates: z up, metres. A measurement, ignored.
+use super::executor;
+use crate::presets::by_identity;
+use std::collections::{HashMap, HashSet};
+use telperion_space::{grow, probe_tags, Origin, Structure, Vec3};
+
+type At = (usize, usize);
+
+fn sub(a: Vec3, b: Vec3) -> [f64; 3] {
+    [a.x - b.x, a.y - b.y, a.z - b.z]
+}
+fn norm(v: [f64; 3]) -> f64 {
+    (v[0] * v[0] + v[1] * v[1] + v[2] * v[2]).sqrt()
+}
+fn angle(a: [f64; 3], b: [f64; 3]) -> f64 {
+    let c = (a[0] * b[0] + a[1] * b[1] + a[2] * b[2]) / (norm(a) * norm(b)).max(1e-12);
+    c.clamp(-1.0, 1.0).acos().to_degrees()
+}
+fn v(a: Vec3) -> [f64; 3] {
+    [a.x, a.y, a.z]
+}
+
+struct Graph<'a> {
+    s: &'a Structure,
+    kids: Vec<Vec<Vec<usize>>>,
+}
+
+impl<'a> Graph<'a> {
+    fn new(s: &'a Structure) -> Self {
+        let mut kids: Vec<Vec<Vec<usize>>> =
+            s.axes.iter().map(|a| vec![Vec::new(); a.phytomers.len()]).collect();
+        for (i, a) in s.axes.iter().enumerate() {
+            let Some(p) = a.origin.parent() else { continue };
+            assert!(p < i, "parents come first");
+            let last = s.axes[p].phytomers.len().saturating_sub(1);
+            let node = match a.origin {
+                Origin::Lateral { node, .. } => node,
+                Origin::Relay { node, .. } => a.joined().map_or(node, |j| j.node),
+                _ => last,
+            };
+            if let Some(k) = kids[p].get_mut(node.min(last)) {
+                k.push(i);
+            }
+        }
+        Self { s, kids }
+    }
+    fn r(&self, (a, j): At) -> f64 {
+        self.s.axes[a].phytomers[j].radius
+    }
+    fn start(&self, (a, j): At) -> Vec3 {
+        if j == 0 { self.s.axes[a].base } else { self.s.axes[a].phytomers[j - 1].tip }
+    }
+    fn tip(&self, (a, j): At) -> Vec3 {
+        self.s.axes[a].phytomers[j].tip
+    }
+    fn seg(&self, at: At) -> [f64; 3] {
+        sub(self.tip(at), self.start(at))
+    }
+    fn next(&self, (a, j): At) -> Vec<At> {
+        let mut n: Vec<At> = Vec::new();
+        if j + 1 < self.s.axes[a].phytomers.len() {
+            n.push((a, j + 1));
+        }
+        for &c in &self.kids[a][j] {
+            if !self.s.axes[c].phytomers.is_empty() {
+                n.push((c, 0));
+            }
+        }
+        n
+    }
+    fn thickest(&self, at: At) -> Option<At> {
+        self.next(at).into_iter().max_by(|x, y| self.r(*x).total_cmp(&self.r(*y)))
+    }
+    fn origin(&self, a: usize) -> &'static str {
+        match self.s.axes[a].origin {
+            Origin::Seed => "seed",
+            Origin::Lateral { .. } => "lateral",
+            Origin::Continuation { .. } => "continuation",
+            Origin::Relay { .. } => "relay",
+        }
+    }
+}
+
+const NAMES: [&str; 4] = ["tropism", "wander", "sag", "pull"];
+
+/// The joint from `u` to `w`: its turn and cause, with the tagged turns.
+fn joint(g: &Graph, tags: &HashMap<u64, [f32; 6]>, u: At, w: At) -> (f64, String, String) {
+    let turn = angle(g.seg(u), g.seg(w));
+    let tag = |at: At| tags.get(&g.s.axes[at.0].phytomers[at.1].key()).copied();
+    let (tu, tw) = (tag(u), tag(w));
+    let comps = match (tu, tw) {
+        (Some(a), Some(b)) => [b[0], b[1], b[2], (b[3] - a[3]).abs(), b[4], b[5]],
+        (_, Some(b)) => [b[0], b[1], b[2], b[3], b[4], b[5]],
+        _ => [f32::NAN; 6],
+    };
+    let detail = format!(
+        "trop={:.2} wand={:.2} sag={:.2} dpull={:.2} lift={:.3} over={:.3}",
+        comps[0], comps[1], comps[2], comps[3], comps[4], comps[5]
+    );
+    let cause = if w.0 != u.0 {
+        let frame = angle(g.seg(u), v(g.s.axes[w.0].heading));
+        let kind = match g.s.axes[w.0].origin {
+            Origin::Relay { .. } => "relay".to_string(),
+            Origin::Continuation { .. } => "continuation".to_string(),
+            Origin::Lateral { .. } if u.1 + 1 < g.s.axes[u.0].phytomers.len() => "fork".to_string(),
+            Origin::Lateral { .. } => "lateral_at_end".to_string(),
+            Origin::Seed => "seed".to_string(),
+        };
+        // The wood not taken: the axis's own next phytomer, its radius over
+        // the taken one's, and the phytomers left on that axis.
+        let own = u.1 + 1 < g.s.axes[u.0].phytomers.len();
+        let (alt, left) = if own {
+            (g.r((u.0, u.1 + 1)) / g.r(w).max(1e-12), g.s.axes[u.0].phytomers.len() - u.1 - 1)
+        } else {
+            (0.0, 0)
+        };
+        return (
+            turn,
+            kind,
+            format!("{detail} frame={frame:.2} alt={alt:.3} left={left} apex_end={}", g.s.axes[u.0].apex_end.map_or(-1, |e| e as i64)),
+        );
+    } else if tw.is_none() {
+        "untagged".to_string()
+    } else {
+        let k = (0..4).max_by(|&a, &b| comps[a].total_cmp(&comps[b])).unwrap();
+        match (k, g.s.axes[w.0].origin) {
+            (3, Origin::Lateral { .. }) => "straightening".to_string(),
+            (3, _) => "inherited_pull".to_string(),
+            _ => NAMES[k].to_string(),
+        }
+    };
+    (turn, cause, detail)
+}
+
+#[test]
+#[ignore = "a measurement: fn-342"]
+fn turns_measures() {
+    let id = std::env::var("STRUCT_PRESET").unwrap_or("oregon-white-oak".into());
+    let age: f64 = std::env::var("STRUCT_AGE").ok().and_then(|a| a.parse().ok()).unwrap_or(0.0);
+    let seeds: Vec<u32> = std::env::var("STRUCT_SEEDS").expect("seeds")
+        .split(',').map(|s| s.parse().expect("a seed")).collect();
+    let neutral = std::env::var("TURN_NEUTRAL").unwrap_or_default();
+    let tagged = std::env::var_os("TURN_TAGS").is_some();
+    for seed in seeds {
+        let mut f = by_identity(&id).expect("a preset");
+        f.fidelity = 0.0;
+        f.skeleton.seed = seed;
+        if age > 0.0 {
+            f.age = age;
+        }
+        let mut g = executor::growth(&f).expect("its growth");
+        for pa in [6usize, 7] {
+            let form = &mut g.species.states[pa].form;
+            match neutral.as_str() {
+                "wander" => form.wander = 0.0,
+                "sag" => form.sag = 0.0,
+                "straightening" => g.species.states[pa].straightening = 0.0,
+                "abortion" => g.species.states[pa].abortion = 0.0,
+                _ => {}
+            }
+        }
+        if tagged {
+            probe_tags::start();
+        }
+        let t0 = std::time::Instant::now();
+        let s = grow(&g.species, g.request).expect("a tree");
+        let secs = t0.elapsed().as_secs_f64();
+        let tags = probe_tags::take();
+        read(seed, &s, &tags, secs, &neutral);
+    }
+}
+
+fn read(seed: u32, s: &Structure, tags: &HashMap<u64, [f32; 6]>, secs: f64, neutral: &str) {
+    let g = Graph::new(s);
+    let z0 = s.axes[0].base.z;
+    let top = s.axes.iter().flat_map(|a| &a.phytomers).map(|p| p.tip.z - z0).fold(f64::MIN, f64::max);
+    let keys: HashSet<u64> = s.axes.iter().flat_map(|a| &a.phytomers).map(|p| p.key()).collect();
+    let tagged = keys.iter().filter(|k| tags.contains_key(k)).count();
+    println!(
+        "TREE {seed} age={} neutral={} secs={secs:.2} height={top:.3} axes={} phyt={} keys={} tagged={tagged}",
+        s.age, if neutral.is_empty() { "none" } else { neutral }, s.axes.len(), s.phytomer_count(), keys.len()
+    );
+    // The trunk: the thickest wood from the root.
+    let mut at = (0usize, 0usize);
+    let mut k = 0;
+    loop {
+        let a = &s.axes[at.0];
+        let p = &a.phytomers[at.1];
+        let nx = g.thickest(at);
+        let turn = nx.map_or(f64::NAN, |w| angle(g.seg(at), g.seg(w)));
+        println!(
+            "TRUNK {seed} {k} z={:.3} x={:.3} y={:.3} r={:.4} axis={} pa={} origin={} birth={} cycle={} turn_next={turn:.2}",
+            p.tip.z - z0, p.tip.x, p.tip.y, p.radius, at.0, a.pa, g.origin(at.0), a.birth, p.cycle
+        );
+        let Some(w) = nx else { break };
+        at = w;
+        k += 1;
+    }
+    if tags.is_empty() {
+        return;
+    }
+    // Every limb and bough from its base along its thickest wood, a joint
+    // walked once.
+    let mut seen: HashSet<At> = HashSet::new();
+    let mut path = 0usize;
+    // TURN_RMIN: also every lateral of any PA this thick at its base.
+    let rmin: f64 = std::env::var("TURN_RMIN").ok().and_then(|r| r.parse().ok()).unwrap_or(f64::INFINITY);
+    for (c, a) in s.axes.iter().enumerate() {
+        if !matches!(a.origin, Origin::Lateral { .. }) || a.phytomers.is_empty() {
+            continue;
+        }
+        if !(a.pa == 6 || a.pa == 7 || a.phytomers[0].radius >= rmin) {
+            continue;
+        }
+        if !seen.insert((c, 0)) {
+            continue;
+        }
+        let parent = a.origin.parent().map_or(0, |p| s.axes[p].pa);
+        println!("PATH {seed} {path} pa={} parent_pa={parent} birth={} base_z={:.3}", a.pa, a.birth, a.base.z - z0);
+        let mut u = (c, 0);
+        let mut k = 0;
+        loop {
+            let (s0, t0) = (g.start(u), g.tip(u));
+            println!(
+                "SEG {seed} {path} {k} {:.3} {:.3} {:.3} {:.3} {:.3} {:.3} r={:.4} pa={}",
+                s0.x, s0.y, s0.z - z0, t0.x, t0.y, t0.z - z0, g.r(u), s.axes[u.0].pa
+            );
+            let Some(w) = g.thickest(u) else { break };
+            if !seen.insert(w) {
+                break;
+            }
+            let (turn, cause, detail) = joint(&g, tags, u, w);
+            let len = norm(g.seg(u));
+            println!(
+                "JOINT {seed} {path} {k} turn={turn:.2} cause={cause} pa={} pa_next={} r={:.4} len={len:.4} z={:.3} {detail}",
+                s.axes[u.0].pa, s.axes[w.0].pa, g.r(w), t0.z - z0
+            );
+            u = w;
+            k += 1;
+        }
+        path += 1;
+    }
+}
