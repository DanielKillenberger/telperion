+//! fn-342 probe (evidence only, never merged): each laid phytomer's turns
+//! by cause in its lay step, keyed by its node's key; the last lay wins.
+//! Dormant unless `start` was called.
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Mutex;
+
+static ON: AtomicBool = AtomicBool::new(false);
+static TAGS: Mutex<Option<HashMap<u64, [f32; 6]>>> = Mutex::new(None);
+
+fn angle(a: [f32; 3], b: [f32; 3]) -> f32 {
+    let n = |v: [f32; 3]| (v[0] * v[0] + v[1] * v[1] + v[2] * v[2]).sqrt().max(1e-12);
+    let c = (a[0] * b[0] + a[1] * b[1] + a[2] * b[2]) / (n(a) * n(b));
+    c.clamp(-1.0, 1.0).acos().to_degrees()
+}
+
+/// Degrees turned by tropism, wander, sag and the pulls (straightening,
+/// erection, inherited pulls, take-over, landing), then `lift` and `over`.
+pub(crate) fn record(key: u64, r: [[f32; 3]; 5], [lift, over]: [f32; 2]) {
+    if !ON.load(Ordering::Relaxed) {
+        return;
+    }
+    let row = [
+        angle(r[0], r[1]),
+        angle(r[1], r[2]),
+        angle(r[2], r[3]),
+        angle(r[3], r[4]),
+        lift,
+        over,
+    ];
+    if let Some(m) = TAGS.lock().unwrap().as_mut() {
+        m.insert(key, row);
+    }
+}
+
+pub fn start() {
+    *TAGS.lock().unwrap() = Some(HashMap::new());
+    ON.store(true, Ordering::Relaxed);
+}
+
+pub fn take() -> HashMap<u64, [f32; 6]> {
+    ON.store(false, Ordering::Relaxed);
+    TAGS.lock().unwrap().take().unwrap_or_default()
+}
