+//! fn-342 probe (evidence only, never merged): the year's record of the
+//! tree as the grower holds it before cycle `cycle` grows, on stdout,
+//! when `PROBE_YEAR` is set: its height, the stem line's limbs and each
+//! one's balance terms.
+use super::working::Working;
+use crate::contract::shed::Walked;
+use crate::grow::Grower;
+use crate::structure::Origin;
+
+pub(super) fn year(g: &Grower, w: &Working, walked: &[Walked], cycle: u32) {
+    if std::env::var_os("PROBE_YEAR").is_none() {
+        return;
+    }
+    let sketch = g.sketch.as_ref().expect("sketching");
+    let n = sketch.pencils.len().min(g.axes.len());
+    let z0 = g.axes[0].base.z;
+    // The stem line: the seed and what carries it on.
+    let mut main = vec![false; n];
+    let mut top = f64::MIN;
+    let mut main_top = f64::MIN;
+    for i in 0..n {
+        let a = &g.axes[i];
+        main[i] = match a.origin {
+            Origin::Seed => true,
+            Origin::Continuation { parent } | Origin::Relay { parent, .. } => main[parent],
+            Origin::Lateral { .. } => false,
+        };
+        for p in &a.phytomers {
+            top = top.max(p.tip.z - z0);
+            if main[i] {
+                main_top = main_top.max(p.tip.z - z0);
+            }
+        }
+    }
+    let upkeep = |i: usize| g.species.states[g.axes[i].pa].upkeep * sketch.pencils[i].wood;
+    // A subtree's upkeep split into its open (living) wood and its closed
+    // (dead, standing) wood.
+    fn split(w: &Working, i: usize, upkeep: &dyn Fn(usize) -> f64, out: &mut [f64; 2]) {
+        out[0] += upkeep(i);
+        for &c in w.children(i) {
+            let c = c as usize;
+            if w.open[c] {
+                split(w, c, upkeep, out);
+            } else {
+                out[1] += f64::from(w.frozen[c]);
+            }
+        }
+    }
+    let (mut living, mut lowest) = (0usize, f64::NAN);
+    for i in 0..n {
+        let a = &g.axes[i];
+        let Origin::Lateral { parent, .. } = a.origin else { continue };
+        if !main[parent] || !(a.pa == 6 || a.pa == 7) || i >= w.open.len() {
+            continue;
+        }
+        let open = w.open[i];
+        let alive = open && w.living[i];
+        let base = a.base.z - z0;
+        if alive {
+            living += usize::from(a.pa == 6);
+            if a.pa == 6 {
+                lowest = if lowest.is_nan() { base } else { lowest.min(base) };
+            }
+        }
+        if !open {
+            continue;
+        }
+        let k = w.at[i] as usize;
+        let mut c = [0.0; 2];
+        split(w, i, &upkeep, &mut c);
+        let wk = &walked[k];
+        println!(
+            "LIMBY {} axis={i} lineage={} pa={} birth={} base={base:.3} live={} light={:.5} cost={:.5} \
+             cost_live={:.5} cost_dead={:.5} memory={:.4} shed={} kept={:.4} wood={:.3}",
+            cycle - 1, a.lineage, a.pa, a.birth, u8::from(alive), w.light[i], w.cost[i], c[0], c[1],
+            wk.memory.map_or(f32::NAN, |m| m), u8::from(wk.shed), wk.kept,
+            sketch.pencils[i].wood
+        );
+    }
+    println!(
+        "YEAR {} height={top:.3} stem_top={main_top:.3} apexes={} limbs_live={living} lowest_limb={lowest:.3}",
+        cycle - 1,
+        g.live.len()
+    );
+}
