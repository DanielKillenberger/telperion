new file mode 100644
index 00000000..6eb56aff
--- /dev/null
+++ w/crates/telperion-space/src/prof.rs
@@ -0,0 +1,37 @@
+//! fn-211 task 1 probe instrumentation (temporary; never committed under
+//! src): each pass's wall time per cycle, and the part of it spent in
+//! spread work (`cores::spread`, a share's growth), whose remainder is
+//! the pass's serial share.
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::Mutex;
+use std::time::Instant;
+
+/// Nanoseconds the calling thread has spent in spread regions.
+pub(crate) static PAR: AtomicU64 = AtomicU64::new(0);
+static LOG: Mutex<Vec<(u32, &'static str, u64, u64)>> = Mutex::new(Vec::new());
+
+pub(crate) fn time<T>(cycle: u32, name: &'static str, f: impl FnOnce() -> T) -> T {
+    let (p0, t) = (PAR.load(Relaxed), Instant::now());
+    let r = f();
+    let wall = t.elapsed().as_nanos() as u64;
+    let par = PAR.load(Relaxed) - p0;
+    LOG.lock().unwrap().push((cycle, name, wall, par));
+    r
+}
+
+pub(crate) fn log(cycle: u32, name: &'static str, wall: u64) {
+    LOG.lock().unwrap().push((cycle, name, wall, 0));
+}
+
+pub(crate) fn par<T>(f: impl FnOnce() -> T) -> T {
+    let t = Instant::now();
+    let r = f();
+    PAR.fetch_add(t.elapsed().as_nanos() as u64, Relaxed);
+    r
+}
+
+/// Every span logged since the last take: cycle (0 setup, age+1 settle),
+/// pass, wall and parallel nanoseconds.
+pub fn take() -> Vec<(u32, &'static str, u64, u64)> {
+    std::mem::take(&mut *LOG.lock().unwrap())
+}
