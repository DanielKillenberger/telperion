+/// Probe (fn-211.6, not product code): each cycle's phases timed, and
+/// the records a CPU-led hybrid would move between the CPU and a device
+/// growing the items, counted.
+mod hyb {
+    use super::Executor;
+    use crate::dormant::{Sleeper, Woken};
+    use crate::presence::{Draws, Unit};
+    use crate::structure::{Axis, Phytomer};
+    use std::mem::size_of;
+
+    pub const BALANCE: usize = 0;
+    pub const ALLOT: usize = 1;
+    pub const COARSE: usize = 2;
+    pub const ITEMS_GROW: usize = 3;
+    pub const ITEMS_SKETCH: usize = 4;
+    pub const HANDOVER: usize = 5;
+    pub const RELAY: usize = 6;
+    pub const SHADE: usize = 7;
+    pub const MARK: usize = 8;
+
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    static CPU: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+
+    // fn-211.7: wall seconds of each sub-phase, and counts.
+    pub const W_BAL_ITEMS: usize = 0;
+    pub const W_BAL_COARSE: usize = 1;
+    pub const W_ALLOT_ITEMS: usize = 2;
+    pub const W_ALLOT_COARSE: usize = 3;
+    pub const W_GLUE: usize = 4;
+    pub const W_SPAN: usize = 5; // then DEPOSIT_COARSE 6, DEPOSIT_FINE 7, SWEEP 8
+    pub const W_READ_COARSE: usize = 9;
+    pub const W_READ_FINE: usize = 10;
+    pub const W_ASSEMBLE: usize = 11;
+    pub const W_RELAY_TREE: usize = 12;
+    pub const W_DISPERSE: usize = 13;
+    pub const W_RELAY_PASS: usize = 14; // settle, place, levers, sag, write: 14..19
+    const NW: usize = 19;
+    static WALL: [AtomicU64; NW] = [const { AtomicU64::new(0) }; NW];
+    pub const C_LEAVES_COARSE: usize = 0;
+    pub const C_LEAVES_FINE: usize = 1;
+    pub const C_TIPS_COARSE: usize = 2;
+    pub const C_TIPS_FINE: usize = 3;
+    pub const C_NODES: usize = 4;
+    pub const C_RELAY_FINE: usize = 5;
+    pub const C_RELAY_ALL: usize = 6;
+    const NC: usize = 7;
+    static COUNT: [AtomicU64; NC] = [const { AtomicU64::new(0) }; NC];
+
+    pub fn wall(k: usize, since: std::time::Instant) {
+        WALL[k].fetch_add(since.elapsed().as_nanos() as u64, Relaxed);
+    }
+
+    pub fn add_secs(k: usize, s: f64) {
+        WALL[k].fetch_add((s * 1e9) as u64, Relaxed);
+    }
+
+    pub fn count(k: usize, n: usize) {
+        COUNT[k].fetch_add(n as u64, Relaxed);
+    }
+
+    fn walls() -> Vec<String> {
+        WALL.iter()
+            .map(|c| format!("{:.6}", c.swap(0, Relaxed) as f64 * 1e-9))
+            .collect()
+    }
+
+    fn counts() -> Vec<String> {
+        COUNT.iter().map(|c| c.swap(0, Relaxed).to_string()).collect()
+    }
+
+    /// An item's pass's seconds on its core, summed over the items.
+    pub fn add(p: super::super::Pass, d: std::time::Duration) {
+        use super::super::Pass::*;
+        let k = match p {
+            Homes => 0,
+            Units => 1,
+            Merge => 2,
+            Wake => 3,
+            _ => return,
+        };
+        CPU[k].fetch_add(d.as_nanos() as u64, Relaxed);
+    }
+
+    fn cpu() -> Vec<String> {
+        CPU.iter()
+            .map(|c| format!("{:.6}", c.swap(0, Relaxed) as f64 * 1e-9))
+            .collect()
+    }
+
+    #[derive(Default)]
+    pub struct Row {
+        cycle: u32,
+        pub t: [f64; 9],
+        live0: usize,
+        live: usize,
+        live1: usize,
+        axes0: usize,
+        axes1: usize,
+        grown0: u64,
+        grown1: u64,
+        asleep0: usize,
+        asleep1: usize,
+        woken0: usize,
+        woken1: usize,
+        items: usize,
+        handed: usize,
+        handed_axes: usize,
+        handed_phyt: usize,
+        handed_asleep: usize,
+        handed_live: usize,
+        coarse_live: usize,
+        coarse_axes: usize,
+    }
+
+    fn sum(x: &Executor, f: impl Fn(&super::Grower) -> usize) -> usize {
+        x.items.iter().map(|i| f(&i.g)).sum()
+    }
+
+    fn asleep(g: &super::Grower) -> usize {
+        g.asleep.iter().map(Vec::len).sum()
+    }
+
+    fn phyt(g: &super::Grower) -> usize {
+        g.axes.iter().map(|a| a.phytomers.len()).sum()
+    }
+
+    impl Row {
+        pub fn start(cycle: u32, x: &Executor) -> Self {
+            Self {
+                cycle,
+                live0: sum(x, |g| g.live.len()),
+                ..Self::default()
+            }
+        }
+
+        pub fn before_growth(&mut self, x: &Executor) {
+            self.live = sum(x, |g| g.live.len());
+            self.axes0 = sum(x, |g| g.axes.len());
+            self.grown0 = x.items.iter().map(|i| i.g.rules.grown).sum();
+            self.asleep0 = sum(x, asleep);
+            self.woken0 = sum(x, |g| g.woken.len());
+        }
+
+        pub fn after_growth(&mut self, x: &Executor) {
+            self.live1 = sum(x, |g| g.live.len());
+            self.axes1 = sum(x, |g| g.axes.len());
+            self.grown1 = x.items.iter().map(|i| i.g.rules.grown).sum();
+            self.asleep1 = sum(x, asleep);
+            self.woken1 = sum(x, |g| g.woken.len());
+        }
+
+        pub fn handed(&mut self, x: &Executor, before: usize) {
+            let new = &x.items[before..];
+            self.items = x.items.len();
+            self.handed = new.len();
+            self.handed_axes = new.iter().map(|i| i.g.axes.len()).sum();
+            self.handed_phyt = new.iter().map(|i| phyt(&i.g)).sum();
+            self.handed_asleep = new.iter().map(|i| asleep(&i.g)).sum();
+            self.handed_live = new.iter().map(|i| i.g.live.len()).sum();
+            self.coarse_live = x.coarse.live.len();
+            self.coarse_axes = x.coarse.axes.len();
+        }
+
+        pub fn print(&self) {
+            if std::env::var_os("HYBRID").is_none() {
+                return;
+            }
+            let t: Vec<String> = self.t.iter().map(|v| format!("{:.6}", v)).collect();
+            println!(
+                "HYB {{\"cycle\":{},\"w\":[{}],\"c\":[{}],\"cpu\":[{}],\"t\":[{}],\"live0\":{},\"live\":{},\"live1\":{},\"axes0\":{},\"axes1\":{},\"grown\":{},\"asleep0\":{},\"asleep1\":{},\"woken\":{},\"items\":{},\"handed\":{},\"handed_axes\":{},\"handed_phyt\":{},\"handed_asleep\":{},\"handed_live\":{},\"coarse_live\":{},\"coarse_axes\":{},\"sz\":{{\"phytomer\":{},\"axis\":{},\"draws\":{},\"unit\":{},\"sleeper\":{},\"woken\":{}}}}}",
+                self.cycle,
+                walls().join(","),
+                counts().join(","),
+                cpu().join(","),
+                t.join(","),
+                self.live0,
+                self.live,
+                self.live1,
+                self.axes0,
+                self.axes1,
+                self.grown1 - self.grown0,
+                self.asleep0,
+                self.asleep1,
+                self.woken1 - self.woken0,
+                self.items,
+                self.handed,
+                self.handed_axes,
+                self.handed_phyt,
+                self.handed_asleep,
+                self.handed_live,
+                self.coarse_live,
+                self.coarse_axes,
+                size_of::<Phytomer>(),
+                size_of::<Axis>(),
+                size_of::<Draws>(),
+                size_of::<Unit>(),
+                size_of::<Sleeper>(),
+                size_of::<Woken>(),
+            );
+        }
+    }
+}
