+    /// Probe (fn-211.7): `on`, timed: the box, the first `split` leaves'
+    /// deposits, the rest's, and the sweep, in seconds.
+    pub(crate) fn probe_on(
+        light: &Light,
+        leaves: &[(Vec3, f64)],
+        split: usize,
+        reads: &[Vec3],
+        threads: usize,
+    ) -> (Self, [f64; 4]) {
+        let t = std::time::Instant::now();
+        let mut field = Self::spanning(
+            leaves.iter().map(|l| l.0).chain(reads.iter().copied()),
+            CELL,
+        );
+        let mut sums = vec![Sum::default(); field.density.len()];
+        let mut out = [t.elapsed().as_secs_f64(), 0.0, 0.0, 0.0];
+        let t = std::time::Instant::now();
+        for &(at, area) in &leaves[..split] {
+            field.deposit(at, area, &mut sums);
+        }
+        out[1] = t.elapsed().as_secs_f64();
+        let t = std::time::Instant::now();
+        for &(at, area) in &leaves[split..] {
+            field.deposit(at, area, &mut sums);
+        }
+        out[2] = t.elapsed().as_secs_f64();
+        let t = std::time::Instant::now();
+        for (d, s) in field.density.iter_mut().zip(sums) {
+            *d = s.value();
+        }
+        out[0] += t.elapsed().as_secs_f64();
+        let t = std::time::Instant::now();
+        field.sweep(light.extinction, &light.directions(), threads);
+        out[3] = t.elapsed().as_secs_f64();
+        (field, out)
