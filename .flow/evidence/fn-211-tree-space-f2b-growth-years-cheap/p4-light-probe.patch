@@ -0,0 +1,179 @@
+//! fn-211.4 light probe: the pass's last field (before the last cycle)
+//! against the laid tree's field of the same cycle's leaves, at the same
+//! points, split into position and field, and the field into its
+//! coupling leaves and its fine stand-ins.
+//!
+//!   cargo run --profile ci -p telperion-space --example probe -- [age] [seed] [cells]
+#[path = "junctions/stats.rs"]
+mod stats;
+
+use stats::quantiles;
+use std::collections::HashMap;
+use telperion_space::{field_reads, grow, oak, Bounded, Expected, Light, Probe, Request, Structure, Vec3, PROBE};
+
+const LIT: Light = Light {
+    extinction: 0.5,
+    sky: 0.5,
+};
+
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let age: u32 = args.first().map_or(80, |a| a.parse().unwrap());
+    let seed: u64 = args.get(1).map_or(1, |a| a.parse().unwrap());
+    let cells: Vec<f64> = args
+        .get(2)
+        .map_or("0.5".into(), |a: &String| a.clone())
+        .split(',')
+        .map(|c| c.parse().unwrap())
+        .collect();
+    let mut species = oak();
+    if std::env::var("PROBE_NO_BALANCE").is_ok() {
+        for s in &mut species.states {
+            s.balance_hazard = 0.0;
+        }
+    }
+    if std::env::var("PROBE_NO_SAG").is_ok() {
+        for s in &mut species.states {
+            s.form.sag = 0.0;
+        }
+    }
+    let request = Request {
+        age,
+        seed,
+        budget: 20_000_000,
+        light: LIT,
+    };
+    *PROBE.lock().unwrap() = None;
+    let today = grow(&species, request).expect("grows");
+    let probe = PROBE.lock().unwrap().take().expect("probed");
+    analyze(&format!("today's oak {age} s{seed}"), &today, &probe, None, &species);
+    let expected = Expected::new(&species, age, 0);
+    for cell in cells {
+        *PROBE.lock().unwrap() = None;
+        let (ours, m) = Bounded::coupled_laid(&species, request, &expected, cell, 0).expect("couples");
+        let probe = PROBE.lock().unwrap().take().expect("probed");
+        analyze(&format!("coupled oak {age} s{seed} cell {cell}"), &ours, &probe, Some(&m.tag), &species);
+    }
+}
+
+fn q(v: &[f64]) -> String {
+    let (_, p50, p95) = quantiles(v);
+    let mean = v.iter().sum::<f64>() / v.len().max(1) as f64;
+    format!("p50 {p50:.4} p95 {p95:.4} mean {mean:+.4}")
+}
+
+fn analyze(label: &str, s: &Structure, probe: &Probe, tag: Option<&[usize]>, species: &telperion_space::Species) {
+    let last = s.age - 1;
+    let is_fine = |i: usize| tag.is_some_and(|t| t[i] != usize::MAX);
+    // The laid tree's leaves of the pass's last cycle.
+    let mut laid: Vec<(Vec3, f64, bool)> = Vec::new();
+    for (i, a) in s.axes.iter().enumerate() {
+        let area = species.states[a.pa].leaf_area;
+        for p in a.phytomers.iter().filter(|p| p.cycle == last) {
+            laid.push((p.tip, p.scale * area, is_fine(i)));
+        }
+    }
+    let sum = |v: &[(Vec3, f64, bool)], fine: bool| v.iter().filter(|l| l.2 == fine).map(|l| l.1).sum::<f64>();
+    println!(
+        "{label}: leaf area of cycle {last}: pass coupling {:.1} fine {:.1}; laid coupling {:.1} fine {:.1} (cell {})",
+        sum(&probe.leaves, false),
+        sum(&probe.leaves, true),
+        sum(&laid, false),
+        sum(&laid, true),
+        probe.cell
+    );
+    // Read points: each coupling apex's tip at the end of cycle `last`
+    // in the laid tree; each fine root's buds that grew in `last`.
+    let tip_at = |i: usize| {
+        let a = &s.axes[i];
+        a.phytomers.iter().rev().find(|p| p.cycle <= last).map_or(a.base, |p| p.tip)
+    };
+    let mut buds_of: HashMap<usize, Vec<Vec3>> = HashMap::new();
+    if let Some(t) = tag {
+        for (i, a) in s.axes.iter().enumerate() {
+            if t[i] == usize::MAX {
+                continue;
+            }
+            if let Some(p) = a.phytomers.iter().rev().find(|p| p.cycle == last) {
+                buds_of.entry(t[i]).or_default().push(p.tip);
+            }
+        }
+    }
+    // Points: pass points, then laid points (one per coupling read, a
+    // fine root's buds each).
+    let mut pass_pts = Vec::new();
+    let mut laid_pts = Vec::new();
+    let mut groups: Vec<(bool, f64, usize, usize, Vec3)> = Vec::new(); // fine, pass light, start, end in laid_pts, pass pt
+    for &(j, xp, lp, fine) in &probe.reads {
+        if j == usize::MAX || j >= s.axes.len() {
+            continue;
+        }
+        let start = laid_pts.len();
+        if fine {
+            let Some(b) = buds_of.get(&tag.unwrap()[j]) else { continue };
+            laid_pts.extend(b.iter().copied());
+        } else {
+            if is_fine(j) {
+                continue;
+            }
+            laid_pts.push(tip_at(j));
+        }
+        pass_pts.push(xp);
+        groups.push((fine, lp, start, laid_pts.len(), xp));
+    }
+    let strip = |v: &[(Vec3, f64, bool)], f: &dyn Fn(bool) -> bool| -> Vec<(Vec3, f64)> {
+        v.iter().filter(|l| f(l.2)).map(|l| (l.0, l.1)).collect()
+    };
+    let p_leaves = strip(&probe.leaves, &|_| true);
+    let l_leaves = strip(&laid, &|_| true);
+    let mut m1 = strip(&laid, &|f| !f);
+    m1.extend(strip(&probe.leaves, &|f| f));
+    let mut m2 = strip(&probe.leaves, &|f| !f);
+    m2.extend(strip(&laid, &|f| f));
+    let all: Vec<Vec3> = pass_pts.iter().chain(&laid_pts).copied().collect();
+    let np = pass_pts.len();
+    let f = |leaves: &[(Vec3, f64)]| field_reads(&LIT, leaves, &all, probe.cell);
+    let (pf, lf, m1f, m2f) = (f(&p_leaves), f(&l_leaves), f(&m1), f(&m2));
+    let mean = |v: &[f64], a: usize, b: usize| v[np + a..np + b].iter().sum::<f64>() / (b - a) as f64;
+    for kind in [false, true] {
+        let (mut total, mut pos, mut field, mut fine_part, mut coup_part, mut recorded, mut dist) =
+            (vec![], vec![], vec![], vec![], vec![], vec![], vec![]);
+        let mut lit = 0.0;
+        for (g, &(fine, lp, a, b, xp)) in groups.iter().enumerate() {
+            if fine != kind {
+                continue;
+            }
+            let l = mean(&lf, a, b);
+            lit += l;
+            recorded.push(lp - pf[g]);
+            total.push(pf[g] - l);
+            pos.push(pf[g] - mean(&pf, a, b));
+            field.push(mean(&pf, a, b) - l);
+            fine_part.push(mean(&m1f, a, b) - l);
+            coup_part.push(mean(&m2f, a, b) - l);
+            let c = laid_pts[a..b].iter().fold(Vec3::default(), |s, &p| s + p) * (1.0 / (b - a) as f64);
+            dist.push((c - xp).length());
+        }
+        if total.is_empty() {
+            continue;
+        }
+        let abs = |v: &[f64]| v.iter().map(|x| x.abs()).collect::<Vec<_>>();
+        println!(
+            "  {} reads (n {}, laid light mean {:.3}):",
+            if kind { "fine-root" } else { "coupling" },
+            total.len(),
+            lit / total.len() as f64
+        );
+        println!("    total  pass(x_pass) - laid(x_laid): |.| {}  signed mean {:+.4}", q(&abs(&total)), mean_of(&total));
+        println!("    position pass(x_pass) - pass(x_laid): |.| {}  signed {:+.4}", q(&abs(&pos)), mean_of(&pos));
+        println!("    field  pass(x_laid) - laid(x_laid): |.| {}  signed {:+.4}", q(&abs(&field)), mean_of(&field));
+        println!("      of which fine leaves (laid coupling + stand-ins): |.| {}  signed {:+.4}", q(&abs(&fine_part)), mean_of(&fine_part));
+        println!("      of which coupling leaves (pass coupling + laid fine): |.| {}  signed {:+.4}", q(&abs(&coup_part)), mean_of(&coup_part));
+        println!("    recheck recorded - pass(x_pass): |.| {}", q(&abs(&recorded)));
+        println!("    distance pass point to laid buds' centroid m: {}", q(&dist));
+    }
+}
+
+fn mean_of(v: &[f64]) -> f64 {
+    v.iter().sum::<f64>() / v.len().max(1) as f64
+}
