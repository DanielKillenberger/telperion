+                let ns: f64 = live.iter().map(|f| f.agg.last.1).sum();
+                let sn: f64 = live.iter().map(|f| f.agg.last.0 * f.scale).sum();
+                let dead_n: f64 = pass.fine.iter().filter(|f| f.dead).map(|f| f.agg.last.0).sum();
+                eprintln!("aggregates' cycle-{cycle} phytomers: {n:.0} (mean size {:.3}, scale-weighted {sn:.1}); in roots shed by balance {dead_n:.0}", ns / n);
+            }
+        }
+        if cycle + 1 == self.rules.age {
+            let mut stash = leaves.iter().enumerate().map(|(k, &(at, a))| (at, a, k >= own)).collect::<Vec<_>>();
+            let _ = &mut stash;
+            let mut reads: Vec<(usize, Vec3, f64, bool)> = self
+                .live
+                .iter()
+                .zip(&tips)
+                .map(|(a, &t)| (a.axis, t, field.at(t), false))
+                .collect();
+            let at_base = std::env::var("COUPLE_READ_BASE").is_ok();
+            for f in &fine {
+                let at = if at_base { self.axes[f.0].base } else { f.1 };
+                reads.push((f.0, at, field.at(at), true));
+            }
+            *super::PROBE.lock().unwrap() = Some(super::Probe {
+                leaves: stash,
+                reads,
+                cell: sketch.cell,
+            });
+        }
+        leaves.truncate(own);
+        self.leaves = leaves;
         self.sketch = Some(sketch);
         self.fine_lit(cycle, &read);
     }
