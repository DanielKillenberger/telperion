+//! fn-211.5's sensitivity probe: the lit oak grown with its light field's
+//! positions or reads moved (`PROBE_POS`, `PROBE_LIGHT`), its axes by
+//! identity against the unmoved tree's.
+use std::collections::HashSet;
+use telperion_space::{digest, grow, identities, oak, Light, Request};
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let modes: Vec<(String, String)> = args
+        .iter()
+        .map(|a| {
+            let (k, v) = a.split_once('=').expect("KEY=value");
+            (k.to_string(), v.to_string())
+        })
+        .collect();
+    let s = oak();
+    for age in [40u32, 80] {
+        for seed in [1, 7] {
+            let r = Request {
+                age,
+                seed,
+                budget: 20_000_000,
+                light: Light {
+                    extinction: 0.5,
+                    sky: 0.5,
+                },
+            };
+            std::env::remove_var("PROBE_POS");
+            std::env::remove_var("PROBE_LIGHT");
+            let base = grow(&s, r).expect("grows");
+            let ids: HashSet<u64> = identities(&base).into_iter().collect();
+            for (k, v) in &modes {
+                std::env::remove_var("PROBE_POS");
+                std::env::remove_var("PROBE_LIGHT");
+                std::env::set_var(k, v);
+                let t = grow(&s, r).expect("grows");
+                let other: HashSet<u64> = identities(&t).into_iter().collect();
+                let only_base = ids.difference(&other).count();
+                let only_moved = other.difference(&ids).count();
+                println!(
+                    "oak {age} {seed} {k}={v}: axes {} / {}, only unmoved {only_base}, only moved {only_moved}, phytomers {} / {}, digest {}",
+                    ids.len(),
+                    other.len(),
+                    base.phytomer_count(),
+                    t.phytomer_count(),
+                    if digest(&t) == digest(&base) { "same" } else { "moved" }
+                );
+            }
+        }
+    }
+}
