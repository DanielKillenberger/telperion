+/// fn-211.5's sensitivity probe (not committed): positions and reads
+/// moved by f32 rounding or noise, from the environment.
+pub(crate) mod probe {
+    use crate::structure::Vec3;
+    #[derive(Clone, Copy)]
+    pub enum Mode {
+        F32,
+        Noise(f64),
+    }
+    pub fn position() -> Option<Mode> {
+        let v = std::env::var("PROBE_POS").ok()?;
+        if v == "f32" {
+            return Some(Mode::F32);
+        }
+        v.strip_prefix("noise:").and_then(|m| m.parse().ok()).map(Mode::Noise)
+    }
+    pub fn light() -> Option<f64> {
+        std::env::var("PROBE_LIGHT").ok()?.parse().ok()
+    }
+    /// A value in [-1, 1) from `bits` and `salt`.
+    pub fn hash(bits: u64, salt: u64) -> f64 {
+        let mut z = bits ^ salt.wrapping_mul(0x9e37_79b9_7f4a_7c15);
+        z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+        z ^= z >> 31;
+        (z >> 11) as f64 / (1u64 << 52) as f64 - 1.0
+    }
+    pub fn moved(p: Vec3, mode: Mode) -> Vec3 {
+        match mode {
+            Mode::F32 => Vec3::new(p.x as f32 as f64, p.y as f32 as f64, p.z as f32 as f64),
+            Mode::Noise(m) => {
+                let k = p.x.to_bits() ^ p.y.to_bits().rotate_left(21) ^ p.z.to_bits().rotate_left(42);
+                Vec3::new(p.x + m * hash(k, 0), p.y + m * hash(k, 1), p.z + m * hash(k, 2))
+            }
+        }
+    }
+}
