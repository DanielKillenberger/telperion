+//! Presence (fn-192 R2): how grown each element a draw made is, from 0 where
+//! a setting crosses the draw to 1 once the setting is a window past it.
+//! The window is in log-odds and scales with the wood the draw decides,
+//! relative to the tree's expected length: a crown grows in over a long
+//! stretch of a walk, a twig over a short one, so no crossing changes the
+//! tree faster than about its whole length per `SPAN` log-odds. Topology
+//! never depends on presence, so presences are computed once the tree has
+//! grown, leaves first: each draw's window is known from the presences of
+//! the wood beyond it.
+use crate::species::Species;
+use crate::structure::{Axis, Origin};
+
+/// The window, in log-odds, per share of the tree's expected length that a
+/// draw decides.
+pub const RATE: f64 = 6.0;
+/// The widest window, in log-odds: a crown's.
+pub const SPAN: f64 = 2.0;
+/// The narrowest window, in log-odds: a twig's.
+pub const FLOOR: f64 = 0.05;
+
+/// The leads, in log-odds, of the draws that shaped one axis; infinite for
+/// a certain one.
+#[derive(Debug, Clone, Default)]
+pub(crate) struct Draws {
+    /// The draws that made the axis: a lateral's PA, or a relay's stop and
+    /// relay draws.
+    pub birth: [f64; 2],
+    /// Per growth unit: its survival, then the apex's persistence past it
+    /// (not aborting).
+    pub units: Vec<[f64; 2]>,
+    /// Per phytomer: its node's draw.
+    pub nodes: Vec<f64>,
+    /// The apex still lives at the tree's age.
+    pub alive: bool,
+}
+
+/// The presence of a draw `lead` log-odds past its bound that decides
+/// `wood` metres, in a tree expected to hold `whole` metres.
+fn presence(lead: f64, wood: f64, whole: f64) -> f64 {
+    if lead == f64::INFINITY {
+        return 1.0;
+    }
+    let window = (RATE * wood / whole).clamp(FLOOR, SPAN);
+    (lead / window).clamp(0.0, 1.0)
+}
+
+/// Sets every axis's vigour, growth-unit presences, phytomer scales (each
+/// relative to its axis's base), phyllotactic ranks and living presence.
+pub(crate) fn assign(axes: &mut [Axis], draws: &[Draws], species: &Species, whole: f64) {
+    let whole = whole.max(f64::MIN_POSITIVE);
+    let mut laterals: Vec<Vec<(usize, usize)>> = vec![Vec::new(); axes.len()];
+    let mut ends: Vec<Vec<usize>> = vec![Vec::new(); axes.len()];
+    for (i, axis) in axes.iter().enumerate() {
+        match axis.origin {
+            Origin::Seed => {}
+            Origin::Lateral { parent, node, .. } => laterals[parent].push((node, i)),
+            Origin::Continuation { parent } | Origin::Relay { parent } => ends[parent].push(i),
+        }
+    }
+    // Leaves first: wood[i] is axis i's subtree in metres, each element
+    // weighted by its presence relative to the axis's base.
+    let mut wood = vec![0.0; axes.len()];
+    let mut made = vec![1.0; axes.len()];
+    let mut units: Vec<Vec<[f64; 2]>> = vec![Vec::new(); axes.len()];
+    let mut nodes: Vec<Vec<f64>> = vec![Vec::new(); axes.len()];
+    for i in (0..axes.len()).rev() {
+        let axis = &axes[i];
+        for &c in &ends[i] {
+            let [a, b] = draws[c].birth;
+            made[c] = presence(a, wood[c], whole) * presence(b, wood[c], whole);
+        }
+        let mut node_wood = vec![species.states[axis.pa].internode; axis.phytomers.len()];
+        for &(node, c) in &laterals[i] {
+            made[c] = presence(draws[c].birth[0], wood[c], whole);
+            node_wood[node] += made[c] * wood[c];
+        }
+        nodes[i] = draws[i]
+            .nodes
+            .iter()
+            .zip(&node_wood)
+            .map(|(&lead, &w)| presence(lead, w, whole))
+            .collect();
+        let mut unit_wood = vec![0.0; draws[i].units.len()];
+        for (j, p) in axis.phytomers.iter().enumerate() {
+            unit_wood[(p.cycle - axis.birth - 1) as usize] += nodes[i][j] * node_wood[j];
+        }
+        let mut beyond: f64 = ends[i].iter().map(|&c| made[c] * wood[c]).sum();
+        let mut factors = vec![[1.0; 2]; draws[i].units.len()];
+        for (k, &[survive, persist]) in draws[i].units.iter().enumerate().rev() {
+            factors[k][1] = presence(persist, beyond, whole);
+            beyond = factors[k][1] * beyond + unit_wood[k];
+            factors[k][0] = presence(survive, beyond, whole);
+            beyond *= factors[k][0];
+        }
+        wood[i] = beyond;
+        units[i] = factors;
+    }
+    // Roots first: running presences along each axis and what each child
+    // inherits.
+    let mut end = vec![1.0; axes.len()];
+    for i in 0..axes.len() {
+        let birth = axes[i].birth;
+        let mut running = 1.0;
+        let mut presences = Vec::with_capacity(units[i].len());
+        let mut j = 0;
+        let mut rank = 0.0;
+        for (k, &[survive, persist]) in units[i].iter().enumerate() {
+            running *= survive;
+            presences.push(running);
+            let axis = &mut axes[i];
+            while j < axis.phytomers.len() && (axis.phytomers[j].cycle - birth - 1) as usize == k {
+                axis.phytomers[j].scale = running * nodes[i][j];
+                axis.phytomers[j].rank = rank;
+                rank += nodes[i][j];
+                j += 1;
+            }
+            running *= persist;
+        }
+        end[i] = running;
+        let axis = &mut axes[i];
+        axis.units = presences;
+        axis.rank = rank;
+        axis.alive = if draws[i].alive { running } else { 0.0 };
+        axis.vigour = match axis.origin {
+            Origin::Seed | Origin::Lateral { .. } => made[i],
+            Origin::Continuation { parent } | Origin::Relay { parent } => end[parent] * made[i],
+        };
+    }
+}
