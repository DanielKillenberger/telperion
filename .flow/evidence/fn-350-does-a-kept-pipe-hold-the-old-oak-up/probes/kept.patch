+/// fn-350 probe: the stem line from the root along the thickest child;
+/// the trunk's diameter in cm where it first stands 1.3 m above the root
+/// (whether it got there: a stem that bows down may not), and the largest
+/// diameter in cm of any other child leaving that line (the largest
+/// limb's base).
+fn trunk_and_limb(tree: &telperion_core::tree::Tree) -> (f64, bool, f64) {
+    let n = tree.nodes.len();
+    let mut kids = vec![Vec::new(); n];
+    for (i, node) in tree.nodes.iter().enumerate().skip(1) {
+        kids[node.parent.unwrap() as usize].push(i);
+    }
+    let y0 = tree.nodes[0].position.y;
+    let (mut at, mut dbh, mut limb) = (0, None, 0.0f64);
+    loop {
+        if dbh.is_none() && tree.nodes[at].position.y - y0 >= 1.3 {
+            dbh = Some(200.0 * tree.nodes[at].radius);
+        }
+        let by = |&&a: &&usize, &&b: &&usize| tree.nodes[a].radius.total_cmp(&tree.nodes[b].radius);
+        let Some(&next) = kids[at].iter().max_by(by) else {
+            break;
+        };
+        for &k in kids[at].iter().filter(|&&k| k != next) {
+            limb = limb.max(200.0 * tree.nodes[k].radius);
+        }
+        at = next;
+    }
+    (dbh.unwrap_or(200.0 * tree.nodes[at].radius), dbh.is_some(), limb)
+}
