--- /dev/null
+++ w/crates/telperion-space/examples/r1.rs
@@ -0,0 +1,188 @@
+//! fn-226 R1 probe, not product code: the lit oak's light work by pass,
+//! and the measures with one light pass or reader off.
+//!
+//!   cargo run --profile ci -p telperion-space --example r1 -- <ages> <seeds> <variants> <repeats>
+//!
+//! Variants: lit, unlit, flat (every bud reads 1), norelay, noallot
+//! (shade_size 0), nobalance (balance_hazard 0), nohazard (shade_hazard
+//! 0), nogirth (leaf_girth 0).
+use telperion_space::{grow_stepped, oak, r1_probe, Expected, Grouping, Light, Origin};
+use telperion_space::{PartitionOrder, Request, Species, Structure};
+
+const LIT: Light = Light {
+    extinction: 0.5,
+    sky: 0.5,
+};
+
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let list = |i: usize| -> Vec<String> { args[i].split(',').map(String::from).collect() };
+    let (ages, seeds, variants) = (list(0), list(1), list(2));
+    let repeats: usize = args.get(3).map_or(1, |r| r.parse().unwrap());
+    for v in &variants {
+        for age in &ages {
+            for seed in &seeds {
+                run(v, age.parse().unwrap(), seed.parse().unwrap(), repeats);
+            }
+        }
+    }
+}
+
+fn run(variant: &str, age: u32, seed: u64, repeats: usize) {
+    let mut species = oak();
+    let mut light = LIT;
+    std::env::remove_var("R1_FLAT");
+    std::env::remove_var("R1_NO_RELAY");
+    for s in species.states.iter_mut() {
+        match variant {
+            "noallot" => s.shade_size = 0.0,
+            "nobalance" => s.balance_hazard = 0.0,
+            "nohazard" => s.shade_hazard = 0.0,
+            "nogirth" => s.leaf_girth = 0.0,
+            _ => {}
+        }
+    }
+    match variant {
+        "unlit" => light = Light::NEUTRAL,
+        "flat" => std::env::set_var("R1_FLAT", "1"),
+        "norelay" => std::env::set_var("R1_NO_RELAY", "1"),
+        _ => {}
+    }
+    let request = Request {
+        age,
+        seed,
+        budget: 20_000_000,
+        light,
+    };
+    let load = || std::fs::read_to_string("/proc/loadavg").unwrap_or_default();
+    let mut best: Option<(f64, Vec<f64>, Vec<u64>, Structure, String)> = None;
+    for _ in 0..repeats {
+        r1_probe::take();
+        let before = load();
+        let t = std::time::Instant::now();
+        let built = telperion_space::grow(&species, request).expect("grows");
+        let took = t.elapsed().as_secs_f64();
+        let (times, counts) = r1_probe::take();
+        let l = before.split(' ').next().unwrap_or("").to_string();
+        if best.as_ref().map_or(true, |b| took < b.0) {
+            best = Some((took, times, counts, built, l));
+        }
+    }
+    let (took, times, counts, tree, load) = best.unwrap();
+    let grown = counts[6];
+    let m = measures(&species, &tree);
+    let kept = m.kept as f64;
+    let mut out = format!(
+        "{{\"variant\":\"{variant}\",\"age\":{age},\"seed\":{seed},\"build\":{took:.4},\"load\":\"{load}\",\"grown\":{grown},\"kept\":{},\"shed\":{:.2},\"height\":{:.2},\"crown_x\":{:.2},\"crown_y\":{:.2},\"base_live\":{:.2},\"base_major\":{:.2}",
+        m.kept,
+        100.0 * (grown as f64 - kept) / grown as f64,
+        m.height,
+        m.crown[0],
+        m.crown[1],
+        m.base_live,
+        m.base_major
+    );
+    for (n, t) in r1_probe::NAMES.iter().zip(&times) {
+        out += &format!(",\"t_{n}\":{t:.4}");
+    }
+    for (n, c) in r1_probe::COUNTS.iter().zip(&counts) {
+        out += &format!(",\"n_{n}\":{c}");
+    }
+    out += &format!(",\"digest\":\"{:x}\"", telperion_space::digest(&tree));
+    println!("{out}}}");
+    if variant == "lit" && std::env::var_os("R1_CHECK").is_some() {
+        check(&species, request, &tree);
+    }
+}
+
+/// The stepped run's tree is `grow`'s (the shed share reads its counts).
+fn check(species: &Species, request: Request, tree: &Structure) {
+    let expected = Expected::new(species, request.age, 0);
+    let g = Grouping {
+        order: PartitionOrder::Forward,
+        chunk: 16,
+        sizes: true,
+        leaves: true,
+        girth: true,
+    };
+    let s = grow_stepped(species, request, &expected, 1024.0, g).expect("grows");
+    let same = telperion_space::digest(&s.structure) == telperion_space::digest(tree);
+    eprintln!(
+        "check {} s{}: digest same {same}, stepped grown {}",
+        request.age,
+        request.seed,
+        s.fine_grown + s.coarse_grown
+    );
+}
+
+struct Measures {
+    kept: usize,
+    height: f64,
+    crown: [f64; 2],
+    base_live: f64,
+    base_major: f64,
+}
+
+/// OAK-LIGHT.md's definitions: tips' extent; the lowest lateral off the
+/// stem bearing a living apex, and among those carrying 1 % of the kept
+/// phytomers.
+fn measures(species: &Species, tree: &Structure) -> Measures {
+    let _ = species;
+    let axes = &tree.axes;
+    let (mut lo, mut hi) = ([f64::INFINITY; 3], [f64::NEG_INFINITY; 3]);
+    let mut kept = 0;
+    for a in axes {
+        for p in &a.phytomers {
+            kept += 1;
+            for (k, v) in [p.tip.x, p.tip.y, p.tip.z].into_iter().enumerate() {
+                lo[k] = lo[k].min(v);
+                hi[k] = hi[k].max(v);
+            }
+        }
+    }
+    let parent = |a: &telperion_space::Axis| match a.origin {
+        Origin::Seed => None,
+        Origin::Lateral { parent, .. } => Some(parent),
+        Origin::Continuation { parent } | Origin::Relay { parent, .. } => Some(parent),
+    };
+    let mut stem = vec![false; axes.len()];
+    let (mut living, mut count) = (vec![false; axes.len()], vec![0usize; axes.len()]);
+    for (i, a) in axes.iter().enumerate() {
+        living[i] = a.apex_end.is_none();
+        count[i] = a.phytomers.len();
+        stem[i] = match a.origin {
+            Origin::Seed => true,
+            Origin::Continuation { parent } | Origin::Relay { parent, .. } => {
+                stem[parent] && (2..=4).contains(&a.pa)
+            }
+            Origin::Lateral { .. } => false,
+        };
+        if let Some(p) = parent(a) {
+            assert!(p < i, "parents first");
+        }
+    }
+    for i in (1..axes.len()).rev() {
+        if let Some(p) = parent(&axes[i]) {
+            living[p] |= living[i];
+            count[p] += count[i];
+        }
+    }
+    let (mut live, mut major) = (f64::INFINITY, f64::INFINITY);
+    for (i, a) in axes.iter().enumerate() {
+        if let Origin::Lateral { parent, .. } = a.origin {
+            if stem[parent] && living[i] {
+                live = live.min(a.base.z);
+                if count[i] as f64 >= 0.01 * kept as f64 {
+                    major = major.min(a.base.z);
+                }
+            }
+        }
+    }
+    Measures {
+        kept,
+        height: hi[2],
+        crown: [hi[0] - lo[0], hi[1] - lo[1]],
+        base_live: live,
+        base_major: major,
+    }
+}
