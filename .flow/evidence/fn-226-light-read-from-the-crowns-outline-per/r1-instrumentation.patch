diff --git i/crates/telperion-space/src/grow/stepped/probe.rs w/crates/telperion-space/src/grow/stepped/probe.rs
new file mode 100644
index 00000000..b0bd3233
--- /dev/null
+++ w/crates/telperion-space/src/grow/stepped/probe.rs
@@ -0,0 +1,70 @@
+//! fn-226 R1 probe, not product code: the stepped executor's light work
+//! timed by pass and counted, and switches that turn one light pass off
+//! (`R1_FLAT`: every bud reads 1, no deposit, sweep or sample;
+//! `R1_NO_RELAY`: no re-lay). Reverse-applied after the runs.
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+
+pub const NAMES: [&str; 17] = [
+    "balance",
+    "allot",
+    "coarse_grow",
+    "coarse_sketch",
+    "items_grow",
+    "items_sketch",
+    "handover",
+    "relay_assemble",
+    "relay_tree",
+    "relay_disperse",
+    "shade_gather",
+    "shade_box",
+    "shade_deposit",
+    "shade_sweep",
+    "shade_read",
+    "shade_write",
+    "settle",
+];
+pub const COUNTS: [&str; 7] = [
+    "leaves",
+    "tips",
+    "nodes",
+    "relay_phytomers",
+    "relays",
+    "cycles_shaded",
+    "grown",
+];
+
+static T: [AtomicU64; 17] = [const { AtomicU64::new(0) }; 17];
+static C: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+
+/// Adds the wall time since `t` to pass `k`.
+pub fn wall(k: usize, t: Instant) {
+    T[k].fetch_add(t.elapsed().as_nanos() as u64, Relaxed);
+}
+
+pub fn secs(k: usize, s: f64) {
+    T[k].fetch_add((s * 1e9) as u64, Relaxed);
+}
+
+pub fn count(k: usize, n: usize) {
+    C[k].fetch_add(n as u64, Relaxed);
+}
+
+pub fn set(k: usize, n: u64) {
+    C[k].store(n, Relaxed);
+}
+
+/// Every timer and count, read and zeroed.
+pub fn take() -> (Vec<f64>, Vec<u64>) {
+    let t = T.iter().map(|a| a.swap(0, Relaxed) as f64 / 1e9).collect();
+    let c = C.iter().map(|a| a.swap(0, Relaxed)).collect();
+    (t, c)
+}
+
+pub fn flat() -> bool {
+    std::env::var_os("R1_FLAT").is_some()
+}
+
+pub fn no_relay() -> bool {
+    std::env::var_os("R1_NO_RELAY").is_some()
+}
