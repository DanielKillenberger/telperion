+/// fn-344 probe (evidence only, never merged): the old oak's causes
+/// switched off by `ABLATE`, a set of letters. The preset values set
+/// here: D the leader's (PA 4) life past the run, so the trunk stays a
+/// leader; E sleeping buds on the trunk (2), fork (3) and leader (4) rows,
+/// as the limb row's (p 0.1, delay 6, rate 0.04) but waking as limbs (6).
+/// B, C and E's stem-line limbs are switched in the grower
+/// (`telperion-space` `probe_ablate`); F is B, C and E.
+fn ablate(species: &mut Species) {
+    let set = std::env::var("ABLATE").unwrap_or_default();
+    let s = &mut species.states;
+    for c in set.chars() {
+        match c {
+            'B' | 'C' => {}
+            'D' => s[4].lifespan = 1000.0,
+            'E' => {
+                for pa in [2, 3, 4] {
+                    for zone in &mut s[pa].zones {
+                        zone.dormant[6] = 0.1;
+                        (zone.delay, zone.rate) = (6.0, 0.04);
+                    }
+                }
+            }
+            _ => panic!("ABLATE: no variant {c}"),
+        }
+    }
+    if !set.is_empty() {
+        eprintln!(
+            "ABLATE {set}: leader life {} trunk/fork/leader sleeping limbs {:?}",
+            s[4].lifespan,
+            [2, 3, 4].map(|pa| s[pa].zones.iter().map(|z| z.dormant[6]).fold(0.0, f64::max))
+        );
+    }
+}
