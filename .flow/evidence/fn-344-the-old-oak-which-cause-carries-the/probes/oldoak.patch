+/// fn-344 probe: the lower trunk's mid view, aimed at a quarter of the
+/// height from 0.9 of the height away on the hero's side.
+fn bole(bounds: &Bounds, hero: &Camera) -> Camera {
+    let toward = Vec3::new(hero.position.x, 0.0, hero.position.z);
+    let toward = toward * (1.0 / toward.length().max(1e-9));
+    let height = bounds.max.y - bounds.min.y;
+    let target = Vec3::new(0.0, 0.25 * height, 0.0);
+    Camera {
+        position: target + toward * (0.9 * height) + Vec3::new(0.0, 0.5, 0.0),
+        target,
+        field_of_view: 38.0,
+        near: 0.05,
+        far: 500.0,
+    }
+}
