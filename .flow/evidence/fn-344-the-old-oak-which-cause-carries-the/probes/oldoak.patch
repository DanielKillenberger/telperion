new file mode 100644
index 000000000..6d0bcaf06
--- /dev/null
+++ w/crates/telperion-space/src/probe_ablate.rs
@@ -0,0 +1,115 @@
+//! fn-344 probe (evidence only, never merged): the old oak's causes
+//! switched off one at a time by the letters in `ABLATE`, and a yearly
+//! census of the held phytomers that stops a grow passing four times
+//! today's count (`ABLATE_CURVE`, lines `year held`) or 8 GiB resident.
+//! Dormant unless the variables are set.
+use std::collections::{HashMap, HashSet};
+use std::sync::{Mutex, OnceLock};
+
+fn letters() -> &'static str {
+    static SET: OnceLock<String> = OnceLock::new();
+    SET.get_or_init(|| std::env::var("ABLATE").unwrap_or_default())
+}
+
+/// Whether variant letter `c` is on.
+pub(crate) fn on(c: char) -> bool {
+    letters().contains(c)
+}
+
+static STEM: Mutex<Option<HashSet<u64>>> = Mutex::new(None);
+
+/// Marks `child` as on the stem line when its bearer is.
+pub(crate) fn carry(bearer_seed: bool, bearer: u64, child: u64) {
+    let mut g = STEM.lock().unwrap();
+    let set = g.get_or_insert_with(HashSet::new);
+    if bearer_seed || set.contains(&bearer) {
+        set.insert(child);
+    }
+}
+
+/// Whether the axis of lineage `key` is on the stem line above the seed.
+pub(crate) fn stem(key: u64) -> bool {
+    STEM.lock().unwrap().as_ref().is_some_and(|s| s.contains(&key))
+}
+
+fn curve() -> &'static HashMap<u32, u64> {
+    static CURVE: OnceLock<HashMap<u32, u64>> = OnceLock::new();
+    CURVE.get_or_init(|| {
+        let path = std::env::var("ABLATE_CURVE").unwrap_or_default();
+        if path.is_empty() {
+            return HashMap::new();
+        }
+        let text = std::fs::read_to_string(&path).expect("ABLATE_CURVE readable");
+        text.lines()
+            .filter_map(|l| {
+                let mut w = l.split_whitespace();
+                Some((w.next()?.parse().ok()?, w.next()?.parse().ok()?))
+            })
+            .collect()
+    })
+}
+
+fn resident_gib() -> f64 {
+    let s = std::fs::read_to_string("/proc/self/statm").unwrap_or_default();
+    let pages: f64 = s.split_whitespace().nth(1).and_then(|p| p.parse().ok()).unwrap_or(0.0);
+    pages * 4096.0 / f64::from(1u32 << 30)
+}
+
+/// The year's census: printed when `ABLATE_CENSUS` is set; the process
+/// stops when `held` passes four times today's count at `year`, or the
+/// process holds 8 GiB.
+pub(crate) fn census(year: u32, held: u64) {
+    if std::env::var_os("ABLATE_CENSUS").is_none() {
+        return;
+    }
+    let rss = resident_gib();
+    println!("CENSUS {year} {held} rss_gib={rss:.2}");
+    let over = curve().get(&year).is_some_and(|&a| held > 4 * a);
+    // 8 GiB: dressing and drawing took the 120-year E from 6.6 to 9.1 GiB,
+    // so a grow ending past 8 would meet the 12 GB cap while drawn.
+    if over || rss > 8.0 {
+        let a = curve().get(&year).copied().unwrap_or(0);
+        println!("STOP year={year} held={held} today={a} rss_gib={rss:.2}");
+        std::process::exit(42);
+    }
+}
+
+/// The settled tree's stem line: its living limbs (PA 6 laterals of the
+/// seed's line with a living apex in their subtree) and the lowest one's
+/// base, engine metres above the root.
+pub(crate) fn settled(s: &crate::structure::Structure) {
+    use crate::structure::Origin;
+    if std::env::var_os("ABLATE_CENSUS").is_none() {
+        return;
+    }
+    let n = s.axes.len();
+    let mut main = vec![false; n];
+    for i in 0..n {
+        main[i] = match s.axes[i].origin {
+            Origin::Seed => true,
+            Origin::Continuation { parent } | Origin::Relay { parent, .. } => main[parent],
+            Origin::Lateral { .. } => false,
+        };
+    }
+    let mut alive: Vec<bool> = s.axes.iter().map(|a| a.apex_end.is_none() && !a.phytomers.is_empty()).collect();
+    for i in (0..n).rev() {
+        if let Some(p) = s.axes[i].origin.parent() {
+            assert!(p < i, "parents come first");
+            if alive[i] {
+                alive[p] = true;
+            }
+        }
+    }
+    let z0 = s.axes[0].base.z;
+    let top = s.axes.iter().flat_map(|a| &a.phytomers).map(|p| p.tip.z - z0).fold(f64::MIN, f64::max);
+    let (mut living, mut lowest) = (0usize, f64::NAN);
+    for (i, a) in s.axes.iter().enumerate() {
+        let Origin::Lateral { parent, .. } = a.origin else { continue };
+        if main[parent] && a.pa == 6 && alive[i] {
+            living += 1;
+            let base = a.base.z - z0;
+            lowest = if lowest.is_nan() { base } else { lowest.min(base) };
+        }
+    }
+    println!("SETTLED top={top:.3} limbs_live={living} lowest_limb={lowest:.3} phytomers={}", s.phytomer_count());
+}
