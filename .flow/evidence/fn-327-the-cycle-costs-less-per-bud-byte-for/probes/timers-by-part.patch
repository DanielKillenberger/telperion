+pub fn probe_reset() {
+    use std::sync::atomic::Ordering::Relaxed;
+    grow::probe::PROBE.iter().for_each(|a| a.store(0, Relaxed));
+}
+pub fn probe_read() -> Vec<u64> {
+    use std::sync::atomic::Ordering::Relaxed;
+    grow::probe::PROBE.iter().map(|a| a.load(Relaxed) / 1_000_000).collect()
+}
