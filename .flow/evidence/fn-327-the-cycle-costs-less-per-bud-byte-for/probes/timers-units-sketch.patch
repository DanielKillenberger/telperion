@@ -85,3 +85,15 @@ pub use species::{
 pub use spruce::spruce;
 pub use structure::{Axis, CountTable, Join, Origin, Phytomer, Structure, Vec3};
 pub use transcendental::Transcendental;
+
+pub mod probe {
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    pub static LAPS: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+    pub fn lap(k: usize, clock: &mut f64) {
+        let now = crate::clock::seconds();
+        LAPS[k].fetch_add(((now - *clock) * 1e9) as u64, Relaxed);
+        *clock = now;
+    }
+    pub fn reset() { LAPS.iter().for_each(|a| a.store(0, Relaxed)); }
+    pub fn read() -> Vec<u64> { LAPS.iter().map(|a| a.load(Relaxed) / 1_000_000).collect() }
+}
