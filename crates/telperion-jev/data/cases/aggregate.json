        {"site": "mortonarb.org", "kind": "garden", "range": [0.0508, 0.127]},
        {"site": "oregonstate.edu", "kind": "extension", "range": [0.05, 0.1]},
        {"site": "ncsu.edu", "kind": "extension", "range": [0.0508, 0.1016]},
        {"site": "wordpress.com", "kind": "nursery", "range": [0.1, 0.1]}
      ],
      "expect": {"kind": "extension", "value": 0.0756, "confidence": "agreed", "set_aside": []}
    },
    {
