        {"site": "mortonarb.org", "kind": "garden", "range": [15.24, 18.288]},
        {"site": "ncsu.edu", "kind": "extension", "range": [15.24, 18.288]},
        {"site": "oregonstate.edu", "kind": "extension", "range": [15, 23]},
        {"site": "wordpress.com", "kind": "nursery", "range": [35, 35]}
      ],
      "expect": {"kind": "forestry", "value": 36.25, "confidence": "agreed", "set_aside": []}
    },
    {
      "id": "beech-leaf-length-extension-over-a-lone-garden",
