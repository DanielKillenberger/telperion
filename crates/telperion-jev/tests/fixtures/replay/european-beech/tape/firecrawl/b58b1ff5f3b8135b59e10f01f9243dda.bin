<li about="#cite_note-COLUMBUS-93" id="cite_note-COLUMBUS-93" data-mw-footnote-number="93"><span class="mw-cite-backlink" id="mwDZ0"><a href="#cite_ref-COLUMBUS_93-0" rel="mw:referencedBy" id="mwDZ4"><span class="mw-linkback-text" id="mwDZ8">↑</span></a></span> <span id="mw-reference-text-cite_note-COLUMBUS-93" class="mw-reference-text reference-text"><span class="ouvrage" id="Columbus_Bonsai_Society2002"><span class="ouvrage" id="The_Columbus_Bonsai_Society2002"><abbr class="abbr indicateur-langue" title="Langue : anglais" id="mwDaA">(en)</abbr> The Columbus Bonsai Society, <span class="noarchive" id="mwDaE">«<span typeof="mw:DisplaySpace" id="mwDaI"> </span><a rel="mw:ExtLink nofollow" href="http://www.columbusbonsai.org/trees?q=node/39" class="external text" id="mwDaM"><cite style="font-style:normal; color:var(--color-link-red, #d73333);" lang="en" id="mwDaQ">Beech</cite></a><span typeof="mw:DisplaySpace" id="mwDaU"> </span>»<sup class="plainlinks" id="mwDaY">(<a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/*/http://www.columbusbonsai.org/trees?q=node/39" class="external text" id="mwDac">Archive.org</a> • <a rel="mw:ExtLink nofollow" href="https://archive.wikiwix.com/cache/?url=http://www.columbusbonsai.org/trees?q=node/39" class="external text" id="mwDag">Wikiwix</a> • <a rel="mw:ExtLink nofollow" href="https://webcache.googleusercontent.com/search?hl=fr&amp;q=cache:http://www.columbusbonsai.org/trees?q=node/39" class="external text" id="mwDak">Google</a> • <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Projet:Correction_des_liens_externes#J'ai_trouvé_un_lien_mort,_que_faire_?" title="Projet:Correction des liens externes" id="mwDao">Que faire<span typeof="mw:DisplaySpace" id="mwDas"> </span>?</a>)</sup></span>, sur <span class="italique" id="mwDaw">columbusbonsai.org</span>, <time class="nowrap" datetime="2002-03" data-sort-value="2002-03" id="mwDa0">mars 2002</time> <small style="line-height:1em;" id="mwDa4">(consulté le <time class="nowrap" datetime="2011-06-01" data-sort-value="2011-06-01" id="mwDa8"><abbr class="abbr" title="premier" id="mwDbA">1<sup id="mwDbE">er</sup></abbr> juin 2011</time>)</small></span></span><link rel="mw:PageProp/Category" href="./Catégorie:Article_contenant_un_lien_mort" id="mwDbI"/>.</span></li>
<li about="#cite_note-94" id="cite_note-94" data-mw-footnote-number="94"><span class="mw-cite-backlink" id="mwDbM"><a href="#cite_ref-94" rel="mw:referencedBy" id="mwDbQ"><span class="mw-linkback-text" id="mwDbU">↑</span></a></span> <span id="mw-reference-text-cite_note-94" class="mw-reference-text reference-text">La chenille se nourrit exclusivement de feuilles sèches.</span></li>
<li about="#cite_note-95" id="cite_note-95" data-mw-footnote-number="95"><span class="mw-cite-backlink" id="mwDbY"><a href="#cite_ref-95" rel="mw:referencedBy" id="mwDbc"><span class="mw-linkback-text" id="mwDbg">↑</span></a></span> <span id="mw-reference-text-cite_note-95" class="mw-reference-text reference-text"><span class="ouvrage" id="Perrin1980" about="#mwt308" typeof="mw:Transclusion" data-mw='{"parts":[{"template":{"target":{"wt":"Article","href":"./Modèle:Article"},"params":{"auteur":{"wt":"Robert Perrin"},"titre":{"wt":"Les affections de l&apos;écorce chez le hêtre - Revues et Congrès"},"périodique":{"wt":"[[Revue forestière française]]"},"date":{"wt":"1980"},"numéro":{"wt":"3"},"pages":{"wt":"274-279"},"url texte":{"wt":"http://documents.irevues.inist.fr/bitstream/handle/2042/21409/RFF_1980_3_269.pdf?sequence=1"}},"i":0}}]}'><span class="ouvrage" id="Robert_Perrin1980">Robert Perrin, «<span typeof="mw:DisplaySpace" id="mwDbk"> </span><cite style="font-style:normal" id="mwDbo">Les affections de l'écorce chez le hêtre - Revues et Congrès</cite><span typeof="mw:DisplaySpace" id="mwDbs"> </span>», <i id="mwDbw"><a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Revue_forestière_française" title="Revue forestière française" class="mw-redirect" id="mwDb0">Revue forestière française</a></i>, <abbr class="abbr" title="numéro" id="mwDb4">n<sup id="mwDb8">o</sup></abbr><span typeof="mw:Entity" id="mwDcA"> </span>3,<span typeof="mw:Entity" id="mwDcE">‎</span> <time id="mwDcI">1980</time>, <abbr class="abbr" title="pages" id="mwDcM">p.</abbr><span typeof="mw:Entity" id="mwDcQ"> </span><span class="nowrap" id="mwDcU">274-279</span> <small style="line-height:1em;" id="mwDcY">(<a rel="mw:ExtLink nofollow" href="http://documents.irevues.inist.fr/bitstream/handle/2042/21409/RFF_1980_3_269.pdf?sequence=1" class="external text" id="mwDcc">lire en ligne</a>)</small><span class="Z3988" title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.atitle=Les+affections+de+l%27%C3%A9corce+chez+le+h%C3%AAtre+-+Revues+et+Congr%C3%A8s&amp;rft.jtitle=Revue+foresti%C3%A8re+fran%C3%A7aise&amp;rft.issue=3&amp;rft.aulast=Perrin&amp;rft.aufirst=Robert&amp;rft.date=1980&amp;rft.pages=274-279&amp;rfr_id=info%3Asid%2Ffr.wikipedia.org%3AH%C3%AAtre+commun" id="mwDcg"></span></span></span></span></li>
<li about="#cite_note-96" id="cite_note-96" data-mw-footnote-number="96"><span class="mw-cite-backlink" id="mwDck"><a href="#cite_ref-96" rel="mw:referencedBy" id="mwDco"><span class="mw-linkback-text" id="mwDcs">↑</span></a></span> <span id="mw-reference-text-cite_note-96" class="mw-reference-text reference-text">L'insecte provoque des microblessures en perçant l'écorce par son <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Rostrum_(anatomie)" title="Rostrum (anatomie)" id="mwDcw">rostre</a> piqueur qui leur permet d'aspirer la <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Sève" title="Sève" id="mwDc0">sève</a>.</span></li>
<li about="#cite_note-GRANATA-97" id="cite_note-GRANATA-97" data-mw-footnote-number="97"><span class="mw-cite-backlink" id="mwDc4"><a href="#cite_ref-GRANATA_97-0" rel="mw:referencedBy" id="mwDc8"><span class="mw-linkback-text" id="mwDdA">↑</span></a></span> <span id="mw-reference-text-cite_note-GRANATA-97" class="mw-reference-text reference-text">
<span class="ouvrage" id="G._Granata_et_A._Sidoti200"><abbr class="abbr indicateur-langue" title="Langue : anglais" id="mwDdE">(en)</abbr> <span class="nom_auteur" id="mwDdI">G. Granata et A. Sidoti</span>, «<span typeof="mw:DisplaySpace" id="mwDdM"> </span><cite style="font-style:normal" lang="en" id="mwDdQ">Biscogniauxia nummularia: pathogenic agent of a beech decline</cite><span typeof="mw:DisplaySpace" id="mwDdU"> </span>», <i id="mwDdY"><span class="lang-en" lang="en" id="mwDdc">Forest pathology</span></i>, <abbr class="abbr" title="volume" id="mwDdg">vol.</abbr><span typeof="mw:Entity" id="mwDdk"> </span>34, <abbr class="abbr" title="numéro" id="mwDdo">n<sup id="mwDds">o</sup></abbr><span typeof="mw:Entity" id="mwDdw"> </span>6,<span typeof="mw:Entity" id="mwDd0">‎</span> <time datetime="0200" data-sort-value="0200" id="mwDd4">200</time>, <abbr class="abbr" title="pages" id="mwDd8">p.</abbr><span typeof="mw:Entity" id="mwDeA"> </span><span class="nowrap" id="mwDeE">363-367</span> <small style="line-height:1em;" id="mwDeI">(<a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/International_Standard_Serial_Number" title="International Standard Serial Number" id="mwDeM">ISSN</a><span typeof="mw:Entity" id="mwDeQ"> </span><span class="plainlinks noarchive" id="mwDeU"><a rel="mw:ExtLink nofollow" href="https://portal.issn.org/resource/ISSN/1437-4781" class="external text" id="mwDeY">1437-4781</a></span>, <a rel="mw:ExtLink nofollow" href="http://cat.inist.fr/?aModele=afficheN&amp;cpsidt=16319041" class="external text" id="mwDec">lire en ligne</a>)</small><span class="Z3988" title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.atitle=Biscogniauxia+nummularia%3A+pathogenic+agent+of+a+beech+decline&amp;rft.jtitle=Forest+pathology&amp;rft.issue=6&amp;rft.aulast=G.+Granata+et+A.+Sidoti&amp;rft.volume=34&amp;rft.pages=363-367&amp;rft.issn=1437-4781&amp;rfr_id=info%3Asid%2Ffr.wikipedia.org%3AH%C3%AAtre+commun" id="mwDeg"></span></span></span></li>
<li about="#cite_note-98" id="cite_note-98" data-mw-footnote-number="98"><span class="mw-cite-backlink" id="mwDek"><a href="#cite_ref-98" rel="mw:referencedBy" id="mwDeo"><span class="mw-linkback-text" id="mwDes">↑</span></a></span> <span id="mw-reference-text-cite_note-98" class="mw-reference-text reference-text">Cette maladie <span class="citation" about="#mwt312" typeof="mw:Transclusion" id="mwDew" data-mw='{"parts":[{"template":{"target":{"wt":"Citation","href":"./Modèle:Citation"},"params":{"1":{"wt":"doit son nom à la trace en forme de T, visible dans le bois sur une coupe transversale"}},"i":0}}]}'>«<span typeof="mw:DisplaySpace" id="mwDe0"> </span>doit son nom à la trace en forme de T, visible dans le bois sur une coupe transversale<span typeof="mw:DisplaySpace" id="mwDe4"> </span>»</span>. Cf <span class="ouvrage" id="mwDe8" about="#mwt313" typeof="mw:Transclusion" data-x-id="Perrin1980" data-mw='{"parts":[{"template":{"target":{"wt":"Article","href":"./Modèle:Article"},"params":{"auteur":{"wt":"Robert Perrin"},"titre":{"wt":"Les affections de l&apos;écorce chez le hêtre"},"périodique":{"wt":"[[Revue forestière française]]"},"date":{"wt":"1980"},"numéro":{"wt":"3"},"pages":{"wt":"274"}},"i":0}}]}'><span class="ouvrage" id="mwDfA" data-x-id="Robert_Perrin1980">Robert Perrin, «<span typeof="mw:DisplaySpace" id="mwDfE"> </span><cite style="font-style:normal" id="mwDfI">Les affections de l'écorce chez le hêtre</cite><span typeof="mw:DisplaySpace" id="mwDfM"> </span>», <i id="mwDfQ"><a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Revue_forestière_française" title="Revue forestière française" class="mw-redirect" id="mwDfU">Revue forestière française</a></i>, <abbr class="abbr" title="numéro" id="mwDfY">n<sup id="mwDfc">o</sup></abbr><span typeof="mw:Entity" id="mwDfg"> </span>3,<span typeof="mw:Entity" id="mwDfk">‎</span> <time id="mwDfo">1980</time>, <abbr class="abbr" title="page" id="mwDfs">p.</abbr><span typeof="mw:Entity" id="mwDfw"> </span>274<span class="Z3988" title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.atitle=Les+affections+de+l%27%C3%A9corce+chez+le+h%C3%AAtre&amp;rft.jtitle=Revue+foresti%C3%A8re+fran%C3%A7aise&amp;rft.issue=3&amp;rft.aulast=Perrin&amp;rft.aufirst=Robert&amp;rft.date=1980&amp;rft.pages=274&amp;rfr_id=info%3Asid%2Ffr.wikipedia.org%3AH%C3%AAtre+commun" id="mwDf0"></span></span></span></span></li>
<li about="#cite_note-99" id="cite_note-99" data-mw-footnote-number="99"><span class="mw-cite-backlink" id="mwDf4"><a href="#cite_ref-99" rel="mw:referencedBy" id="mwDf8"><span class="mw-linkback-text" id="mwDgA">↑</span></a></span> <span id="mw-reference-text-cite_note-99" class="mw-reference-text reference-text">Ce suintement correspond à une <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Exsudat_végétal" title="Exsudat végétal" id="mwDgE">exsudation</a> de sève noirâtre (coloration due à son oxydation) d'une zone <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Nécrose" title="Nécrose" id="mwDgI">nécrosée</a> liée à un décollement localisé de l'écorce par rapport au bois sous-jacent, provoquant la formation d'une poche de sève qui finit par suinter à travers l'écorce. Ce décollement a pour origine un <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Stress_abiotique" title="Stress abiotique" class="mw-redirect" id="mwDgM">stress abiotique</a> (gel, soleil, lésion mécanique telle qu'un trou de sondage à la <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Tarière_de_Pressler" title="Tarière de Pressler" id="mwDgQ">tarière de Pressler</a>) ou <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Stress_abiotique" title="Stress abiotique" class="mw-redirect" id="mwDgU">biotique</a> (galeries sous-corticales de <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Scolyte" title="Scolyte" class="mw-redirect" id="mwDgY">scolytes</a>, d'<a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Agrile" title="Agrile" class="mw-redirect" id="mwDgc">agriles</a>, attaque de <a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Champignon_phytopathogène" title="Champignon phytopathogène" id="mwDgg">champignon phytopathogène</a>).</span></li>
<li about="#cite_note-100" id="cite_note-100" data-mw-footnote-number="100"><span class="mw-cite-backlink" id="mwDgk"><a href="#cite_ref-100" rel="mw:referencedBy" id="mwDgo"><span class="mw-linkback-text" id="mwDgs">↑</span></a></span> <span id="mw-reference-text-cite_note-100" class="mw-reference-text reference-text"><span class="ouvrage" id="mwDgw" about="#mwt316" typeof="mw:Transclusion" data-x-id="Armand2002" data-mw='{"parts":[{"template":{"target":{"wt":"Ouvrage","href":"./Modèle:Ouvrage"},"params":{"auteur1":{"wt":"Gérard Armand"},"titre":{"wt":"Le hêtre autrement"},"éditeur":{"wt":"Forêt privée française"},"année":{"wt":"2002"},"passage":{"wt":"221"},"isbn":{"wt":""}},"i":0}}]}'><span class="ouvrage" id="mwAA" data-x-id="Gérard_Armand2002">Gérard Armand, <cite class="italique" id="mwDg0">Le hêtre autrement</cite>, Forêt privée française, <time id="mwDg4">2002</time>, <abbr class="abbr" title="page" id="mwDg8">p.</abbr><span typeof="mw:Entity" id="mwDhA"> </span>221<span class="Z3988" title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Le+h%C3%AAtre+autrement&amp;rft.pub=For%C3%AAt+priv%C3%A9e+fran%C3%A7aise&amp;rft.aulast=Armand&amp;rft.aufirst=G%C3%A9rard&amp;rft.date=2002&amp;rft.pages=221&amp;rfr_id=info%3Asid%2Ffr.wikipedia.org%3AH%C3%AAtre+commun" id="mwDhE"></span></span></span></span></li>
<li about="#cite_note-INRA-101" id="cite_note-INRA-101" data-mw-footnote-number="101"><span class="mw-cite-backlink" id="mwDhI"><a href="#cite_ref-INRA_101-0" rel="mw:referencedBy" id="mwDhM"><span class="mw-linkback-text" id="mwDhQ">↑</span></a></span> <span id="mw-reference-text-cite_note-INRA-101" class="mw-reference-text reference-text">
