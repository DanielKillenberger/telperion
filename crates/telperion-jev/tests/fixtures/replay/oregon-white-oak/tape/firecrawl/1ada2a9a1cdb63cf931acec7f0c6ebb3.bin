<th colspan="2" style="color:inherit; text-align: center; background-color: rgb(180,250,180)"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Synonym_(taxonomy)" title="Synonym (taxonomy)">Synonyms</a><sup about="#mwt15" class="mw-ref reference" id="cite_ref-powo_2-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"powo"}}'><a href="#cite_note-powo-2" id="mwDg"><span class="mw-reflink-text" id="mwDw"><span class="cite-bracket" id="mwEA">[</span>2<span class="cite-bracket" id="mwEQ">]</span></span></a></sup><sup about="#mwt19" class="mw-ref reference" id="cite_ref-3" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-3"}}'><a href="#cite_note-3" id="mwEg"><span class="mw-reflink-text" id="mwEw"><span class="cite-bracket" id="mwFA">[</span>3<span class="cite-bracket" id="mwFQ">]</span></span></a></sup><sup about="#mwt24" class="mw-ref reference" id="cite_ref-4" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-4"}}'><a href="#cite_note-4" id="mwFg"><span class="mw-reflink-text" id="mwFw"><span class="cite-bracket" id="mwGA">[</span>4<span class="cite-bracket" id="mwGQ">]</span></span></a></sup><sup about="#mwt29" class="mw-ref reference" id="cite_ref-5" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-5"}}'><a href="#cite_note-5" id="mwGg"><span class="mw-reflink-text" id="mwGw"><span class="cite-bracket" id="mwHA">[</span>5<span class="cite-bracket" id="mwHQ">]</span></span></a></sup></th></tr>
