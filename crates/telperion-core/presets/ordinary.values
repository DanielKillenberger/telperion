# fn-270 R5c: the colour a falling leaf turns is a stand-in by the
# centroid rule: the mean of the corners that name one, the beech's
# copper and the oak's brown; named, not measured.
/material/leafDeadRed = 0.299
/material/leafDeadGreen = 0.0814
/material/leafDeadBlue = 0.0093
