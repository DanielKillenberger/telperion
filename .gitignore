node_modules
dist
*.tsbuildinfo

# reference art, kept local: third-party concept art used only to
# art-direct against. Never committed, never published.
.refs/

# Raw species-measure receipts stay on disk; summaries are committed.
.flow/evidence/fn34/measure/
# Jev ledger entries are per-run records, not source.
.flow/ledger/
# Per-run worker scratch: the base commit a task was dispatched from, the
# summary and evidence it hands back. None of it is a record of the repo.
.flow/tmp/

# Rust outputs and reproducible migration artifacts.
/target/
/tests/migration/generated/

# Generated by npm run wasm:build.
/src/browser/telperion.wasm

# Generated by npm run render:build: the renderer module and its wasm-bindgen
# glue. Generated, never authored, and typed by its own declarations.
/src/browser/render/

# Python bytecode never ships.
__pycache__/
*.pyc

# Cinematic captures: videos and frame sequences stay on disk.
.flow/evidence/birch-cinematic/

# The fetch adapter cache never enters the repository.
.firecrawl/

# Species pipeline runs: fetched source bytes, measurement scratch and
# stills stay on disk; the checksums, rows, packet and decisions are committed.
.flow/evidence/*/pipeline/cache/
.flow/evidence/*/pipeline/stills/
.flow/evidence/*/pipeline/ledger/entries/
.flow/evidence/*/ledger/

# fn-71 distance sweeps: the stills stay on disk, the measured curves are committed.
.flow/evidence/fn71/sweep/**/*.png

# Evidence retention: raw runs and demo media are local artifacts.
/.flow/evidence/*/raw/
/demo-video/

# fn-91 historical output has a checksum manifest and pinned Git recovery.
/.flow/evidence/fn-91-fast-tree-generation-as-a-core-engine/**/*.log
/.flow/evidence/fn-91-fast-tree-generation-as-a-core-engine/**/*.stderr
/.flow/evidence/fn-91-fast-tree-generation-as-a-core-engine/**/*.jsonl
/.flow/evidence/fn-91-fast-tree-generation-as-a-core-engine/**/*.png
/.flow/evidence/fn-91-fast-tree-generation-as-a-core-engine/**/*.txt
/.flow/evidence/fn-91-fast-tree-generation-as-a-core-engine/**/*.html
/.flow/evidence/fn-91-fast-tree-generation-as-a-core-engine/**/*.csv
/.flow/evidence/fn-91-fast-tree-generation-as-a-core-engine/**/*.sha256
experiments/voxel-field/out/
