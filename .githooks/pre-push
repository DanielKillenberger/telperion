#!/usr/bin/env bash
# The design principles, checked before a push (fn-151, docs/principles.md).
# The three deterministic guards block; Jev review is planned in fn-156.
# `git push --no-verify` skips this hook.
# Installed once by `npm run setup` (core.hooksPath = .githooks), so it runs
# on a push from any worktree of this repository.
set -u
root=$(git rev-parse --show-toplevel) || exit 0
zero=0000000000000000000000000000000000000000
jev="$root/target/principles/ci/jev"
stamp="$jev.stamp"
want="$(git -C "$root" rev-parse HEAD:crates/telperion-jev 2>/dev/null) $(git -C "$root" rev-parse HEAD:Cargo.lock 2>/dev/null)"
if [ ! -x "$jev" ] || [ "$(cat "$stamp" 2>/dev/null)" != "$want" ]; then
  echo "principles: building the checker (once per change to crates/telperion-jev)" >&2
  if ! cargo build --quiet --profile ci -p telperion-jev --bin jev --target-dir "$root/target/principles" \
      --manifest-path "$root/Cargo.toml" >&2; then
    echo "principles: INCOMPLETE the checker did not build; nothing was checked" >&2
    exit 0
  fi
  printf '%s' "$want" > "$stamp"
fi
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" != "$zero" ] && git -C "$root" cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base=$(git -C "$root" merge-base "$remote_sha" "$local_sha")
  else
    base=$(git -C "$root" merge-base origin/master "$local_sha" 2>/dev/null) || continue
  fi
  [ "$base" = "$local_sha" ] && continue
  (cd "$root" && "$jev" principles push --base "$base" --head "$local_sha") >&2 || status=1
done
exit $status
